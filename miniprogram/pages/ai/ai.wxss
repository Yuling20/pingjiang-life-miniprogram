page {
  background: #F9F3E8; /* 柔和护眼纸质黄/棉麻背景 */
  height: 100%;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F9F3E8;
  box-sizing: border-box;
}

/* ===== 消息列表 ===== */
.message-list {
  flex: 1;
  padding: 24rpx 20rpx 0;
  box-sizing: border-box;
}

/* ===== 欢迎页 ===== */
.welcome-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  gap: 20rpx;
}
.welcome-emoji {
  font-size: 100rpx;
}
.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #000000; /* 纯黑文字 */
}
.welcome-sub {
  font-size: 28rpx;
  color: #333333;
}

/* ===== 消息行 ===== */
.message-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 28rpx;
  gap: 16rpx;
}
.row-user {
  flex-direction: row-reverse;
}
.row-ai {
  flex-direction: row;
}

/* ===== 头像 ===== */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.ai-avatar {
  background: #EDE4D3;
}
.user-avatar {
  background: #FFF0D6;
}

/* ===== 消息气泡核心样式 ===== */
.bubble {
  max-width: 70%;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  word-break: break-word;
}
/* 用户气泡：微信同款绿色 */
.bubble-user {
  background: #95EC69;
  border-bottom-right-radius: 4rpx;
}
/* AI气泡：浅白色 */
.bubble-ai {
  background: #FFFFFF;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
/* 字体放大20% + 全局纯黑文字 */
.bubble-text {
  font-size: 38rpx;
  line-height: 1.7;
  color: #000000;
}

/* ===== 加载动画 ===== */
.bubble-loading {
  padding: 28rpx 36rpx;
}
.dot-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #666666;
  animation: bounce 1.2s infinite ease-in-out;
}
.dot1 { animation-delay: 0s; }
.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
  40% { transform: scale(1.1); opacity: 1; }
}

/* ===== 底部输入栏 ===== */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EDE4D3;
  box-sizing: border-box;
}
.input-box {
  flex: 1;
  background: #F9F3E8;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #000000;
  max-height: 240rpx;
  box-sizing: border-box;
  line-height: 1.6;
}
.input-placeholder {
  color: #8B7D6B;
  font-size: 30rpx;
}
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.2s;
}
.send-active {
  background: #FFB800;
  color: #000000;
}
.send-disabled {
  background: #EDE4D3;
  color: #8B7D6B;
}