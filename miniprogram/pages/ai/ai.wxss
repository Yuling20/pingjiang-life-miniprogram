/* pages/ai/ai.wxss */
.ai-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f4f6f9;
  box-sizing: border-box;
}

/* ===== 顶部标题 ===== */
.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #FF8C00, #FFA500);
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 0, 0.3);
  flex-shrink: 0;
}
.header-info {
  display: flex;
  flex-direction: column;
}
.header-title {
  font-size: 34rpx;
  color: #fff;
  font-weight: bold;
}
.header-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}
.clear-btn {
  font-size: 26rpx;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

/* ===== 聊天区域 ===== */
.chat-area {
  flex: 1;
  padding: 20rpx 20rpx 0;
  overflow: hidden;
}

/* ===== 消息行 ===== */
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 28rpx;
}
.msg-left {
  flex-direction: row;
}
.msg-right {
  flex-direction: row-reverse;
}

/* ===== 文字头像（替代图片，解决500错误） ===== */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
}
.avatar-ai {
  background: linear-gradient(135deg, #FF8C00, #FFA500);
  margin-right: 16rpx;
}
.avatar-user {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  margin-left: 16rpx;
}

/* ===== 气泡 ===== */
.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  position: relative;
  word-break: break-all;
}
.bubble-ai {
  background: #fff;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.bubble-user {
  background: #FF8C00;
  border-bottom-right-radius: 4rpx;
}
.bubble-error {
  background: #fff3f3;
  border: 1rpx solid #ffcdd2;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  white-space: pre-wrap;
  display: block;
}
.bubble-user .msg-text {
  color: #fff;
}
.bubble-error .msg-text {
  color: #e53935;
}

.msg-time {
  display: block;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
  text-align: right;
}
.bubble-user .msg-time {
  color: rgba(255, 255, 255, 0.75);
}

/* ===== 加载动画 ===== */
.loading-bubble {
  padding: 24rpx 28rpx;
}
.dot-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF8C00;
  animation: bounce 1.2s infinite;
}
.dot2 {
  animation-delay: 0.2s;
}
.dot3 {
  animation-delay: 0.4s;
}
@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ===== 快捷回复 ===== */
.quick-area {
  flex-shrink: 0;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.quick-list {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  white-space: nowrap;
}
.quick-item {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  background: #fff7ee;
  color: #FF8C00;
  border: 1rpx solid #FFD699;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* ===== 输入区域 ===== */
.input-area {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.input-box {
  flex: 1;
  height: 72rpx;
  background: #f4f6f9;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}
.input-placeholder {
  color: #bbb;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #FF8C00;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  text-align: center;
  padding: 0;
  flex-shrink: 0;
}
.btn-disabled {
  background: #ccc;
}
