<view class="chat-container">
  <!-- 对话记录区域 -->
  <scroll-view
    class="message-list"
    scroll-y="true"
    scroll-top="{{scrollTop}}"
    scroll-with-animation="true"
  >
    <!-- 欢迎语（无对话时显示） -->
    <view wx:if="{{messages.length === 0}}" class="welcome-box">
      <text class="welcome-emoji">🤖</text>
      <text class="welcome-title">你好！我是AI助手</text>
      <text class="welcome-sub">有什么问题尽管问我～</text>
    </view>

    <!-- 消息气泡 -->
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="message-row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
    >
      <!-- AI头像 -->
      <view wx:if="{{item.role === 'assistant'}}" class="avatar ai-avatar">
        <text>🤖</text>
      </view>

      <!-- 气泡内容 -->
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
        <text class="bubble-text" selectable="true">{{item.content}}</text>
      </view>

      <!-- 用户头像 -->
      <view wx:if="{{item.role === 'user'}}" class="avatar user-avatar">
        <text>😊</text>
      </view>
    </view>

    <!-- 加载中气泡 -->
    <view wx:if="{{loading}}" class="message-row row-ai">
      <view class="avatar ai-avatar"><text>🤖</text></view>
      <view class="bubble bubble-ai bubble-loading">
        <view class="dot-box">
          <view class="dot dot1"></view>
          <view class="dot dot2"></view>
          <view class="dot dot3"></view>
        </view>
      </view>
    </view>

    <!-- 底部占位，让最新消息不被输入框遮挡 -->
    <view style="height: 160rpx;"></view>
  </scroll-view>

  <!-- 底部输入区域 -->
  <view class="input-bar">
    <textarea
      class="input-box"
      value="{{inputText}}"
      bindinput="onInput"
      placeholder="输入你的问题..."
      placeholder-class="input-placeholder"
      maxlength="500"
      auto-height="true"
      confirm-type="send"
      bindconfirm="onSend"
      disabled="{{loading}}"
    />
    <view
      class="send-btn {{(inputText.trim().length > 0 && !loading) ? 'send-active' : 'send-disabled'}}"
      bindtap="onSend"
    >
      <text wx:if="{{!loading}}">发送</text>
      <text wx:else>等待</text>
    </view>
  </view>

</view>