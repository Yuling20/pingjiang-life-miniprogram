/* pages/services/convenience/services.wxss */

/* ========================================
   整体页面背景：暖米白，与"我的"页统一
======================================== */
.page-container {
  min-height: 100vh;
  background-color: #F5F0E8;
  padding-bottom: 120rpx;
}

/* ========================================
   ★ 顶部标题卡片（原大黄色区域彻底替换）
   - 不再铺满全宽的大色块
   - 改为圆角卡片，暖棕渐变，有层次感
======================================== */
.page-header-card {
  margin: 24rpx 24rpx 0 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #5C3D1E 0%, #8B5E3C 100%);
  box-shadow: 0 4rpx 20rpx rgba(92, 61, 30, 0.20);
  overflow: hidden;
}

.page-header-inner {
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.80);
  margin-top: 10rpx;
}

/* ========================================
   功能宫格：每行2个（原样保留）
======================================== */
.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 24rpx 24rpx;
}

/* 每个入口卡片（原样保留） */
.service-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(92, 61, 30, 0.08);
  min-height: 260rpx;
}

/* 图标圆圈（原样保留） */
.service-icon-wrap {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.service-icon { font-size: 68rpx; }

/* 各颜色背景（原样保留） */
.blue   { background-color: #e6f0ff; }
.orange { background-color: #fff3e6; }
.yellow { background-color: #fffbe6; }
.red    { background-color: #ffe6e6; }
.green  { background-color: #e6f7ee; }
.gray   { background-color: #f0f0f0; }
.gold   { background-color: #fff8e1; }

/* 入口名称（原样保留） */
.service-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #3D2B10;
  margin-bottom: 10rpx;
}

/* 入口描述（原样保留） */
.service-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

/* 即将上线标签（原样保留） */
.coming-soon-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #ff4d4f;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}
.coming-soon-tag text {
  font-size: 20rpx;
  color: #ffffff;
}

/* 底部说明（原样保留） */
.page-footer {
  text-align: center;
  padding: 20rpx 0 30rpx;
}
.footer-text {
  font-size: 26rpx;
  color: #C0A882;
}
