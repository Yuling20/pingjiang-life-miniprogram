/* miniprogram/pages/services/convenience/homeservice/homeservice.wxss */

.page-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

/* 顶部操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}
.action-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.action-tip-icon { font-size: 28rpx; }
.action-tip-text {
  font-size: 26rpx;
  color: #666;
}
.publish-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  white-space: nowrap;
}

/* 安全提示 */
.safety-tip {
  background: #FFF3EC;
  border-left: 6rpx solid #FF6B35;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #FF6B35;
  line-height: 1.5;
}

/* 筛选条 */
.filter-scroll {
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
  white-space: nowrap;
}
.filter-row {
  display: flex;
  flex-direction: row;
  padding: 16rpx 16rpx;
  gap: 12rpx;
}
.filter-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  white-space: nowrap;
  flex-shrink: 0;
}
.filter-tag-active {
  background: #FFF0E8;
  color: #FF6B35;
  font-weight: bold;
}
.category-tag { background: #F0F4FF; color: #4A90D9; }
.category-tag-active { background: #4A90D9; color: #fff; font-weight: bold; }

/* 列表 */
.list-scroll {
  flex: 1;
  overflow: hidden;
}

/* 服务卡片 */
.service-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 16rpx 16rpx 0;
  padding: 24rpx;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #E8A838);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
.header-info { flex: 1; }
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.service-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.experience-tag {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF0E8;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.area-tag {
  font-size: 24rpx;
  color: #999;
}
.category-badge {
  font-size: 22rpx;
  color: #4A90D9;
  background: #EDF5FF;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 评分统计 */
.stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.rating {
  font-size: 26rpx;
  color: #E8A838;
  font-weight: bold;
}
.order-count {
  font-size: 24rpx;
  color: #999;
  flex: 1;
}
.publish-time {
  font-size: 24rpx;
  color: #CCC;
}

/* 简介 */
.intro-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.tag {
  font-size: 22rpx;
  color: #67C23A;
  background: #F0F9EB;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

/* 底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}
.price-wrap { display: flex; flex-direction: column; }
.price-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.price-val {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF6B35;
}
.contact-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 20rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-text {
  font-size: 28rpx;
  color: #999;
}
