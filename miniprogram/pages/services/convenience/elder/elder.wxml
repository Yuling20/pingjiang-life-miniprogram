<!-- pages/services/convenience/elder/elder.wxml -->

<!-- 加载占位（pageReady 为 false 时显示，修复白屏问题） -->
<view wx:if="{{!pageReady}}" class="page-loading">
  <text class="page-loading-text">加载中...</text>
</view>

<view class="elder-page" wx:if="{{pageReady}}">

<!-- ======================================================
  顶部导航栏
====================================================== -->
<view class="nav-bar">
  <view class="nav-back" bindtap="onNavBack">‹ 返回</view>
  <text class="nav-title">❤️ 孝亲守护</text>
  <view class="nav-right" bindtap="onResetIdentity">
    <text class="nav-role-tag">{{selectedTitle || '未设置'}}</text>
  </view>
</view>

<!-- ======================================================
  【身份选择弹窗】— 首次进入时显示
====================================================== -->
<view class="modal-mask" wx:if="{{showIdentityModal}}"
  catchtouchmove="onModalStop"
  catchtap="onModalStop">
  <view class="modal-box identity-modal" catchtap="onModalStop">
    <view class="modal-title">👋 您好，请选择您的身份</view>
    <view class="modal-sub">选择后系统自动适配您的专属界面</view>

    <!-- ✅ 新增功能说明区块 -->
    <view class="feature-intro-box">
      <view class="feature-intro-title">💡 板块说明</view>
      <view class="feature-intro-text">
        这是「孝亲守护」板块，专为你和家人打造：
      </view>
      <view class="feature-intro-item">📱 子女可远程帮长辈设置用药提醒、添加健康记录</view>
      <view class="feature-intro-item">💊 长辈只需一键打卡，就能轻松完成每日用药</view>
      <view class="feature-intro-item">🔄 系统会自动同步数据，让你随时掌握家人健康状态</view>
      <view class="feature-intro-item">🔔 异常时还会及时提醒，帮你更省心地守护家人健康</view>
    </view>

    <view class="identity-grid">
      <view
        wx:for="{{identityList}}"
        wx:key="label"
        class="identity-item {{selectedTitle === item.label ? 'identity-selected' : ''}}"
        bindtap="onSelectIdentity"
        data-item="{{item}}"
      >
        <text class="identity-icon">{{item.icon}}</text>
        <text class="identity-label">{{item.label}}</text>
      </view>
    </view>
    <!-- ✅ 修复截图2报错：原代码此处为 </view>，应为 </button> -->
    <button class="btn-primary btn-confirm-identity" bindtap="onConfirmIdentity">
      确认，进入孝亲守护
    </button>
  </view>
</view>

<!-- ======================================================
  ★★★ 老人视图（长辈端）★★★
====================================================== -->
<block wx:if="{{role === 'elder'}}">
  <view class="elder-view">

    <!-- 欢迎区域 -->
    <view class="elder-welcome-card">
      <text class="elder-welcome-title">❤️ 家人关爱您</text>
      <text class="elder-welcome-sub">子女已为您设置好提醒，无需手动操作</text>
    </view>

    <!-- 今日用药提醒区 -->
    <view class="elder-section">
      <view class="elder-section-title">💊 今日用药</view>

      <view wx:if="{{todayMeds.length === 0}}" class="elder-empty">
        今日暂无用药提醒
      </view>

      <view wx:for="{{todayMeds}}" wx:key="id" class="elder-med-card">
        <view class="elder-med-top">
          <text class="elder-med-name">{{item.name}}</text>
          <text class="elder-med-time">⏰ {{item.time}}</text>
        </view>
        <text class="elder-med-dose">用量：{{item.dose}}</text>
        <text class="elder-med-note" wx:if="{{item.note}}">📝 {{item.note}}</text>
      </view>
    </view>

    <!-- 打卡历史（最近3条）— ✅ 修复 wx:if + wx:for 同节点问题 -->
    <view class="elder-section" wx:if="{{medRecords.length > 0}}">
      <view class="elder-section-title">📋 今日打卡记录</view>
      <block wx:for="{{medRecords}}" wx:key="id">
        <view wx:if="{{index < 3}}" class="record-row">
          <text class="record-status {{item.status === 'taken' ? 'status-taken' : 'status-skip'}}">
            {{item.status === 'taken' ? '✅ 已吃' : '❌ 未吃'}}
          </text>
          <text class="record-name">{{item.medName}} {{item.dose}}</text>
          <text class="record-time">{{item.time}}</text>
        </view>
      </block>
    </view>

    <!-- 今日重要事项（备忘录） -->
    <view class="elder-section">
      <view class="elder-section-title">📅 今日重要事项</view>
      <view
        class="elder-memo-btn {{todayMemos.length > 0 ? 'elder-memo-btn-active' : ''}}"
        bindtap="onViewTodayMemo"
      >
        <text class="elder-memo-btn-icon">{{todayMemos.length > 0 ? '🔔' : '📋'}}</text>
        <text class="elder-memo-btn-text">
          {{todayMemos.length > 0 ? '今天有 ' + todayMemos.length + ' 条重要事项，点击查看' : '点击查看家人备忘录'}}
        </text>
      </view>
    </view>

  </view>
</block>

<!-- ======================================================
  ★★★ 晚辈视图（子女/孙辈端）★★★
====================================================== -->
<block wx:if="{{role === 'junior'}}">
  <view class="junior-view">

    <!-- ——— 家庭绑定区域 ——— -->
    <view class="section-card">
      <view class="section-header" bindtap="toggleBindPanel">
        <view class="section-title-row">
          <text class="section-title">👨‍👩‍👧 家庭绑定</text>
          <view class="bound-badge {{isBound ? 'badge-bound' : 'badge-unbound'}}">
            {{isBound ? '✅ 已绑定 ' + familyMembers.length + ' 位家人' : '未绑定，点击设置'}}
          </view>
        </view>
        <text class="section-arrow">{{showBindPanel ? '▲' : '▼'}}</text>
      </view>

      <!-- 绑定面板展开内容 -->
      <view wx:if="{{showBindPanel}}" class="bind-panel">

        <!-- 我的绑定码 -->
        <view class="my-code-box">
          <text class="my-code-label">我的绑定码（发给家人）</text>
          <text class="my-code-value">{{bindCode}}</text>
          <!-- ✅ 修复：原 bindtap="_chooseWxFriend" 方法缺失，改为已有方法 -->
          <button class="btn-mini" bindtap="_chooseWxFriend">复制分享</button>
        </view>

        <!-- 选择绑定方式 -->
        <view class="bind-methods">
          <view class="bind-method-title">选择绑定方式</view>
          <view class="bind-method-list">
            <view class="bind-method-item {{bindMethod==='friend' ? 'method-active' : ''}}"
              bindtap="onSelectBindMethod" data-method="friend">
              <text class="method-icon">👥</text>
              <text class="method-name">微信好友</text>
            </view>
            <view class="bind-method-item {{bindMethod==='qr' ? 'method-active' : ''}}"
              bindtap="onSelectBindMethod" data-method="qr">
              <text class="method-icon">📱</text>
              <text class="method-name">二维码</text>
            </view>
            <view class="bind-method-item {{bindMethod==='wxid' ? 'method-active' : ''}}"
              bindtap="onSelectBindMethod" data-method="wxid">
              <text class="method-icon">🔤</text>
              <text class="method-name">微信号</text>
            </view>
          </view>

          <!-- 微信号输入区域 -->
          <view wx:if="{{bindMethod === 'wxid'}}" class="wxid-input-row">
            <input class="input-field" placeholder="请输入对方微信号" value="{{inputWxId}}" bindinput="onInputWxId"/>
            <button class="btn-primary btn-sm" bindtap="onSubmitWxIdBind">发申请</button>
          </view>
        </view>

        <!-- 输入对方绑定码 -->
        <view class="input-row">
          <text class="input-label">输入家人绑定码</text>
          <input class="input-field" placeholder="输入6位绑定码" value="{{inputBindCode}}" bindinput="onInputBindCode" maxlength="6" type="number"/>
          <button class="btn-primary btn-sm" bindtap="onConfirmBindCode">确认绑定</button>
        </view>

        <!-- 已绑定成员列表 -->
        <view wx:if="{{familyMembers.length > 0}}" class="member-list">
          <view class="member-list-title">已绑定家庭成员</view>
          <view wx:for="{{familyMembers}}" wx:key="code" class="member-row">
            <text class="member-icon">{{item.role === 'elder' ? '👴' : '👦'}}</text>
            <text class="member-name">{{item.name || '家人'}}</text>
            <text class="member-role-tag">{{item.role === 'elder' ? '长辈' : '晚辈'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ——— 用药提醒管理区域 ——— -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">💊 用药提醒管理</text>
        <button class="btn-add" bindtap="onShowAddMed">＋ 新增</button>
      </view>

      <view wx:if="{{medicineList.length === 0}}" class="empty-tip">
        暂未添加用药提醒，点击右上角新增
      </view>

      <view wx:for="{{medicineList}}" wx:key="id" class="med-card">
        <view class="med-card-top">
          <text class="med-name">{{item.name}}</text>
          <switch checked="{{item.enabled}}" bindchange="onToggleMedSwitch" data-id="{{item.id}}" color="#D4820A"/>
        </view>
        <view class="med-card-info">
          <text class="med-info-text">⏰ {{item.time}}</text>
          <text class="med-info-text">💊 {{item.dose}}</text>
          <text class="med-info-text" wx:if="{{item.note}}">📝 {{item.note}}</text>
        </view>
        <view class="med-card-actions">
          <view class="status-tag {{item.enabled ? 'tag-on' : 'tag-off'}}">
            {{item.enabled ? '提醒开启' : '提醒关闭'}}
          </view>
          <view class="btn-delete" bindtap="onDeleteMed" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>

    <!-- ——— 打卡记录查看区域 — ✅ 修复 wx:if + wx:for 同节点问题 ——— -->
    <view class="section-card" wx:if="{{medRecords.length > 0}}">
      <view class="section-header">
        <text class="section-title">📋 用药打卡记录</text>
      </view>
      <block wx:for="{{medRecords}}" wx:key="id">
        <view wx:if="{{index < 10}}" class="record-row-junior">
          <text class="record-status {{item.status === 'taken' ? 'status-taken' : 'status-skip'}}">
            {{item.status === 'taken' ? '✅' : '❌'}}
          </text>
          <view class="record-info">
            <text class="record-info-name">{{item.medName}} · {{item.dose}}</text>
            <text class="record-info-time">{{item.date}} {{item.time}} · {{item.recordTime}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- ——— 家庭备忘录管理区域 ——— -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">📅 家庭备忘录</text>
        <button class="btn-add" bindtap="onShowAddMemo">＋ 新增</button>
      </view>

      <view wx:if="{{memoList.length === 0}}" class="empty-tip">
        暂无备忘录，点击右上角新增重要事项
      </view>

      <view wx:for="{{memoList}}" wx:key="id" class="memo-card">
        <view class="memo-card-top">
          <text class="memo-title">{{item.title}}</text>
          <text class="memo-date" wx:if="{{item.date}}">📅 {{item.date}}</text>
        </view>
        <text class="memo-content">{{item.content}}</text>

        <view wx:if="{{item.images && item.images.length > 0}}" class="memo-images">
          <image
            wx:for="{{item.images}}"
            wx:key="*this"
            wx:for-item="img"
            src="{{img}}"
            class="memo-img"
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-urls="{{item.images}}"
            data-current="{{img}}"
          />
        </view>

        <view class="memo-actions">
          <view class="btn-edit" bindtap="onEditMemo" data-id="{{item.id}}">编辑</view>
          <view class="btn-delete" bindtap="onDeleteMemo" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>

  </view>
</block>

<!-- ======================================================
  【老人端 — 用药打卡弹窗】
====================================================== -->
<view class="modal-mask clock-mask" wx:if="{{showMedClock}}"
  catchtouchmove="onModalStop"
  catchtap="onModalStop">
  <view class="clock-modal" catchtap="onModalStop">
    <text class="clock-title">💊 用药提醒</text>
    <text class="clock-time">⏰ {{clockMedInfo.time}}</text>
    <text class="clock-med-name">{{clockMedInfo.name}}</text>
    <text class="clock-dose">用量：{{clockMedInfo.dose}}</text>
    <text class="clock-note" wx:if="{{clockMedInfo.note}}">{{clockMedInfo.note}}</text>
    <view class="clock-btn-row">
      <view class="clock-btn clock-btn-taken" bindtap="onMedClock" data-status="taken">
        ✅ 已吃
      </view>
      <view class="clock-btn clock-btn-skip" bindtap="onMedClock" data-status="skipped">
        ❌ 未吃
      </view>
    </view>
  </view>
</view>

<!-- ======================================================
  【老人端 — 备忘录详情弹窗】
====================================================== -->
<view class="modal-mask" wx:if="{{showMemoDetail}}"
  catchtouchmove="onModalStop"
  catchtap="onModalStop">
  <view class="modal-box memo-detail-modal" catchtap="onModalStop">
    <text class="memo-detail-title">{{currentMemo.title}}</text>
    <text class="memo-detail-date" wx:if="{{currentMemo.date}}">📅 {{currentMemo.date}}</text>
    <text class="memo-detail-content">{{currentMemo.content}}</text>
    <view wx:if="{{currentMemo.images && currentMemo.images.length > 0}}" class="memo-detail-images">
      <image
        wx:for="{{currentMemo.images}}"
        wx:key="*this"
        wx:for-item="img"
        src="{{img}}"
        class="memo-detail-img"
        mode="aspectFill"
        bindtap="onPreviewImage"
        data-urls="{{currentMemo.images}}"
        data-current="{{img}}"
      />
    </view>
    <button class="btn-primary btn-close-memo" bindtap="onCloseMemoDetail">我知道了</button>
  </view>
</view>

<!-- ======================================================
  【新增用药提醒弹窗】
====================================================== -->
<view class="modal-mask" wx:if="{{showAddMedForm}}"
  catchtouchmove="onModalStop"
  catchtap="onModalStop">
  <view class="modal-box form-modal" catchtap="onModalStop">
    <view class="form-title">💊 新增用药提醒</view>
    <view class="form-row">
      <text class="form-label">药品名称</text>
      <input class="input-field" placeholder="如：血压药" value="{{medForm.name}}" bindinput="onMedInput" data-field="name"/>
    </view>
    <view class="form-row">
      <text class="form-label">服用剂量</text>
      <input class="input-field" placeholder="如：1片" value="{{medForm.dose}}" bindinput="onMedInput" data-field="dose"/>
    </view>
    <view class="form-row">
      <text class="form-label">服用说明</text>
      <input class="input-field" placeholder="如：饭后服用" value="{{medForm.note}}" bindinput="onMedInput" data-field="note"/>
    </view>
    <view class="form-row">
      <text class="form-label">提醒时间</text>
      <picker mode="time" value="{{medForm.time}}" bindchange="onPickMedTime">
        <view class="picker-display">{{medForm.time || '点击选择时间'}}</view>
      </picker>
    </view>
    <view class="form-btns">
      <button class="btn-cancel" bindtap="onCloseAddMed">取消</button>
      <button class="btn-primary" bindtap="onSaveMed">保存提醒</button>
    </view>
  </view>
</view>

<!-- ======================================================
  【新增/编辑备忘录弹窗】
====================================================== -->
<view class="modal-mask" wx:if="{{showAddMemo}}"
  catchtouchmove="onModalStop"
  catchtap="onModalStop">
  <view class="modal-box form-modal" catchtap="onModalStop">
    <view class="form-title">📅 {{memoForm.id ? '编辑' : '新增'}}备忘录</view>
    <view class="form-row">
      <text class="form-label">事项标题</text>
      <input class="input-field" placeholder="如：爸爸体检" value="{{memoForm.title}}" bindinput="onMemoInput" data-field="title"/>
    </view>
    <view class="form-row">
      <text class="form-label">事项内容</text>
      <textarea class="textarea-field" placeholder="填写详细内容..." value="{{memoForm.content}}" bindinput="onMemoInput" data-field="content"/>
    </view>
    <view class="form-row">
      <text class="form-label">重要日期</text>
      <picker mode="date" value="{{memoForm.date}}" bindchange="onPickMemoDate">
        <view class="picker-display">{{memoForm.date || '点击选择日期（可选）'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">上传图片（最多3张）</text>
      <view class="img-upload-area">
        <view wx:for="{{memoForm.images}}" wx:key="*this" wx:for-item="img" class="img-thumb-wrap">
          <image src="{{img}}" class="img-thumb" mode="aspectFill"/>
          <view class="img-delete-btn" bindtap="onDeleteMemoImage" data-index="{{index}}">✕</view>
        </view>
        <view class="img-add-btn" bindtap="onAddMemoImage" wx:if="{{memoForm.images.length < 3}}">
          <text class="img-add-icon">📷</text>
          <text class="img-add-text">添加图片</text>
        </view>
      </view>
    </view>
    <view class="form-btns">
      <button class="btn-cancel" bindtap="onCloseAddMemo">取消</button>
      <button class="btn-primary" bindtap="onSaveMemo">保存</button>
    </view>
  </view>
</view>

<!-- 底部占位 -->
<view style="height: 120rpx;"></view>

</view>
