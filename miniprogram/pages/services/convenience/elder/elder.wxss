/* pages/services/convenience/elder/elder.wxss */
/* ============================================================
  孝亲守护页面样式
  配色体系：暖橙 #D4820A / 米黄 #FFF8EE / 暖棕 #8B5E3C
  字体基线：老人端 ≥ 36rpx，晚辈端 ≥ 28rpx
  按钮基线：老人端 ≥ 140rpx 高，晚辈端 ≥ 88rpx 高
============================================================ */

/* ---- 页面基础 ---- */
.elder-page {
  min-height: 100vh;
  background: #F5F0E8;
  padding-bottom: 40rpx;
}

/* ---- 顶部导航 ---- */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF8EE;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #E8DCC8;
  position: sticky;
  top: 0;
  z-index: 100;
}
.nav-back {
  font-size: 32rpx;
  color: #D4820A;
  font-weight: bold;
  padding: 10rpx 0;
}
.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #5C3A1E;
}
.nav-right {
  display: flex;
  align-items: center;
}
.nav-role-tag {
  font-size: 26rpx;
  color: #8B5E3C;
  background: #F5E6D0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* ============================================================
  通用卡片/区块
============================================================ */
.section-card {
  background: #FFFDF8;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(212,130,10,0.08);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C3A1E;
}
.section-arrow {
  color: #D4820A;
  font-size: 28rpx;
}
.empty-tip {
  text-align: center;
  color: #B09070;
  font-size: 28rpx;
  padding: 40rpx 0;
}

/* ============================================================
  【身份选择弹窗】
============================================================ */
/* ✅ 问题10修复：替换 inset:0 为兼容写法 */
.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-box {
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 88vw;
  max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.2);
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5C3A1E;
  text-align: center;
  margin-bottom: 12rpx;
}
.modal-sub {
  font-size: 26rpx;
  color: #B09070;
  text-align: center;
  margin-bottom: 40rpx;
}
.identity-modal {}
.identity-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 40rpx;
}
.identity-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}
.identity-selected {
  background: #FFF3E0;
  border-color: #D4820A;
}
.identity-icon {
  font-size: 52rpx;
  margin-bottom: 10rpx;
}
.identity-label {
  font-size: 28rpx;
  color: #5C3A1E;
  font-weight: bold;
}
.btn-confirm-identity {
  width: 100%;
  margin-top: 8rpx;
}

/* ============================================================
  通用按钮
============================================================ */
.btn-primary {
  background: linear-gradient(135deg, #E8940A, #D4820A);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  padding: 22rpx 40rpx;
  text-align: center;
}
/* ✅ 问题12修复：给 .btn-cancel 增加 box-sizing */
.btn-cancel {
  background: #F0EAE0;
  color: #8B5E3C;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  padding: 22rpx 40rpx;
  flex: 1;
  margin-right: 20rpx;
  box-sizing: border-box;
}
.btn-add {
  background: #FFF3E0;
  color: #D4820A;
  border: 2rpx solid #D4820A;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  padding: 10rpx 24rpx;
  line-height: 1.4;
}
.btn-edit {
  color: #D4820A;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #D4820A;
  border-radius: 10rpx;
  margin-right: 16rpx;
}
.btn-delete {
  color: #E74C3C;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #E74C3C;
  border-radius: 10rpx;
}
.btn-mini {
  font-size: 24rpx;
  background: #D4820A;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
  margin-left: 16rpx;
}
.btn-sm {
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
  margin-top: 0;
}

/* ✅ 问题13修复：清除按钮默认边框 */
.btn-primary::after {
  display: none;
}
.btn-cancel::after {
  display: none;
}
.btn-add::after {
  display: none;
}
.btn-mini::after {
  display: none;
}

/* ============================================================
  ★★★ 老人视图（ELDER VIEW）★★★
  所有字体/按钮均为最大规格
============================================================ */
.elder-view {
  padding: 20rpx 0;
}
.elder-welcome-card {
  background: linear-gradient(135deg, #FFF3E0, #FFECCC);
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #F5D5A0;
}
.elder-welcome-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #D4820A;
  margin-bottom: 12rpx;
}
.elder-welcome-sub {
  font-size: 28rpx;
  color: #8B5E3C;
  text-align: center;
}
.elder-section {
  background: #FFFDF8;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(212,130,10,0.08);
}
.elder-section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5C3A1E;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F0E8D8;
}
.elder-empty {
  text-align: center;
  font-size: 32rpx;
  color: #B09070;
  padding: 40rpx 0;
}
/* 老人端用药卡片 */
.elder-med-card {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #D4820A;
}
.elder-med-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.elder-med-name {
  font-size: 44rpx;  /* 老人端大字 */
  font-weight: bold;
  color: #5C3A1E;
}
.elder-med-time {
  font-size: 32rpx;
  color: #D4820A;
  font-weight: bold;
}
.elder-med-dose {
  font-size: 36rpx;
  color: #8B5E3C;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}
.elder-med-note {
  font-size: 30rpx;
  color: #A0855B;
  display: block;
}
/* 打卡记录行（老人端） */
.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0E8D8;
  gap: 20rpx;
}
.record-status {
  font-size: 32rpx;
  font-weight: bold;
}
.status-taken { color: #27AE60; }
.status-skip  { color: #E74C3C; }
.record-name {
  flex: 1;
  font-size: 30rpx;
  color: #5C3A1E;
}
.record-time {
  font-size: 28rpx;
  color: #B09070;
}
/* 老人端备忘录按钮 */
.elder-memo-btn {
  background: #F5F0E8;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 3rpx solid #E8DCC8;
}
.elder-memo-btn-active {
  background: #FFF3E0;
  border-color: #D4820A;
}
.elder-memo-btn-icon {
  font-size: 52rpx;
}
.elder-memo-btn-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #5C3A1E;
  flex: 1;
  line-height: 1.5;
}

/* ============================================================
  ★★★ 老人端用药打卡弹窗（CLOCK MODAL）★★★
  全屏居中，字体极大，按钮极大
============================================================ */
.clock-mask {
  background: rgba(0,0,0,0.75);
}
.clock-modal {
  background: #FFFDF8;
  border-radius: 32rpx;
  width: 90vw;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 60rpx rgba(0,0,0,0.3);
}
.clock-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #D4820A;
  margin-bottom: 16rpx;
}
.clock-time {
  font-size: 40rpx;
  color: #8B5E3C;
  margin-bottom: 32rpx;
}
.clock-med-name {
  font-size: 72rpx;  /* 老人端核心信息超大字 */
  font-weight: bold;
  color: #5C3A1E;
  margin-bottom: 20rpx;
  text-align: center;
  line-height: 1.3;
}
.clock-dose {
  font-size: 48rpx;
  font-weight: bold;
  color: #D4820A;
  margin-bottom: 16rpx;
}
.clock-note {
  font-size: 36rpx;
  color: #8B5E3C;
  margin-bottom: 48rpx;
  text-align: center;
}
.clock-btn-row {
  display: flex;
  width: 100%;
  gap: 30rpx;
  margin-top: 20rpx;
}
.clock-btn {
  flex: 1;
  height: 140rpx;         /* 老人端按钮超大 */
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: bold;
}
.clock-btn-taken {
  background: linear-gradient(135deg, #27AE60, #1E8449);
  color: #fff;
}
.clock-btn-skip {
  background: linear-gradient(135deg, #E74C3C, #C0392B);
  color: #fff;
}

/* ============================================================
  ★★★ 晚辈视图（JUNIOR VIEW）★★★
============================================================ */
.junior-view {}

/* 绑定状态标签 */
.bound-badge {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: bold;
}
.badge-bound   { background: #E8F8EF; color: #27AE60; }
.badge-unbound { background: #FFF3E0; color: #D4820A; }

/* 绑定面板 */
.bind-panel {
  background: #F9F5EF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 8rpx;
}
.my-code-box {
  display: flex;
  align-items: center;
  background: #FFF8EE;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  gap: 16rpx;
}
.my-code-label {
  font-size: 26rpx;
  color: #8B5E3C;
}
.my-code-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4820A;
  letter-spacing: 4rpx;
  flex: 1;
  text-align: center;
}

/* 绑定方式选择 */
.bind-methods { margin-bottom: 24rpx; }
.bind-method-title {
  font-size: 26rpx;
  color: #8B5E3C;
  margin-bottom: 16rpx;
}
.bind-method-list {
  display: flex;
  gap: 20rpx;
}
.bind-method-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: #FFFDF8;
  border-radius: 16rpx;
  border: 3rpx solid #E8DCC8;
  gap: 8rpx;
}
.method-active {
  border-color: #D4820A;
  background: #FFF3E0;
}
.method-icon { font-size: 40rpx; }
.method-name { font-size: 24rpx; color: #5C3A1E; font-weight: bold; }

/* 微信号输入行 */
.wxid-input-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

/* 绑定码输入行 */
.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.input-label {
  font-size: 26rpx;
  color: #8B5E3C;
  white-space: nowrap;
}
.input-field {
  flex: 1;
  background: #fff;
  border: 2rpx solid #E8DCC8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #5C3A1E;
  min-width: 180rpx;
}

/* 成员列表 */
.member-list { margin-top: 28rpx; }
.member-list-title {
  font-size: 26rpx;
  color: #8B5E3C;
  margin-bottom: 12rpx;
}
.member-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0E8D8;
  gap: 16rpx;
}
.member-icon { font-size: 36rpx; }
.member-name {
  flex: 1;
  font-size: 28rpx;
  color: #5C3A1E;
  font-weight: bold;
}
.member-role-tag {
  font-size: 22rpx;
  background: #F5E6D0;
  color: #D4820A;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* 用药卡片（晚辈端） */
.med-card {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #D4820A;
}
.med-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.med-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C3A1E;
}
.med-card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.med-info-text {
  font-size: 26rpx;
  color: #8B5E3C;
}
.med-card-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-tag {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-weight: bold;
}
.tag-on  { background: #E8F8EF; color: #27AE60; }
.tag-off { background: #F5F0E8; color: #B09070; }

/* 打卡记录行（晚辈端） */
.record-row-junior {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0E8D8;
  gap: 16rpx;
}
.record-info { flex: 1; }
.record-info-name {
  font-size: 28rpx;
  color: #5C3A1E;
  font-weight: bold;
  display: block;
}
.record-info-time {
  font-size: 24rpx;
  color: #B09070;
  display: block;
  margin-top: 6rpx;
}

/* 备忘录卡片 */
.memo-card {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #8E44AD;
}
.memo-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.memo-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #5C3A1E;
}
.memo-date {
  font-size: 24rpx;
  color: #8B5E3C;
}
.memo-content {
  font-size: 28rpx;
  color: #8B5E3C;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}
.memo-images {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
/* ✅ 问题11修复：删除无效的 object-fit: cover */
.memo-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}
.memo-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

/* 图片上传区域 */
.img-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.img-thumb-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
/* ✅ 问题11修复：删除无效的 object-fit: cover */
.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.img-delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F5F0E8;
  border: 3rpx dashed #E8DCC8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.img-add-icon { font-size: 44rpx; }
.img-add-text { font-size: 22rpx; color: #B09070; }

/* ============================================================
  表单弹窗
============================================================ */
.form-modal {}
.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #5C3A1E;
  text-align: center;
  margin-bottom: 36rpx;
}
.form-row {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #8B5E3C;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.textarea-field {
  width: 100%;
  min-height: 120rpx;
  background: #F9F5EF;
  border: 2rpx solid #E8DCC8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #5C3A1E;
  box-sizing: border-box;
  line-height: 1.6;
}
.picker-display {
  background: #F9F5EF;
  border: 2rpx solid #E8DCC8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #5C3A1E;
}
.form-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.form-btns .btn-primary {
  flex: 1;
}

/* ============================================================
  老人端备忘录详情弹窗
============================================================ */
.memo-detail-modal {}
.memo-detail-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #5C3A1E;
  text-align: center;
  margin-bottom: 16rpx;
}
.memo-detail-date {
  display: block;
  font-size: 32rpx;
  color: #D4820A;
  text-align: center;
  margin-bottom: 28rpx;
}
.memo-detail-content {
  display: block;
  font-size: 40rpx;    /* 老人端大字 */
  font-weight: bold;
  color: #5C3A1E;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 32rpx;
}
.memo-detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 32rpx;
}
/* ✅ 问题11修复：删除无效的 object-fit: cover */
.memo-detail-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}
.btn-close-memo {
  width: 100%;
  margin-top: 8rpx;
  font-size: 34rpx;
  height: 100rpx;
}
/* ── 功能说明区块 ── */
.feature-intro-box {
  background: #FFF8EE;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid #F5D5A0;
}
.feature-intro-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #D4820A;
  margin-bottom: 16rpx;
}
.feature-intro-text {
  font-size: 26rpx;
  color: #5C3A1E;
  line-height: 1.7;
  margin-bottom: 12rpx;
