/* pages/services/convenience/guide/guide.wxss */
.container {
  padding: 0 0 40rpx 0;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #FF6B35, #E8A838);
  padding: 40rpx 30rpx 36rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 20rpx;
}

.header-tip-row {
  background: rgba(255,255,255,0.2);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  text-align: left;
}

.header-tip-icon { font-size: 26rpx; flex-shrink: 0; }

.header-tip-text {
  font-size: 23rpx;
  color: rgba(255,255,255,0.95);
  line-height: 1.6;
  flex: 1;
}

/* 列表 */
.list {
  margin: 20rpx 20rpx 0;
}

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}

.item-hover {
  opacity: 0.8;
  transform: scale(0.99);
}

/* 左侧图标 */
.item-left {
  width: 80rpx;
  height: 80rpx;
  background: #FFF3EC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon { font-size: 40rpx; }

/* 中间内容 */
.item-center {
  flex: 1;
  padding: 0 16rpx;
}

.item-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
}

/* 标签区分 */
.tag {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  font-weight: bold;
}

.tag-web {
  color: #2980B9;
  background: #E8F4FE;
  border: 1rpx solid #BDD9F5;
}

.tag-phone {
  color: #E67E22;
  background: #FEF0E6;
  border: 1rpx solid #F5D0A9;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.item-action-tip {
  display: block;
  font-size: 22rpx;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.web-tip { color: #2980B9; }
.phone-tip { color: #E67E22; }

.item-phone {
  font-size: 24rpx;
  color: #555;
  font-weight: bold;
}

/* 右箭头 */
.item-right { width: 36rpx; text-align: center; flex-shrink: 0; }
.arrow { font-size: 44rpx; color: #DDD; }

/* 底部 */
.footer {
  margin: 24rpx 20rpx 0;
}

.footer-card {
  background: #FFF8EE;
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.footer-icon { font-size: 32rpx; flex-shrink: 0; }

.footer-text {
  font-size: 24rpx;
  color: #7a5800;
  line-height: 1.6;
  flex: 1;
}

.footer-addr {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #2980B9;
  font-weight: bold;
  padding: 10rpx 0;
}
