<!-- pages/services/convenience/guide/guide.wxml -->
<view class="container">

<!-- 头部 -->
<view class="header">
  <text class="title">📋 办事指南</text>
  <text class="subtitle">平江便民政务服务一站查询</text>
  <view class="header-tip-row">
    <text class="header-tip-icon">💡</text>
    <text class="header-tip-text">🌐 蓝色标签可直接跳转官网；📞 橙色标签点击查看办理指引</text>
  </view>
</view>

<!-- 服务列表 -->
<view class="list">
  <view
    class="item"
    wx:for="{{services}}"
    wx:key="id"
    bindtap="goToService"
    data-item="{{item}}"
    hover-class="item-hover"
  >
    <!-- 左侧图标 -->
    <view class="item-left">
      <text class="icon">{{item.icon}}</text>
    </view>

    <!-- 中间内容 -->
    <view class="item-center">
      <view class="item-title-row">
        <text class="item-title">{{item.title}}</text>
        <text class="tag {{item.type === 'web' ? 'tag-web' : 'tag-phone'}}">
          {{item.type === 'web' ? '🌐 网上办' : '📞 电话/APP'}}
        </text>
      </view>
      <text class="item-desc">{{item.desc}}</text>
      <!-- 网络办理提示 -->
      <text wx:if="{{item.type === 'web'}}" class="item-action-tip web-tip">
        点击直接跳转官方网站
      </text>
      <!-- APP/电话办理提示 -->
      <text wx:if="{{item.type === 'phone'}}" class="item-action-tip phone-tip">
        点击查看APP入口与热线
      </text>
      <text class="item-phone">📞 {{item.phone}}</text>
    </view>

    <!-- 右侧箭头 -->
    <view class="item-right">
      <text class="arrow">›</text>
    </view>
  </view>
</view>

<!-- 底部提示 -->
<view class="footer">
  <view class="footer-card">
    <text class="footer-icon">🏛️</text>
    <text class="footer-text">以上均为官方渠道，如遇问题请携带相关证件到平江县政务服务大厅现场办理</text>
  </view>
  <text class="footer-addr">📍 平江县政务服务大厅：0730-6822000</text>
</view>

</view>
