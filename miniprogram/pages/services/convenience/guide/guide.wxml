<!-- miniprogram/pages/services/convenience/guide/guide.wxml -->
<scroll-view scroll-y enable-flex class="page-wrap">

<!-- 顶部说明 -->
<view class="top-banner">
  <text class="banner-icon">🏛️</text>
  <view class="banner-text-wrap">
    <text class="banner-title">平江汇 · 办事指南</text>
    <text class="banner-desc">聚合官方政务平台，一站找到所需</text>
  </view>
</view>

<!-- 分类列表 -->
<view
  wx:for="{{guideList}}"
  wx:key="id"
  class="category-block"
>
  <view class="category-header">
    <text class="category-icon">{{item.icon}}</text>
    <text class="category-name">{{item.category}}</text>
  </view>

  <view class="items-wrap">
    <view
      wx:for="{{item.items}}"
      wx:for-item="sub"
      wx:key="id"
      class="guide-item"
      bindtap="goToGuide"
      data-url="{{sub.url}}"
      data-name="{{sub.name}}"
      hover-class="item-hover"
    >
      <view class="guide-left">
        <text class="guide-item-icon">{{sub.icon}}</text>
      </view>
      <view class="guide-info">
        <view class="guide-name-row">
          <text class="guide-name">{{sub.name}}</text>
          <text
            wx:if="{{sub.tag}}"
            class="guide-tag"
          >{{sub.tag}}</text>
        </view>
        <text class="guide-desc">{{sub.desc}}</text>
      </view>
      <text class="guide-arrow">›</text>
    </view>
  </view>
</view>

<!-- 底部说明 -->
<view class="bottom-tip">
  <text class="bottom-tip-icon">ℹ️</text>
  <text class="bottom-tip-text">以上链接均为官方政府平台，如遇访问问题请直接前往政务大厅办理</text>
</view>

<view style="height: 60rpx;"></view>
</scroll-view>
