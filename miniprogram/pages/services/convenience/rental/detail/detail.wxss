/* 复用 rental.wxss 中的房源卡片样式，以下为补充 */
page { background: #F5F0E8; font-family: -apple-system, 'PingFang SC', sans-serif; }
.page-wrap { min-height: 100vh; background: #F5F0E8; padding-bottom: 40rpx; }
.house-img-wrap { width: 100%; height: 420rpx; position: relative; background: #F0E8D8; }
.house-img { width: 100%; height: 100%; }
.house-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #C4A882; font-size: 26rpx; }
.tag-type { position: absolute; top: 16rpx; left: 16rpx; background: rgba(212,130,10,0.9); color: #fff; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 6rpx; }
.tag-vip { position: absolute; top: 16rpx; right: 16rpx; background: linear-gradient(135deg,#D4820A,#FF6B35); color: #fff; font-size: 20rpx; font-weight: 700; padding: 6rpx 14rpx; border-radius: 6rpx; }
.house-info { padding: 28rpx 28rpx 40rpx; }
.house-title { font-size: 32rpx; font-weight: 700; color: #3A2F1E; line-height: 1.4; display: block; margin-bottom: 16rpx; }
.house-price-row { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 12rpx; }
.house-price { font-size: 36rpx; font-weight: 700; color: #D4820A; }
.house-room { font-size: 24rpx; color: #8B7355; }
.house-area { font-size: 24rpx; color: #8B7355; display: block; margin-bottom: 16rpx; }
.house-desc { font-size: 28rpx; color: #5A4A35; line-height: 1.7; display: block; margin-bottom: 20rpx; }
.house-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 24rpx; }
.house-tag { background: #FFF3E0; color: #D4820A; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 6rpx; border: 1rpx solid #FFD090; }
.house-footer { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.publish-time { font-size: 22rpx; color: #A89070; }
.btn-contact { background: #D4820A; color: #fff; font-size: 28rpx; padding: 18rpx 40rpx; border-radius: 32rpx; border: none; }
.btn-contact::after { display: none; }
.anti-fraud-tip { font-size: 20rpx; color: #D4820A; background: #FFF8E1; padding: 8rpx 16rpx; border-radius: 6rpx; border: 1rpx solid #FFE082; display: block; }
.empty-tip { text-align: center; padding: 80rpx 0; color: #A89070; font-size: 28rpx; }
