/* pages/services/convenience/rental/rental.wxss */

/* ══════════════════ 全局 ══════════════════ */
page {
  background: #F5F0E8;
  font-family: -apple-system, 'PingFang SC', sans-serif;
  color: #3A2F1E;
}

.page-wrap {
  min-height: 100vh;
  background: #F5F0E8;
  padding-bottom: 40rpx;
}

/* ══════════════════ 顶部 Banner ══════════════════ */
.top-banner {
  background: linear-gradient(135deg, #FFF8EE 0%, #F5E6C8 100%);
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #EDE0CC;
}

.banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A2F1E;
}

.banner-sub {
  font-size: 20rpx;
  color: #A89070;
  line-height: 1.5;
}

.btn-publish-entry {
  background: #D4820A;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  border: none;
  flex-shrink: 0;
  margin-left: 16rpx;
  line-height: 1.4;
}

.btn-publish-entry::after { display: none; }

/* ══════════════════ 筛选栏 ══════════════════ */
.filter-bar {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  background: #FFFDF8;
  border-bottom: 1rpx solid #EDE0CC;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #8B7355;
  background: #F5F0E8;
  margin-right: 12rpx;
  border: 1rpx solid transparent;
}

.filter-tag-active {
  background: #FFF3E0;
  color: #D4820A;
  border-color: #D4820A;
  font-weight: 600;
}

.type-bar {
  display: flex;
  padding: 12rpx 20rpx;
  background: #FFFDF8;
  border-bottom: 2rpx solid #EDE0CC;
  gap: 12rpx;
}

.type-tag {
  padding: 10rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #8B7355;
}

.type-tag-active {
  color: #D4820A;
  font-weight: 700;
  border-bottom: 3rpx solid #D4820A;
}

/* ══════════════════ 房源列表 ══════════════════ */
.house-list {
  padding: 20rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #A89070;
  font-size: 28rpx;
}

.house-card {
  background: #FFFDF8;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #EDE0CC;
  overflow: hidden;
}

.house-img-wrap {
  width: 100%;
  height: 320rpx;
  position: relative;
  background: #F0E8D8;
}

.house-img {
  width: 100%;
  height: 100%;
}

.house-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C4A882;
  font-size: 26rpx;
}

.tag-type {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(212, 130, 10, 0.9);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.tag-vip {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #D4820A, #FF6B35);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
}

.house-info {
  padding: 20rpx 24rpx;
}

.house-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2F1E;
  line-height: 1.4;
}

.house-price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 10rpx 0;
}

.house-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #D4820A;
}

.house-room {
  font-size: 24rpx;
  color: #8B7355;
}

.house-area {
  font-size: 24rpx;
  color: #8B7355;
  margin-bottom: 8rpx;
}

.house-desc {
  font-size: 26rpx;
  color: #5A4A35;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.house-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.house-tag {
  background: #FFF3E0;
  color: #D4820A;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  border: 1rpx solid #FFD090;
}

.house-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.publish-time {
  font-size: 22rpx;
  color: #A89070;
}

.btn-contact {
  background: #D4820A;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  border: none;
  line-height: 1.4;
}

.btn-contact::after { display: none; }

.anti-fraud-tip {
  font-size: 20rpx;
  color: #D4820A;
  background: #FFF8E1;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  border: 1rpx solid #FFE082;
}

/* ══════════════════ 发布弹窗 ══════════════════ */
.publish-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s;
  display: flex;
  align-items: flex-end;
}

.publish-mask.mask-show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: all;
}

.publish-drawer {
  width: 100%;
  height: 92vh;
  background: #F5F0E8;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.34, 1.1, 0.64, 1);
  overflow: hidden;
}

.publish-mask.mask-show .publish-drawer {
  transform: translateY(0);
}

/* 弹窗顶栏 */
.drawer-header {
  background: linear-gradient(135deg, #FFF8EE, #F5E6C8);
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #EDE0CC;
  position: relative;
  flex-shrink: 0;
}

.drawer-close {
  position: absolute;
  right: 32rpx;
  top: 28rpx;
  font-size: 36rpx;
  color: #A89070;
  padding: 8rpx;
}

.drawer-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2F1E;
  margin-bottom: 4rpx;
}

.drawer-subtitle {
  font-size: 24rpx;
  color: #A89070;
}

/* 可滚动内容区 */
.drawer-body {
  flex: 1;
  overflow: hidden;
}

/* ── 表单通用 ── */
.form-section {
  background: #FFFDF8;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid #EDE0CC;
  overflow: hidden;
}

.section-label {
  display: block;
  font-size: 26rpx;
  color: #8B7355;
  font-weight: 500;
  padding: 20rpx 24rpx 12rpx;
}

.section-title-bar {
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #F0E8D8;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2F1E;
}

.section-sub {
  font-size: 22rpx;
  color: #A89070;
}

/* 出租方式 */
.rent-type-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}

.rent-type-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #8B7355;
  background: #F5F0E8;
  border: 2rpx solid transparent;
  font-weight: 500;
}

.rent-type-active {
  background: #FFF3E0;
  color: #D4820A;
  border-color: #D4820A;
  font-weight: 700;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #F0E8D8;
  min-height: 88rpx;
}

.form-row-last {
  border-bottom: none;
}

.form-key {
  font-size: 28rpx;
  color: #3A2F1E;
  font-weight: 500;
  flex-shrink: 0;
  width: 180rpx;
}

.required {
  color: #E53935;
  margin-right: 4rpx;
}

.form-val-input {
  flex: 1;
  font-size: 28rpx;
  color: #3A2F1E;
  text-align: right;
}

.form-val-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}

.form-val-input-sm {
  font-size: 28rpx;
  color: #3A2F1E;
  text-align: right;
  max-width: 240rpx;
}

.unit {
  font-size: 26rpx;
  color: #8B7355;
  flex-shrink: 0;
}

.form-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-val {
  font-size: 28rpx;
  color: #3A2F1E;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #C4A882;
}

.picker-arrow {
  font-size: 32rpx;
  color: #C4A882;
}

/* ── 图片上传 ── */
.img-section {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0E8D8;
}

.img-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.img-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2F1E;
}

.img-tip {
  font-size: 24rpx;
  color: #D4820A;
}

.img-tip-bar {
  font-size: 22rpx;
  color: #A89070;
  background: #FFF8E1;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #FFE082;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.img-thumb {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 10rpx;
  overflow: visible;
}

.thumb-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

.thumb-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 1;
}

.img-add-btn {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10rpx;
  border: 2rpx dashed #D4B896;
  background: #FAF5EE;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.img-add-icon {
  font-size: 48rpx;
  color: #C4A882;
  line-height: 1;
}

.img-add-text {
  font-size: 22rpx;
  color: #A89070;
}

.img-add-count {
  font-size: 20rpx;
  color: #C4A882;
}

.img-hint {
  font-size: 22rpx;
  color: #A89070;
  margin-top: 12rpx;
}

/* ── 标签区 ── */
.tag-section {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0E8D8;
}

.tag-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.tag-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2F1E;
}

.tag-add-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8B7355;
}

.tag-add-arrow {
  color: #D4820A;
  font-weight: 600;
}

.tag-desc {
  font-size: 22rpx;
  color: #A89070;
  margin-bottom: 16rpx;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF3E0;
  color: #D4820A;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #FFD090;
}

.tag-remove {
  color: #D4820A;
  font-size: 28rpx;
  line-height: 1;
}

/* ── 描述区 ── */
.desc-section {
  padding: 20rpx 24rpx;
}

.desc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.desc-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2F1E;
}

.desc-tip {
  font-size: 24rpx;
  color: #D4820A;
}

.desc-tip-bar {
  font-size: 22rpx;
  color: #A89070;
  background: #FFF8E1;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #FFE082;
}

.desc-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F5F0E8;
  border: 1rpx solid #DDD0BC;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #3A2F1E;
  box-sizing: border-box;
  line-height: 1.6;
}

.desc-count {
  text-align: right;
  font-size: 22rpx;
  color: #A89070;
  margin-top: 8rpx;
}

/* ── 协议与发布按钮 ── */
.publish-footer {
  margin: 20rpx 20rpx 0;
  background: #FFFDF8;
  border-radius: 16rpx;
  border: 1rpx solid #EDE0CC;
  padding: 24rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #C4A882;
  background: #F5F0E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #D4820A;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.checkbox.checked {
  background: #FFF3E0;
  border-color: #D4820A;
}

.agreement-text {
  font-size: 24rpx;
  color: #5A4A35;
  line-height: 1.7;
  flex: 1;
}

.agreement-link {
  color: #D4820A;
  text-decoration: underline;
}

.btn-submit {
  width: 100%;
  background: #D4820A;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  padding: 28rpx 0;
  border-radius: 16rpx;
  border: none;
  text-align: center;
  line-height: 1.4;
}

.btn-submit::after { display: none; }

.btn-submit.btn-disabled {
  background: #C4B8A8;
  color: #F5EFE6;
}

/* ══════════════════ 标签选择弹窗 ══════════════════ */
.tag-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 200;
  pointer-events: none;
  display: flex;
  align-items: flex-end;
  transition: background 0.25s;
}

.tag-mask.mask-show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: all;
}

.tag-modal {
  width: 100%;
  max-height: 65vh;
  background: #FFFDF8;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.tag-mask.mask-show .tag-modal {
  transform: translateY(0);
}

.tag-modal-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #EDE0CC;
  flex-shrink: 0;
}

.tag-modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2F1E;
  flex: 1;
}

.tag-modal-sub {
  font-size: 24rpx;
  color: #A89070;
  margin-right: 20rpx;
}

.tag-modal-close {
  font-size: 28rpx;
  color: #D4820A;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.tag-modal-body {
  flex: 1;
  overflow: hidden;
}

.all-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}

.all-tag {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #8B7355;
  background: #F5F0E8;
  border: 2rpx solid transparent;
}

.all-tag-active {
  background: #FFF3E0;
  color: #D4820A;
  border-color: #D4820A;
  font-weight: 600;
}
