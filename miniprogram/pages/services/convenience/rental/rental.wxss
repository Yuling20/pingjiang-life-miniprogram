/* pages/services/convenience/rental/rental.wxss */
page { background: #f5f6fa; }

.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 80rpx;
}

/* 顶部 - 含右上角按钮 */
.page-header {
  background: linear-gradient(135deg, #4A90D9, #2c7be5);
  padding: 40rpx 32rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
}

/* 右上角"我要发房"按钮 */
.header-right-btn {
  background: #FF6B35;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.header-btn-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
}

/* ⚠️ 提醒语 */
.warning-bar {
  background: #FFF8E1;
  border-left: 6rpx solid #FFC107;
  margin: 20rpx 24rpx;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #7a5800;
  line-height: 1.6;
}

/* 筛选 */
.filter-scroll {
  width: 100%;
  padding: 0 0 0 24rpx;
  margin-bottom: 12rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  padding-right: 24rpx;
}

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #555;
  font-size: 28rpx;
  margin-right: 16rpx;
  border: 2rpx solid #e0e0e0;
}

.chip-active {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
  font-weight: 600;
}

/* 列表 */
.list-wrap { padding: 12rpx 24rpx 0; }

/* 卡片 */
.rental-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.07);
}

.card-hover { opacity: 0.9; }

.card-img {
  width: 100%;
  height: 200rpx;
  background: #e8f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-placeholder { display: flex; align-items: center; justify-content: center; }
.img-tip { font-size: 26rpx; color: #aaa; }

.card-body { padding: 24rpx 24rpx 16rpx; }

.card-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.card-title { font-size: 34rpx; font-weight: 700; color: #222; flex: 1; }

.card-type-tag {
  background: #e8f4ff;
  color: #4A90D9;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.price-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 12rpx;
  gap: 16rpx;
}

.price-main { font-size: 40rpx; font-weight: 800; color: #e74c3c; }
.price-sub { font-size: 26rpx; color: #888; }

.addr-row { margin-top: 10rpx; }
.addr-text { font-size: 28rpx; color: #666; }

.card-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-top: 12rpx;
  display: block;
}

.tag-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 14rpx;
  gap: 10rpx;
}

.tag-item {
  background: #f0f7ff;
  color: #4A90D9;
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

.card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.publish-date { font-size: 26rpx; color: #aaa; }

.contact-btn {
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
}

.card-warn {
  background: #FFF8E1;
  font-size: 24rpx;
  color: #8B6914;
  padding: 14rpx 24rpx;
  border-top: 1rpx solid #ffe082;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 100rpx; }
.empty-text { font-size: 32rpx; color: #aaa; margin-top: 24rpx; }
