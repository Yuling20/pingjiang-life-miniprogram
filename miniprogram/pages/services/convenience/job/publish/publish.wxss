page { background: #f5f5f5; }
.container { padding: 24rpx 24rpx 160rpx; }

/* section */
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.section__title { font-size: 28rpx; font-weight: 600; color: #222; margin-bottom: 20rpx; }

/* 表单 */
.form-item { margin-bottom: 20rpx; }
.form-item__label { font-size: 24rpx; color: #888; margin-bottom: 8rpx; display: block; }
.form-item__input {
  border: 1rpx solid #eee; border-radius: 10rpx;
  padding: 18rpx 20rpx; font-size: 26rpx; width: 100%; box-sizing: border-box;
}
.form-item__textarea {
  border: 1rpx solid #eee; border-radius: 10rpx;
  padding: 18rpx 20rpx; font-size: 26rpx; width: 100%;
  min-height: 160rpx; box-sizing: border-box;
}

/* 套餐网格 */
.pkg-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.pkg-card {
  flex: 1 1 calc(50% - 8rpx);
  border: 2rpx solid #eee; border-radius: 14rpx;
  padding: 20rpx 18rpx; position: relative;
  box-sizing: border-box; text-align: center;
  background: #fafafa;
}
.pkg-card--active { border-color: #f90; background: #fff8f0; }
.pkg-card__tag {
  position: absolute; top: -1rpx; right: -1rpx;
  background: #f90; color: #fff; font-size: 18rpx;
  padding: 4rpx 14rpx; border-radius: 0 14rpx 0 10rpx;
}
.pkg-card__name { font-size: 24rpx; color: #333; margin-bottom: 10rpx; }
.pkg-card__cash { font-size: 30rpx; font-weight: 700; color: #f90; }
.pkg-card__points { font-size: 22rpx; color: #aaa; margin-top: 4rpx; }

/* 支付方式 */
.pay-type-row { display: flex; gap: 20rpx; }
.pay-type-btn {
  flex: 1; text-align: center; padding: 20rpx;
  border: 2rpx solid #eee; border-radius: 12rpx;
  font-size: 24rpx; color: #666;
}
.pay-type-btn--active { border-color: #f90; color: #f90; background: #fff8f0; }

/* 优惠券 */
.coupon-row {
  display: flex; justify-content: space-between; align-items: center;
}
.coupon-row__label { font-size: 26rpx; color: #e67e22; }
.coupon-row__hint { font-size: 24rpx; color: #999; }

/* 底部 */
.footer {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}
.footer__tip { font-size: 22rpx; color: #bbb; text-align: center; margin-bottom: 12rpx; }
.submit-btn {
  background: #f90; color: #fff; font-size: 30rpx; font-weight: 600;
  text-align: center; padding: 26rpx 0; border-radius: 50rpx;
}
