<view class="container">

<!-- 表单区 -->
<view class="section">
  <view class="section__title">招聘信息</view>
  <view class="form-item">
    <text class="form-item__label">职位标题</text>
    <input class="form-item__input" placeholder="请输入职位名称"
      data-field="title" bindinput="onFormInput" value="{{form.title}}" />
  </view>
  <view class="form-item">
    <text class="form-item__label">岗位描述</text>
    <textarea class="form-item__textarea" placeholder="请输入岗位描述、要求等"
      data-field="content" bindinput="onFormInput" value="{{form.content}}" />
  </view>
  <view class="form-item">
    <text class="form-item__label">联系方式</text>
    <input class="form-item__input" placeholder="请输入联系电话或微信"
      data-field="contact" bindinput="onFormInput" value="{{form.contact}}" />
  </view>
</view>

<!-- ===== 删除原有旧套餐+旧支付+旧优惠券，替换为新套餐结构 ===== -->
<!-- 限时优惠提示 -->
<view class="promo-tip">限时优惠券抵扣，免费发布</view>

<!-- 套餐选择 -->
<view class="package-section">
  <view class="section-title">选择发布套餐</view>
  
  <!-- 基础套餐 -->
  <view class="package-card {{selectedPackage === 'basic' ? 'active' : ''}}" bindtap="selectPackage" data-type="basic">
    <view class="package-header">基础宣传</view>
    <view class="package-info">
      <text class="duration">7天展示</text>
      <text class="original-price">¥10</text>
      <text class="discount-price">¥6</text>
      <text class="points-cost">或 60积分</text>
    </view>
  </view>

  <!-- 置顶套餐 -->
  <view class="package-card {{selectedPackage === 'top' ? 'active' : ''}}" bindtap="selectPackage" data-type="top">
    <view class="package-header">置顶推荐</view>
    <view class="package-info">
      <text class="duration">7天置顶</text>
      <text class="original-price">¥30</text>
      <text class="discount-price">¥18</text>
      <text class="points-cost">或 180积分</text>
    </view>
  </view>
</view>

<!-- 支付方式 -->
<view class="payment-section">
  <radio-group bindchange="onPaymentChange">
    <label class="payment-option">
      <radio value="cash" checked="{{paymentMethod === 'cash'}}"/>现金支付
    </label>
    <label class="payment-option">
      <radio value="points" checked="{{paymentMethod === 'points'}}"/>积分兑换
    </label>
  </radio-group>

  <label class="coupon-checkbox">
    <checkbox checked="{{useCoupon}}" bindchange="onCouponChange"/>使用优惠券（限时免费）
  </label>
</view>

<!-- 应付金额 -->
<view class="payment-summary">
  <text wx:if="{{paymentMethod === 'cash'}}">应付：¥{{finalPrice}}</text>
  <text wx:else>消耗积分：{{finalPoints}}</text>
</view>

<!-- 底部提交：bindtap由onSubmit改成submitJob -->
<view class="footer">
  <view class="footer__tip">招聘发布须消耗积分/现金，不赠送积分</view>
  <view class="submit-btn" bindtap="submitJob">确认发布并支付</view>
</view>

</view>