/* pages/services/convenience/job/job.wxss */
page { background: #f5f6fa; }

.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 160rpx;
}

/* 顶部 */
.page-header {
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  padding: 40rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}
.page-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
}

/* ⚠️ 一行警示 */
.warning-bar {
  background: #FFF8E1;
  border-left: 6rpx solid #FFC107;
  margin: 20rpx 24rpx;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
}
.warning-text {
  font-size: 26rpx;
  color: #7a5800;
  line-height: 1.5;
}

/* 筛选 */
.filter-scroll {
  width: 100%;
  padding: 0 0 0 24rpx;
  margin-bottom: 12rpx;
}
.filter-row {
  display: flex;
  flex-direction: row;
  padding-right: 24rpx;
}
.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #555;
  font-size: 28rpx;
  margin-right: 16rpx;
  border: 2rpx solid #e0e0e0;
}
.chip-active {
  background: #2ecc71;
  color: #fff;
  border-color: #2ecc71;
  font-weight: 600;
}

/* 列表 */
.list-wrap {
  padding: 12rpx 24rpx 0;
}

/* 卡片 */
.job-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.07);
}
.card-hover { opacity: 0.9; }

.job-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 24rpx 0;
}
.job-left { flex: 1; margin-right: 16rpx; }
.job-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  display: block;
}
.job-salary {
  font-size: 34rpx;
  font-weight: 800;
  color: #e74c3c;
  margin-top: 8rpx;
  display: block;
}
.job-type-tag {
  background: #e8f8ee;
  color: #27ae60;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.card-img {
  width: 100%;
  height: 140rpx;
  background: #f5f5f5;
  margin: 16rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-tip { font-size: 26rpx; color: #aaa; }

.job-body {
  padding: 20rpx 24rpx;
}
.info-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}
.info-label {
  font-size: 28rpx;
  color: #888;
  flex-shrink: 0;
}
.info-val {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}

.job-footer {
  padding: 0 24rpx 20rpx;
  display: flex;
  justify-content: flex-end;
}
.contact-btn {
  background: #2ecc71;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 14rpx 48rpx;
  border-radius: 30rpx;
}

/* 底部警示 */
.card-warn {
  background: #FFF8E1;
  font-size: 24rpx;
  color: #8B6914;
  padding: 14rpx 24rpx;
  border-top: 1rpx solid #ffe082;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 100rpx; }
.empty-text { font-size: 32rpx; color: #aaa; margin-top: 24rpx; }

/* 发布按钮 */
.publish-fab {
  position: fixed;
  bottom: 140rpx;
  right: 32rpx;
  background: #2ecc71;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 24rpx rgba(46,204,113,0.45);
  z-index: 99;
}
