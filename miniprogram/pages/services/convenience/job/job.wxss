/* pages/services/convenience/job/job.wxss */

/* ===================== 全局变量 ===================== */
page {
  background: #F5F0E8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F0E8;
  overflow: hidden;
}

/* ===================== 顶部标题栏 ===================== */
.top-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  background: #FFF8EE;
  border-bottom: 1rpx solid #EDE3D0;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D2B1F;
  line-height: 1.2;
}

.page-subtitle {
  font-size: 22rpx;
  color: #A08060;
  margin-top: 4rpx;
}

.header-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.resume-btn {
  background: #FFF0D4;
  border: 1rpx solid #D4820A;
  color: #D4820A;
}

.publish-btn {
  background: #D4820A;
  color: #FFFFFF;
}

.action-icon {
  font-size: 26rpx;
}

.action-text {
  font-size: 24rpx;
}

/* ===================== 实名提示条 ===================== */
.realname-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #FFF3CD;
  border-bottom: 1rpx solid #FFD580;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #856404;
}

.tip-arrow {
  font-size: 32rpx;
  color: #856404;
  font-weight: 700;
}

/* ===================== 风险提示条 ===================== */
.risk-banner {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 12rpx 32rpx;
  background: #FFF5F5;
  border-bottom: 1rpx solid #FFD0D0;
}

.risk-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.risk-text {
  font-size: 22rpx;
  color: #C0392B;
  line-height: 1.5;
}

/* ===================== 筛选栏 ===================== */
.filter-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: #FFF8EE;
  border-bottom: 1rpx solid #EDE3D0;
  flex-shrink: 0;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  background: #F0E8D8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #7A6050;
  white-space: nowrap;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.filter-active {
  background: #FFF0D4;
  color: #D4820A;
  border-color: #D4820A;
  font-weight: 600;
}

/* ===================== 列表区域 ===================== */
.list-scroll {
  flex: 1;
  overflow: hidden;
}

.loading-wrap,
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #A08060;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A08060;
}

/* ===================== 职位卡片 ===================== */
.job-card {
  margin: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(61, 43, 31, 0.06);
  border: 1rpx solid #F0E8D8;
}

.card-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.company-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #FFF0D4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.card-header-info {
  flex: 1;
  min-width: 0;
}

.job-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.job-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2B1F;
}

.type-tag {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.type-full {
  background: #E8F4FF;
  color: #1565C0;
}

.type-campus {
  background: #E8FFE8;
  color: #2E7D32;
}

.type-intern {
  background: #FFF3E0;
  color: #E65100;
}

.type-parttime {
  background: #F3E5F5;
  color: #6A1B9A;
}

.vip-tag {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #FFFFFF;
}

.company-name {
  font-size: 24rpx;
  color: #7A6050;
}

.job-salary {
  font-size: 28rpx;
  font-weight: 700;
  color: #D4820A;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.card-body {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.info-text {
  font-size: 24rpx;
  color: #9A8070;
}

.card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E8D8;
}

.desc-preview {
  flex: 1;
  font-size: 24rpx;
  color: #9A8070;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.contact-hint {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.contact-vip {
  background: #FFF0D4;
  color: #D4820A;
  border: 1rpx solid #D4820A;
}

.contact-normal {
  background: #E8F4FF;
  color: #1565C0;
  border: 1rpx solid #1565C0;
}

.list-bottom-pad {
  height: 40rpx;
}

/* ===================== 弹窗通用 ===================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 1000;
}

.modal-sheet {
  background: #FFF8EE;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding: 0 0 env(safe-area-inset-bottom);
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #D4C4B0;
  border-radius: 4rpx;
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

.sheet-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx 24rpx;
  flex-shrink: 0;
  position: relative;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D2B1F;
}

.sheet-back {
  position: absolute;
  left: 32rpx;
  font-size: 26rpx;
  color: #D4820A;
}

.sheet-close {
  position: absolute;
  right: 32rpx;
  font-size: 32rpx;
  color: #A08060;
  padding: 8rpx;
}

.step-indicator {
  position: absolute;
  right: 32rpx;
  font-size: 24rpx;
  color: #A08060;
  background: #F0E8D8;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===================== 详情弹窗 ===================== */
.detail-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 0 32rpx 24rpx;
  border-bottom: 1rpx solid #EDE3D0;
  flex-shrink: 0;
}

.detail-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #FFF0D4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.detail-header-info {
  flex: 1;
}

.detail-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2B1F;
}

.detail-company {
  font-size: 26rpx;
  color: #7A6050;
  display: block;
  margin-bottom: 8rpx;
}

.detail-salary {
  font-size: 30rpx;
  font-weight: 700;
  color: #D4820A;
  display: block;
}

.detail-scroll {
  flex: 1;
  overflow: hidden;
}

.detail-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0E8D8;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #5A4030;
  margin-bottom: 12rpx;
}

.section-content {
  font-size: 26rpx;
  color: #5A4030;
  line-height: 1.7;
}

.contact-section {
  background: #FFF0D4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.contact-person {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.contact-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2B1F;
}

.vip-badge {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.vip-badge text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.contact-desc-text {
  font-size: 24rpx;
  line-height: 1.5;
}

.vip-desc {
  color: #2E7D32;
}

.normal-desc {
  color: #1565C0;
}

.risk-notice {
  margin: 24rpx 32rpx;
  padding: 20rpx 24rpx;
  background: #FFF5F5;
  border-radius: 16rpx;
  border: 1rpx solid #FFD0D0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.risk-notice-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.risk-notice-text {
  font-size: 22rpx;
  color: #C0392B;
  line-height: 1.6;
}

.detail-footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #EDE3D0;
  flex-shrink: 0;
}

.footer-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cancel-btn {
  background: #F0E8D8;
  color: #7A6050;
}

.contact-btn {
  flex: 2;
}

.contact-btn-vip {
  background: #D4820A;
  color: #FFFFFF;
}

.contact-btn-normal {
  background: #1565C0;
  color: #FFFFFF;
}

/* ===================== 发布弹窗 ===================== */
.publish-sheet {
  max-height: 90vh;
}

.publish-step {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-label {
  font-size: 28rpx;
  color: #5A4030;
  margin-bottom: 40rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  width: 100%;
  margin-bottom: 48rpx;
}

.type-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  background: #F0E8D8;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.type-option-active {
  background: #FFF0D4;
  border-color: #D4820A;
}

.type-option-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.type-option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2B1F;
}

.step-next-btn {
  width: 100%;
  padding: 28rpx 0;
  background: #D4820A;
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.publish-scroll {
  flex: 1;
  overflow: hidden;
  padding: 0 32rpx;
}

.selected-type-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: #FFF0D4;
  color: #D4820A;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  border: 1rpx solid #D4820A;
}

/* ===================== 表单通用 ===================== */
.form-item {
  margin-bottom: 28rpx;
}

.form-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.form-half {
  flex: 1;
  min-width: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #5A4030;
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '* ';
  color: #C0392B;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #D4C4B0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #3D2B1F;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #D4C4B0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #3D2B1F;
  min-height: 160rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-error {
  border-color: #C0392B !important;
}

.error-tip {
  font-size: 22rpx;
  color: #C0392B;
  margin-top: 8rpx;
  display: block;
}

.form-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #D4C4B0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #3D2B1F;
}

.picker-arrow {
  font-size: 22rpx;
  color: #A08060;
}

/* 地址输入 */
.address-input-wrap {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.address-input {
  width: 100%;
}

.address-btns {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.addr-btn {
  flex: 1;
  padding: 16rpx 0;
  background: #FFF0D4;
  border: 1rpx solid #D4820A;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #D4820A;
  font-weight: 600;
}

/* 违规/风险提示 */
.publish-rule-tip {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  background: #FFF5F5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #FFD0D0;
}

.publish-risk-tip {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  background: #FFFDE7;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #FFE082;
}

.rule-icon,
.risk-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 22rpx;
  color: #C0392B;
  line-height: 1.6;
}

.risk-text {
  font-size: 22rpx;
  color: #856404;
  line-height: 1.6;
}

.submit-btn {
  padding: 28rpx 0;
  background: #D4820A;
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

/* ===================== 简历弹窗 ===================== */
.resume-sheet {
  max-height: 90vh;
}

.resume-scroll {
  flex: 1;
  overflow: hidden;
  padding: 0 32rpx;
}

.resume-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2B1F;
  padding: 20rpx 0 16rpx;
  border-bottom: 2rpx solid #D4820A;
  margin-bottom: 24rpx;
}

.resume-footer-btns {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 24rpx 0 32rpx;
}

.resume-save-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #F0E8D8;
  color: #7A6050;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #D4C4B0;
}

.resume-preview-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #D4820A;
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.resume-export-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #2E7D32;
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

/* ===================== 简历预览 ===================== */
.preview-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.08);
  border: 1rpx solid #F0E8D8;
}

.preview-name-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.preview-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D2B1F;
}

.preview-gender {
  font-size: 26rpx;
  color: #7A6050;
}

.preview-contact {
  font-size: 26rpx;
  color: #5A4030;
  margin-bottom: 24rpx;
  line-height: 1.8;
}

.preview-divider {
  height: 2rpx;
  background: linear-gradient(90deg, #D4820A, #F0E8D8);
  margin-bottom: 24rpx;
}

.preview-section {
  margin-bottom: 28rpx;
}

.preview-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #D4820A;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #F0E8D8;
}

.preview-section-content {
  font-size: 26rpx;
  color: #5A4030;
  line-height: 1.8;
}

/* ===================== 安全距离 ===================== */
.bottom-safe-pad {
  height: 40rpx;
}
/* 新增：长期、短期 标签样式 */
.type-long {
  background: #E8F4FF;
  color: #1565C0;
}
.type-short {
  background: #FFF3E0;
  color: #E65100;
}