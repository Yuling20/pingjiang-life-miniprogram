/* miniprogram/pages/services/convenience/water/water.wxss */
.page-wrap {
  background: #F5F5F5;
  min-height: 100vh;
  padding: 16rpx 0;
}

/* 顶部提示 */
.top-tip {
  display: flex;
  align-items: flex-start;
  background: #EDF5FF;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  gap: 12rpx;
}
.tip-icon { font-size: 30rpx; }
.tip-text {
  font-size: 24rpx;
  color: #4A90D9;
  line-height: 1.6;
  flex: 1;
}

/* 卡片 */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.section-sub {
  font-size: 24rpx;
  color: #999;
}

/* 本地通知卡片 */
.notice-card {
  border-left: 6rpx solid #ccc;
  padding: 16rpx 16rpx 16rpx 20rpx;
  background: #FAFAFA;
  border-radius: 0 12rpx 12rpx 0;
  margin-bottom: 16rpx;
}
.notice-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.notice-badge {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.new-tag {
  background: #FF4444;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.notice-area {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}
.notice-time {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.notice-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 报修电话 */
.phone-list { display: flex; flex-direction: column; gap: 16rpx; }
.phone-item {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 20rpx;
  gap: 16rpx;
}
.phone-icon { font-size: 40rpx; }
.phone-info { flex: 1; }
.phone-name {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 6rpx;
}
.phone-num {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.call-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
}

/* 官方平台 */
.official-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
}
.item-hover { opacity: 0.75; }
.official-icon { font-size: 48rpx; }
.official-info { flex: 1; }
.official-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.official-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.official-tag {
  font-size: 20rpx;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.official-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}
.official-phone {
  font-size: 24rpx;
  font-weight: bold;
}
.official-arrow {
  font-size: 40rpx;
  font-weight: bold;
}

/* 访问提示 */
.access-tip {
  background: #FFF8E1;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-top: 8rpx;
}
.access-tip-text {
  font-size: 24rpx;
  color: #8B6914;
  line-height: 1.6;
}
