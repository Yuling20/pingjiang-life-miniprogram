/* pages/services/convenience/familytree/community/index.wxss */
/* ============================================================
  乡镇社区课堂样式
  主色系：绿 #2E7D32 / 浅绿底 #F1F8E9
  辅色：橙 #FF9800 / 紫 #7C4DFF / 红 #F44336
============================================================ */

page {
  background: #F1F8E9;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.community-page {
  min-height: 100vh;
  background: #F1F8E9;
}

/* ========== ① 顶部区域 ========== */
.comm-header {
  background: linear-gradient(160deg, #1B5E20 0%, #2E7D32 60%, #388E3C 100%);
  padding: 32rpx 28rpx 40rpx;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}

.comm-header__deco1 {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
  top: -100rpx;
  right: -80rpx;
}

.comm-header__deco2 {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
  bottom: -60rpx;
  left: -40rpx;
}

/* 标题行 */
.comm-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.comm-title-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.comm-title-emoji { font-size: 40rpx; }

.comm-title-main {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.comm-title-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  display: block;
}

.comm-title-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
}

.comm-history-icon { font-size: 26rpx; }

.comm-history-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

/* 搜索框 */
.comm-search {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.comm-search__icon { font-size: 28rpx; }

.comm-search__placeholder {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.65);
}

.comm-search__voice {
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comm-search__voice-icon { font-size: 26rpx; }

/* 统计数据 */
.comm-stats {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(255,255,255,0.12);
  border-radius: 20rpx;
  padding: 16rpx 0;
}

.comm-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.comm-stat-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.comm-stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

.comm-stat-sep {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.2);
}

/* ========== Banner ========== */
.comm-banner-wrap {
  padding: 24rpx 28rpx 0;
}

.comm-banner {
  height: 220rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.comm-banner-card {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.comm-banner-left {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.comm-banner-tag {
  display: inline-block;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  width: fit-content;
}

.comm-banner-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.3;
}

.comm-banner-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}

.comm-banner-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  width: fit-content;
  margin-top: 4rpx;
}

.comm-banner-btn__text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.comm-banner-btn__arrow {
  font-size: 24rpx;
  color: #fff;
}

.comm-banner-emoji {
  font-size: 100rpx;
  opacity: 0.85;
  flex-shrink: 0;
}

/* ========== ② 分类标签 ========== */
.comm-cats-wrap {
  padding: 20rpx 0 0;
}

.comm-cats {
  display: flex;
  white-space: nowrap;
  padding: 0 28rpx;
}

.comm-cat-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border: 2rpx solid #C8E6C9;
  border-radius: 24rpx;
  padding: 14rpx 24rpx;
  margin-right: 16rpx;
  position: relative;
  flex-shrink: 0;
}

.comm-cat-item--active {
  color: #fff;
}

.comm-cat-emoji { font-size: 26rpx; }

.comm-cat-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #4E342E;
}

.comm-cat-item--active .comm-cat-label { color: #fff; }

.comm-cat-count {
  font-size: 18rpx;
  background: rgba(0,0,0,0.1);
  border-radius: 10rpx;
  padding: 2rpx 8rpx;
  color: rgba(0,0,0,0.5);
}

.comm-cat-item--active .comm-cat-count {
  background: rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.9);
}

/* ========== 通用 section ========== */
.comm-section {
  padding: 28rpx 28rpx 0;
}

.comm-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.comm-section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.comm-section-dot {
  display: block;
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
}

.comm-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
}

.comm-section-more {
  font-size: 24rpx;
  color: #2E7D32;
}

/* ========== ③ 今日推荐卡 ========== */
.today-recommend-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(46,125,50,0.1);
}

/* 封面 */
.today-rec-cover {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.today-rec-emoji { font-size: 100rpx; }

/* 直播标签 */
.today-rec-live-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(244,67,54,0.9);
  border-radius: 14rpx;
  padding: 6rpx 16rpx;
}

.today-rec-live-dot {
  display: block;
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 50%;
  animation: blink 1.2s ease-in-out infinite;
}

@keyframes blink {
  0%,100% { opacity: 1; }
  50%      { opacity: 0.2; }
}

.today-rec-live-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}

/* 时长 */
.today-rec-duration {
  position: absolute;
  bottom: 14rpx;
  right: 16rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 10rpx;
  padding: 4rpx 12rpx;
}

.today-rec-duration__text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.9);
}

/* 免费 */
.today-rec-free {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #FF9800;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
}

.today-rec-free__text {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}

/* 课程信息 */
.today-rec-body {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.today-rec-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.today-rec-tag {
  font-size: 20rpx;
  background: #E8F5E9;
  color: #2E7D32;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.today-rec-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.4;
}

.today-rec-desc {
  font-size: 24rpx;
  color: #795548;
  line-height: 1.6;
}

/* 讲师 */
.today-rec-teacher {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.today-rec-teacher-avatar { font-size: 36rpx; }

.today-rec-teacher-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.today-rec-teacher-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #4E342E;
}

.today-rec-teacher-title {
  font-size: 20rpx;
  color: #A1887F;
}

/* 底部 */
.today-rec-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-rec-meta {
  display: flex;
  gap: 16rpx;
}

.today-rec-meta-item {
  font-size: 22rpx;
  color: #BCAAA4;
}

.today-rec-play-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #43A047, #2E7D32);
  border-radius: 20rpx;
  padding: 14rpx 28rpx;
}

.today-rec-play-icon {
  font-size: 20rpx;
  color: #fff;
}

.today-rec-play-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

/* ========== ④ 课程列表 ========== */
.comm-sort-wrap {
  display: flex;
  background: #E8F5E9;
  border-radius: 16rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.comm-sort-item {
  font-size: 22rpx;
  color: #795548;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.comm-sort-item--active {
  background: #2E7D32;
  color: #fff;
  font-weight: bold;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
}

.course-card {
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  gap: 0;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(46,125,50,0.06);
}

.course-card:active {
  opacity: 0.9;
}

/* 左侧封面 */
.course-card__cover {
  width: 180rpx;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.course-card__cover-emoji { font-size: 64rpx; }

/* 进度条 */
.course-card__progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(0,0,0,0.2);
}

.course-card__progress-fill {
  height: 100%;
  background: #69F0AE;
  border-radius: 3rpx;
}

/* 直播标识 */
.course-card__live-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 16rpx;
  height: 16rpx;
  background: #F44336;
  border-radius: 50%;
  animation: blink 1.2s ease-in-out infinite;
}

/* 右侧信息 */
.course-card__body {
  flex: 1;
  padding: 20rpx 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.course-card__tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.course-card__cat-tag {
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.course-card__free-tag {
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: #FFF3E0;
  color: #FF9800;
  font-weight: bold;
}

.course-card__title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 讲师 */
.course-card__teacher {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.course-card__teacher-avatar { font-size: 28rpx; }

.course-card__teacher-name {
  font-size: 22rpx;
  color: #795548;
}

/* 元数据 */
.course-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-card__meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.course-card__meta-item {
  font-size: 20rpx;
  color: #BCAAA4;
}

.course-card__meta-sep {
  font-size: 18rpx;
  color: #E0E0E0;
}

.course-card__collect { padding: 6rpx; }

.course-card__collect--active text {
  filter: saturate(2);
}

/* 进度文字 */
.course-card__progress-text {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-card__progress-num {
  font-size: 20rpx;
  color: #2E7D32;
  font-weight: bold;
}

.course-card__continue {
  font-size: 20rpx;
  color: #2E7D32;
}

/* 空状态 */
.course-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 80rpx 0;
}

.course-empty__icon { font-size: 72rpx; }

.course-empty__text {
  font-size: 28rpx;
  font-weight: bold;
  color: #795548;
}

.course-empty__sub {
  font-size: 22rpx;
  color: #BCAAA4;
}

/* 加载更多 */
.course-loading-more {
  text-align: center;
  padding: 24rpx 0;
}

.course-loading-more__text {
  font-size: 24rpx;
  color: #A5D6A7;
}

.course-load-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  border: 2rpx solid #C8E6C9;
  margin-top: 8rpx;
}

.course-load-more-btn__text {
  font-size: 26rpx;
  color: #2E7D32;
  font-weight: bold;
}

.course-load-more-btn__icon {
  font-size: 26rpx;
  color: #2E7D32;
}

.course-no-more {
  text-align: center;
  padding: 24rpx 0;
}

.course-no-more__text {
  font-size: 22rpx;
  color: #D7CCC8;
}

/* ========== ⑤ 本地名师 ========== */
.teacher-list {
  display: flex;
  white-space: nowrap;
}

.teacher-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  margin-right: 20rpx;
  width: 220rpx;
  white-space: normal;
  box-shadow: 0 2rpx 12rpx rgba(46,125,50,0.07);
}

.teacher-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.teacher-card__avatar-icon { font-size: 60rpx; }

.teacher-card__name {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
}

.teacher-card__title {
  font-size: 20rpx;
  color: #A1887F;
  text-align: center;
}

.teacher-card__tag {
  font-size: 20rpx;
  background: #E8F5E9;
  color: #2E7D32;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.teacher-card__meta {
  display: flex;
  gap: 10rpx;
}

.teacher-card__meta-item {
  font-size: 18rpx;
  color: #BCAAA4;
}

.teacher-card__follow-btn {
  background: #E8F5E9;
  border: 2rpx solid #A5D6A7;
  border-radius: 14rpx;
  padding: 8rpx 20rpx;
  width: 100%;
  text-align: center;
  margin-top: 4rpx;
}

.teacher-card__follow-btn.followed {
  background: #F5F5F5;
  border-color: #E0E0E0;
}

.teacher-card__follow-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #2E7D32;
}

.teacher-card__follow-btn.followed .teacher-card__follow-text {
  color: #BDBDBD;
}

/* ========== ⑥ 社区问答 ========== */
.comm-qa-ask-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FF9800, #E65100);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
}

.comm-qa-ask-btn__icon { font-size: 22rpx; }

.comm-qa-ask-btn__text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.qa-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.qa-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(46,125,50,0.05);
}

.qa-card__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.qa-card__avatar { font-size: 44rpx; flex-shrink: 0; }

.qa-card__user {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.qa-card__name {
  font-size: 26rpx;
  font-weight: bold;
  color: #4E342E;
}

.qa-card__time {
  font-size: 20rpx;
  color: #BCAAA4;
}

.qa-card__cat {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.qa-card__question {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.5;
  margin-bottom: 14rpx;
  display: block;
}

/* 精选回答 */
.qa-card__answer {
  background: #F1F8E9;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  border-left: 4rpx solid #2E7D32;
}

.qa-card__answer-label {
  font-size: 20rpx;
  color: #2E7D32;
  font-weight: bold;
  margin-bottom: 6rpx;
  display: block;
}

.qa-card__answer-content {
  font-size: 24rpx;
  color: #5D4037;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.qa-card__footer {
  display: flex;
  gap: 24rpx;
}

.qa-card__footer-item {
  font-size: 22rpx;
  color: #BCAAA4;
}

/* ========== ⑦ 直播预告 ========== */
.live-preview-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.live-preview-card {
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(46,125,50,0.06);
  position: relative;
}

/* 状态标识 */
.live-preview-status {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border-radius: 10rpx;
  padding: 4rpx 12rpx;
  z-index: 1;
}

.status-live {
  background: rgba(244,67,54,0.85);
}

.status-soon {
  background: rgba(255,152,0,0.85);
}

.live-preview-status__dot {
  display: block;
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 50%;
  animation: blink 1.2s ease-in-out infinite;
}

.live-preview-status__text {
  font-size: 18rpx;
  color: #fff;
  font-weight: bold;
}

/* 封面 */
.live-preview-cover {
  width: 140rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.live-preview-emoji { font-size: 56rpx; }

/* 信息 */
.live-preview-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.live-preview-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.live-preview-teacher {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.live-preview-teacher-avatar { font-size: 26rpx; }

.live-preview-teacher-name {
  font-size: 22rpx;
  color: #795548;
}

.live-preview-meta {
  display: flex;
  gap: 14rpx;
}

.live-preview-time,
.live-preview-subs {
  font-size: 20rpx;
  color: #BCAAA4;
}

/* 预约按钮 */
.live-preview-action-btn {
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.btn-enter {
  background: linear-gradient(135deg, #F44336, #B71C1C);
}

.btn-subscribe {
  background: linear-gradient(135deg, #43A047, #2E7D32);
}

.btn-subscribed {
  background: #F5F5F5;
  border: 2rpx solid #E0E0E0;
}

.live-preview-action-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
}

.btn-subscribed .live-preview-action-text { color: #BDBDBD; }

/* ========== 底部推荐语 ========== */
.comm-footer-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0 20rpx;
}

.comm-footer-tip__emoji { font-size: 28rpx; }

.comm-footer-tip__text {
  font-size: 22rpx;
  color: #A5D6A7;
}

/* ========== 搜索弹窗 ========== */
.search-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 500;
}

.search-modal__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
}

.search-modal__panel {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 0 0 32rpx 32rpx;
  padding: 20rpx 28rpx 32rpx;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

/* 输入框行 */
.search-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-top: 20rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F1F8E9;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.search-input-icon { font-size: 26rpx; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #3E2723;
}

.search-input-clear {
  font-size: 24rpx;
  color: #BDBDBD;
  padding: 4rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #2E7D32;
  flex-shrink: 0;
}

/* 搜索历史 */
.search-history {
  margin-bottom: 24rpx;
}

.search-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.search-history-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #795548;
}

.search-history-clear {
  font-size: 22rpx;
  color: #BCAAA4;
}

.search-history-tags,
.search-hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.search-history-tag {
  font-size: 24rpx;
  background: #F5F5F5;
  color: #795548;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
}

/* 热门搜索 */
.search-hot { margin-bottom: 24rpx; }

.search-hot-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #795548;
  display: block;
  margin-bottom: 14rpx;
}

.search-hot-tag {
  font-size: 24rpx;
  background: #E8F5E9;
  color: #2E7D32;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  font-weight: bold;
}

/* 搜索结果 */
.search-results {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.search-result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 12rpx;
  border-radius: 14rpx;
}

.search-result-item:active { background: #F1F8E9; }

.search-result-emoji { font-size: 40rpx; flex-shrink: 0; }

.search-result-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.search-result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
}

.search-result-meta {
  font-size: 20rpx;
  color: #BCAAA4;
}

.search-result-arrow {
  font-size: 36rpx;
  color: #D7CCC8;
}

/* 搜索空状态 */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 60rpx 0;
}

.search-empty__icon { font-size: 64rpx; }

.search-empty__text {
  font-size: 26rpx;
  font-weight: bold;
  color: #795548;
}

.search-empty__sub {
  font-size: 22rpx;
  color: #BCAAA4;
}
