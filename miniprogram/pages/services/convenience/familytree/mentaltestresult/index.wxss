/* pages/services/convenience/familytree/mentaltestresult/index.wxss */
/* ============================================================
  心理测试结果页样式
  评级色系：
    良好  绿  #2E7D32 / #E8F5E9
    轻度  蓝  #1565C0 / #E3F2FD
    中度  橙  #E65100 / #FFF3E0
    重度  红  #B71C1C / #FFEBEE
============================================================ */

page {
  background: #EDE7F6;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.result-page {
  min-height: 100vh;
  background: #EDE7F6;
  padding-bottom: 120rpx;
}

/* ========== 加载占位 ========== */
.page-loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.page-loading__icon {
  font-size: 80rpx;
  animation: bounce 1.2s ease-in-out infinite;
}

.page-loading__text {
  font-size: 26rpx;
  color: #9575CD;
}

@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-16rpx); }
}

/* ========== 顶部导航 ========== */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 110rpx;
}

.nav-back__icon { font-size: 28rpx; }

.nav-back__text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  flex: 1;
  text-align: center;
}

.nav-right {
  min-width: 110rpx;
  display: flex;
  justify-content: flex-end;
}

.nav-right__text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ========== ① 结果头图 ========== */
.result-hero {
  padding: 48rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.hero-deco1 {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
  top: -100rpx;
  right: -80rpx;
}

.hero-deco2 {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
  bottom: -60rpx;
  left: -50rpx;
}

/* 测试信息行 */
.hero-test-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.hero-test-emoji { font-size: 28rpx; }

.hero-test-name {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 评级徽章 */
.hero-level-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 28rpx;
}

.hero-level-emoji { font-size: 80rpx; }

.hero-level-label {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
}

/* 分数环 */
.hero-score-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.score-ring-outer {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255,255,255,0.3);
}

.score-ring-inner {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-ring-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
}

.score-ring-total {
  font-size: 26rpx;
  color: rgba(255,255,255,0.65);
}

.score-ring-caption {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

/* 完成信息 */
.hero-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 10rpx 28rpx;
}

.hero-meta-item {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}

.hero-meta-sep {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
}

/* ========== ⚠️ 危机干预卡 ========== */
.crisis-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  border: 3rpx solid #F44336;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(244,67,54,0.2);
}

.crisis-card__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.crisis-card__icon { font-size: 32rpx; }

.crisis-card__title {
  font-size: 28rpx;
  font-weight: bold;
  color: #B71C1C;
}

.crisis-card__desc {
  font-size: 24rpx;
  color: #5D4037;
  line-height: 1.7;
  margin-bottom: 20rpx;
  display: block;
}

.crisis-hotlines {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.crisis-hotline-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #FFEBEE;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}

.crisis-hotline-icon { font-size: 28rpx; }

.crisis-hotline-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.crisis-hotline-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #B71C1C;
}

.crisis-hotline-phone {
  font-size: 22rpx;
  color: #E53935;
  letter-spacing: 2rpx;
}

.crisis-hotline-call {
  font-size: 22rpx;
  color: #fff;
  background: #F44336;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

/* ========== ② 评分总览卡 ========== */
.overview-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(69,39,160,0.06);
}

.overview-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.overview-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4527A0;
}

.overview-level-tag {
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 总分进度条 */
.score-progress-wrap {
  margin-bottom: 24rpx;
}

.score-progress-labels {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.spl-left, .spl-right {
  font-size: 20rpx;
  color: #BDBDBD;
}

.spl-score {
  font-size: 26rpx;
  font-weight: bold;
  color: #4527A0;
}

.score-progress-bg {
  height: 20rpx;
  background: #F3E5F5;
  border-radius: 10rpx;
  overflow: visible;
  position: relative;
}

.score-progress-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.6s ease;
  position: relative;
}

.score-threshold {
  position: absolute;
  top: -4rpx;
  width: 3rpx;
  height: 28rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 2rpx;
}

.score-level-marks {
  position: relative;
  height: 36rpx;
  margin-top: 8rpx;
}

.score-level-mark {
  position: absolute;
  font-size: 18rpx;
  font-weight: bold;
  transform: translateX(-50%);
}

/* 等级描述框 */
.overview-desc-box {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: #FAFAFA;
  border-radius: 14rpx;
  padding: 20rpx;
  border-left: 6rpx solid;
}

.overview-desc-emoji { font-size: 32rpx; flex-shrink: 0; }

.overview-desc-text {
  font-size: 26rpx;
  color: #5C3A1E;
  line-height: 1.7;
}

/* ========== ③ 维度分析卡 ========== */
.dimension-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(69,39,160,0.06);
}

.dimension-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4527A0;
  margin-bottom: 28rpx;
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dimension-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dimension-item__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dimension-item__name {
  font-size: 26rpx;
  font-weight: bold;
  color: #3E2723;
}

.dimension-item__score {
  font-size: 26rpx;
  font-weight: bold;
}

.dimension-item__bar-bg {
  height: 16rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.dimension-item__bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.dimension-item__label {
  font-size: 20rpx;
  font-weight: bold;
  text-align: right;
}

/* ========== ④ 个性化建议 ========== */
.advice-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(69,39,160,0.06);
}

.advice-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4527A0;
  margin-bottom: 24rpx;
}

.advice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}

.advice-item--action   { background: #E8F5E9; }
.advice-item--info     { background: #E3F2FD; }
.advice-item--warning  { background: #FFF3E0; }
.advice-item--exercise { background: #F3E5F5; }

.advice-item__icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.advice-item__icon { font-size: 32rpx; }

.advice-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.advice-item__title {
  font-size: 26rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.4;
}

.advice-item__desc {
  font-size: 22rpx;
  color: #6D4C41;
  line-height: 1.6;
}

.advice-item__action {
  font-size: 22rpx;
  color: #4527A0;
  background: rgba(69,39,160,0.1);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
  align-self: center;
}

/* ========== ⑤ 推荐资源 ========== */
.resource-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(69,39,160,0.06);
}

.resource-card__header {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.resource-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4527A0;
}

.resource-card__sub {
  font-size: 22rpx;
  color: #B39DDB;
}

.resource-section-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #7C4DFF;
  margin-bottom: 16rpx;
}

/* 课程横滑列表 */
.resource-courses {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.resource-course-card {
  display: inline-flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 20rpx;
  width: 220rpx;
  white-space: normal;
}

.resource-course-cover {
  width: 220rpx;
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.resource-course-emoji { font-size: 56rpx; }

.resource-course-duration {
  position: absolute;
  bottom: 8rpx;
  right: 10rpx;
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(0,0,0,0.35);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.resource-course-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #3E2723;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.resource-course-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.resource-course-free {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.tag-free { background: #E8F5E9; color: #2E7D32; }
.tag-pay  { background: #FFF3E0; color: #E65100; }

.resource-course-plays {
  font-size: 18rpx;
  color: #BDBDBD;
}

/* 直播推荐卡 */
.resource-live-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #1A237E, #283593);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.resource-live-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.resource-live-emoji { font-size: 36rpx; flex-shrink: 0; }

.resource-live-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  line-height: 1.4;
}

.resource-live-meta {
  font-size: 20rpx;
  color: rgba(255,255,255,0.65);
  display: block;
  margin-top: 4rpx;
}

.resource-live-btn {
  font-size: 22rpx;
  color: #FFD54F;
  border: 2rpx solid rgba(255,213,79,0.5);
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

/* ========== ⑥ 家庭分享卡 ========== */
.share-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(69,39,160,0.06);
}

.share-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.share-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4527A0;
}

/* 分享预览 */
.share-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.share-preview__card {
  background: #F3E5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #E1BEE7;
}

.share-preview__top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.share-preview__icon { font-size: 44rpx; flex-shrink: 0; }

.share-preview__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.share-preview__name {
  font-size: 24rpx;
  font-weight: bold;
  color: #4527A0;
}

.share-preview__test {
  font-size: 20rpx;
  color: #9575CD;
}

.share-preview__level {
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.share-preview__desc {
  display: block;
  font-size: 24rpx;
  color: #5C3A1E;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.share-preview__time {
  font-size: 20rpx;
  color: #BDBDBD;
}

.share-preview__tip {
  font-size: 20rpx;
  color: #9575CD;
  text-align: center;
}

/* 留言输入框 */
.share-message-wrap {
  background: #FAFAFA;
  border-radius: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #E8E0F0;
}

.share-message-label {
  font-size: 22rpx;
  color: #9575CD;
  margin-bottom: 12rpx;
  display: block;
}

.share-message-input {
  width: 100%;
  font-size: 26rpx;
  color: #3E2723;
  min-height: 80rpx;
  line-height: 1.6;
}

/* 发布按钮 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #7C4DFF, #4527A0);
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(124,77,255,0.35);
}

.share-btn__icon { font-size: 28rpx; }

.share-btn__text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

/* ========== ⑦ 底部按钮 ========== */
.result-actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
}

.result-action-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EDE7F6;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 26rpx;
  color: #7C4DFF;
  font-weight: bold;
}

.result-action-primary {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #7C4DFF, #4527A0);
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(124,77,255,0.35);
}
