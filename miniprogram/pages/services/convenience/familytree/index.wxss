/* pages/services/convenience/familytree/index.wxss */

page {
  background: #F1F8E9;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.ftree-page {
  min-height: 100vh;
  background: #F1F8E9;
}

/* ========== Header ========== */
.ftree-header {
  background: linear-gradient(160deg, #1B5E20 0%, #2E7D32 60%, #388E3C 100%);
  padding: 32rpx 28rpx 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}

.ftree-header-deco1 {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
  top: -100rpx;
  right: -60rpx;
}

.ftree-header-deco2 {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
  bottom: -50rpx;
  left: -30rpx;
}

.ftree-header-top {
  margin-bottom: 28rpx;
}

.ftree-header-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.ftree-header-emoji { font-size: 48rpx; }

.ftree-header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.ftree-header-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  display: block;
}

/* 家庭成员 */
.ftree-members {
  display: flex;
  white-space: nowrap;
}

.ftree-member-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 28rpx;
  position: relative;
}

.ftree-member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255,255,255,0.25);
}

.ftree-member-avatar.has-new {
  border-color: #FFD54F;
  box-shadow: 0 0 0 4rpx rgba(255,213,79,0.3);
}

.ftree-member-icon { font-size: 50rpx; }

.ftree-member-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  white-space: nowrap;
}

.ftree-member-mood {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

/* ========== 通用 Section ========== */
.ftree-section {
  padding: 24rpx 24rpx 0;
}

.ftree-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ftree-section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ftree-section-dot {
  display: block;
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
}

.ftree-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
}

.ftree-section-sub {
  font-size: 22rpx;
  color: #2E7D32;
  font-weight: bold;
}

.ftree-section-more {
  font-size: 24rpx;
  color: #2E7D32;
}

/* ========== 心情打卡 ========== */
.ftree-mood-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(46,125,50,0.08);
}

.ftree-mood-question {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.ftree-mood-row {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.ftree-mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #F1F8E9;
  border: 2rpx solid transparent;
}

.ftree-mood-item--active {
  background: #E8F5E9;
  border-color: #2E7D32;
  transform: scale(1.05);
}

.ftree-mood-emoji { font-size: 44rpx; }

.ftree-mood-label {
  font-size: 20rpx;
  color: #795548;
}

.ftree-mood-item--active .ftree-mood-label {
  color: #2E7D32;
  font-weight: bold;
}

.ftree-mood-submit {
  background: linear-gradient(135deg, #43A047, #2E7D32);
  border-radius: 20rpx;
  padding: 22rpx 0;
  text-align: center;
}

.ftree-mood-submit--disabled {
  background: #E0E0E0;
}

.ftree-mood-submit-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.ftree-mood-submit--disabled .ftree-mood-submit-text {
  color: #9E9E9E;
}

/* ========== 功能宫格 ========== */
.ftree-func-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.ftree-func-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.ftree-func-item:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.ftree-func-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ftree-func-icon { font-size: 54rpx; }

.ftree-func-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #3E2723;
}

.ftree-func-desc {
  font-size: 22rpx;
  color: #A1887F;
}

/* ========== 家庭动态 ========== */
.ftree-dynamics {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ftree-dynamic-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(46,125,50,0.05);
}

.ftree-dynamic-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ftree-dynamic-avatar { font-size: 44rpx; flex-shrink: 0; }

.ftree-dynamic-user {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.ftree-dynamic-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #4E342E;
}

.ftree-dynamic-time {
  font-size: 20rpx;
  color: #BCAAA4;
}

.ftree-dynamic-type-tag {
  background: #E8F5E9;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.ftree-dynamic-type-text {
  font-size: 20rpx;
  color: #2E7D32;
  font-weight: bold;
}

.ftree-dynamic-content {
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.6;
}

/* 空状态 */
.ftree-dynamic-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 60rpx 0;
  background: #fff;
  border-radius: 20rpx;
}

.ftree-dynamic-empty-icon { font-size: 72rpx; }

.ftree-dynamic-empty-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #795548;
}

.ftree-dynamic-empty-sub {
  font-size: 22rpx;
  color: #BCAAA4;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.6;
}

/* ========== 直播预告 ========== */
.ftree-live-banner {
  background: linear-gradient(135deg, #1A1A2E, #16213E);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 24rpx rgba(26,26,46,0.25);
}

.ftree-live-banner:active { opacity: 0.9; }

.ftree-live-banner-left {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.ftree-live-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
}

.ftree-live-dot {
  display: block;
  width: 14rpx;
  height: 14rpx;
  background: #F44336;
  border-radius: 50%;
  animation: blink 1.2s ease-in-out infinite;
}

@keyframes blink {
  0%,100% { opacity: 1; }
  50%      { opacity: 0.2; }
}

.ftree-live-tag-text {
  font-size: 20rpx;
  color: #F44336;
  font-weight: bold;
}

.ftree-live-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.4;
}

.ftree-live-teacher {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.ftree-live-banner-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-left: 20rpx;
}

.ftree-live-emoji { font-size: 56rpx; }

.ftree-live-enter-btn {
  background: #F44336;
  border-radius: 16rpx;
  padding: 10rpx 24rpx;
}

.ftree-live-enter-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}
