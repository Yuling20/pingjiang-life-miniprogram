<!-- pages/services/convenience/familytree/mentaltest/index.wxml -->
<!-- ============================================================
  心理测试页
  包含：
    1. 测试封面介绍页（未开始状态）
    2. 答题进行页（逐题展示）
    3. 提交确认 → 跳转结果页
  状态流转：
    'intro' → 'testing' → (提交) → 跳转 result 页
============================================================ -->

<!-- 加载占位 -->
<view class="page-loading" wx:if="{{!pageReady}}">
  <text class="page-loading__icon">🧠</text>
  <text class="page-loading__text">准备题目中...</text>
</view>

<view class="test-page" wx:if="{{pageReady}}">

  <!-- ====================================================
    顶部导航栏（通用）
  ==================================================== -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onNavBack">
      <text class="nav-back__arrow">‹</text>
      <text class="nav-back__text">返回</text>
    </view>
    <text class="nav-title">{{testInfo.title}}</text>
    <!-- 答题中显示题目计数 -->
    <text class="nav-count" wx:if="{{phase === 'testing'}}">
      {{currentIndex + 1}}/{{questions.length}}
    </text>
    <view class="nav-placeholder" wx:else></view>
  </view>

  <!-- ====================================================
    ① INTRO 封面介绍页
  ==================================================== -->
  <view class="intro-page" wx:if="{{phase === 'intro'}}">

    <!-- 封面卡片 -->
    <view class="intro-cover">
      <!-- 背景装饰 -->
      <view class="intro-cover__deco1"></view>
      <view class="intro-cover__deco2"></view>

      <text class="intro-cover__emoji">{{testInfo.emoji}}</text>
      <text class="intro-cover__title">{{testInfo.title}}</text>
      <text class="intro-cover__scale">{{testInfo.scaleName}}</text>

      <!-- 测试信息标签 -->
      <view class="intro-tags">
        <view class="intro-tag">
          <text class="intro-tag__icon">⏱</text>
          <text class="intro-tag__text">约 {{testInfo.minutes}} 分钟</text>
        </view>
        <view class="intro-tag">
          <text class="intro-tag__icon">📝</text>
          <text class="intro-tag__text">{{questions.length}} 道题</text>
        </view>
        <view class="intro-tag">
          <text class="intro-tag__icon">🔒</text>
          <text class="intro-tag__text">结果保密</text>
        </view>
        <view class="intro-tag intro-tag--free" wx:if="{{testInfo.free}}">
          <text class="intro-tag__icon">✅</text>
          <text class="intro-tag__text">完全免费</text>
        </view>
      </view>
    </view>

    <!-- 测试说明 -->
    <view class="intro-desc-card">
      <view class="intro-desc-title">📋 测试说明</view>
      <view class="intro-desc-list">
        <view class="intro-desc-item" wx:for="{{testInfo.introList}}" wx:key="*this">
          <text class="intro-desc-dot">·</text>
          <text class="intro-desc-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 适用对象 -->
    <view class="intro-audience-card">
      <view class="intro-audience-title">👥 适用对象</view>
      <text class="intro-audience-text">{{testInfo.audience}}</text>
    </view>

    <!-- 温馨提示 -->
    <view class="intro-notice">
      <text class="intro-notice__icon">💡</text>
      <text class="intro-notice__text">
        本测试仅供参考，不构成医学诊断。若您有严重困扰，建议寻求专业心理咨询师帮助。
      </text>
    </view>

    <!-- 开始按钮 -->
    <view class="intro-btn-area">
      <view class="intro-start-btn" bindtap="onStartTest">
        <text class="intro-start-btn__icon">▶</text>
        <text class="intro-start-btn__text">开始测试</text>
      </view>
      <view class="intro-back-btn" bindtap="onNavBack">暂不测试，稍后再来</view>
    </view>

  </view>

  <!-- ====================================================
    ② TESTING 答题进行页
  ==================================================== -->
  <view class="testing-page" wx:if="{{phase === 'testing'}}">

    <!-- 进度条 -->
    <view class="progress-wrap">
      <view class="progress-bg">
        <view
          class="progress-fill"
          style="width: {{progressPercent}}%;"
        ></view>
      </view>
      <text class="progress-label">{{progressPercent}}%</text>
    </view>

    <!-- 题目卡片 -->
    <view class="question-card">

      <!-- 题号标签 -->
      <view class="question-number-row">
        <view class="question-number-tag">第 {{currentIndex + 1}} 题</view>
        <text class="question-category">{{currentQ.category}}</text>
      </view>

      <!-- 题目文字 -->
      <text class="question-text">{{currentQ.text}}</text>

      <!-- 儿童版辅助说明（字体更大，emoji辅助） -->
      <view class="question-child-hint" wx:if="{{isChildMode && currentQ.childHint}}">
        <text class="question-child-hint__icon">💬</text>
        <text class="question-child-hint__text">{{currentQ.childHint}}</text>
      </view>

      <!-- ── 选项区域 ── -->

      <!-- 表情卡片型选项（儿童版 / left-behind 测试） -->
      <view class="options-emoji" wx:if="{{currentQ.optionType === 'emoji'}}">
        <view
          wx:for="{{currentQ.options}}"
          wx:key="value"
          class="option-emoji-card {{answers[currentIndex] === item.value ? 'option-emoji-card--selected' : ''}}"
          bindtap="onSelectOption"
          data-value="{{item.value}}"
          data-index="{{currentIndex}}"
        >
          <text class="option-emoji-card__face">{{item.emoji}}</text>
          <text class="option-emoji-card__label">{{item.label}}</text>
          <!-- 选中对勾 -->
          <view class="option-check" wx:if="{{answers[currentIndex] === item.value}}">✓</view>
        </view>
      </view>

      <!-- 标准文字型选项（成人版量表） -->
      <view class="options-text" wx:elif="{{currentQ.optionType === 'text'}}">
        <view
          wx:for="{{currentQ.options}}"
          wx:key="value"
          class="option-text-item {{answers[currentIndex] === item.value ? 'option-text-item--selected' : ''}}"
          bindtap="onSelectOption"
          data-value="{{item.value}}"
          data-index="{{currentIndex}}"
        >
          <!-- 选择圆圈 -->
          <view class="option-radio {{answers[currentIndex] === item.value ? 'option-radio--selected' : ''}}">
            <view class="option-radio__dot" wx:if="{{answers[currentIndex] === item.value}}"></view>
          </view>
          <text class="option-text-item__label">{{item.label}}</text>
          <!-- 频率描述（SAS/PHQ9等量表用） -->
          <text class="option-text-item__freq" wx:if="{{item.freq}}">{{item.freq}}</text>
        </view>
      </view>

      <!-- 图片+文字型选项（老年视觉辅助版） -->
      <view class="options-image" wx:elif="{{currentQ.optionType === 'image'}}">
        <view
          wx:for="{{currentQ.options}}"
          wx:key="value"
          class="option-image-card {{answers[currentIndex] === item.value ? 'option-image-card--selected' : ''}}"
          bindtap="onSelectOption"
          data-value="{{item.value}}"
          data-index="{{currentIndex}}"
        >
          <text class="option-image-card__emoji">{{item.emoji}}</text>
          <text class="option-image-card__label">{{item.label}}</text>
          <text class="option-image-card__desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
      </view>

    </view>

    <!-- 已选提示 -->
    <view class="selected-tip" wx:if="{{answers[currentIndex] !== undefined && answers[currentIndex] !== null}}">
      <text class="selected-tip__check">✅</text>
      <text class="selected-tip__text">已选择，可点击下一题</text>
    </view>
    <view class="selected-tip selected-tip--empty" wx:else>
      <text class="selected-tip__text">请选择最符合您实际情况的选项</text>
    </view>

    <!-- 底部操作栏：上一题 / 下一题 -->
    <view class="question-actions">
      <!-- 上一题 -->
      <view
        class="btn-prev {{currentIndex === 0 ? 'btn-prev--disabled' : ''}}"
        bindtap="onPrevQuestion"
      >
        ‹ 上一题
      </view>

      <!-- 进度点阵 -->
      <view class="progress-dots">
        <view
          wx:for="{{dotList}}"
          wx:key="index"
          class="progress-dot
            {{item.answered ? 'dot-answered' : ''}}
            {{item.current  ? 'dot-current'  : ''}}"
        ></view>
      </view>

      <!-- 下一题 / 提交 -->
      <view
        class="btn-next {{answers[currentIndex] === undefined || answers[currentIndex] === null ? 'btn-next--disabled' : ''}}"
        bindtap="onNextQuestion"
      >
        {{currentIndex === questions.length - 1 ? '提交 ›' : '下一题 ›'}}
      </view>
    </view>

    <!-- 跳过提示（可选）-->
    <view class="skip-tip" bindtap="onSkipQuestion">
      跳过此题（不计分）
    </view>

  </view>

  <!-- ====================================================
    ③ SUBMITTING 提交中动画
  ==================================================== -->
  <view class="submitting-page" wx:if="{{phase === 'submitting'}}">
    <view class="submitting-anim">
      <text class="submitting-emoji">🧠</text>
      <view class="submitting-ring"></view>
    </view>
    <text class="submitting-title">正在分析您的测试结果</text>
    <text class="submitting-sub">AI 正在处理 {{questions.length}} 道题目...</text>
    <view class="submitting-steps">
      <view class="submitting-step {{submitStep >= 1 ? 'step-done' : ''}}">
        <text class="step-dot">{{submitStep >= 1 ? '✓' : '○'}}</text>
        <text class="step-text">收集作答数据</text>
      </view>
      <view class="submitting-step {{submitStep >= 2 ? 'step-done' : ''}}">
        <text class="step-dot">{{submitStep >= 2 ? '✓' : '○'}}</text>
        <text class="step-text">量表评分计算</text>
      </view>
      <view class="submitting-step {{submitStep >= 3 ? 'step-done' : ''}}">
        <text class="step-dot">{{submitStep >= 3 ? '✓' : '○'}}</text>
        <text class="step-text">生成个性化建议</text>
      </view>
    </view>
  </view>

</view>
