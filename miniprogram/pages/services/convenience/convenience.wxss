/* pages/services/convenience/convenience.wxss */

.page-container {
  background-color: #fdf6e3;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.page-header {
  background: linear-gradient(135deg, #8B6914, #c8a951);
  padding: 40rpx 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(139,105,20,0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5a3e10;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5e6c0;
}

/* 找工作 */
.job-list { display: flex; flex-direction: column; gap: 20rpx; }
.job-item {
  background: #fffdf5;
  border: 1rpx solid #f0dfa0;
  border-radius: 16rpx;
  padding: 20rpx;
}
.job-top { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.job-name { font-size: 30rpx; font-weight: bold; color: #333; }
.job-salary { font-size: 28rpx; color: #e07000; font-weight: bold; }
.job-company { font-size: 26rpx; color: #666; margin-bottom: 8rpx; display: block; }
.job-tags { font-size: 22rpx; color: #999; }

/* 房屋 */
.house-list { display: flex; flex-direction: column; gap: 20rpx; }
.house-item {
  background: #fffdf5;
  border: 1rpx solid #f0dfa0;
  border-radius: 16rpx;
  padding: 20rpx;
}
.house-top { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.house-title { font-size: 30rpx; font-weight: bold; color: #333; }
.house-price { font-size: 28rpx; color: #e07000; font-weight: bold; }
.house-desc { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.house-contact { font-size: 24rpx; color: #8B6914; }

/* 停水停电 */
.notice-list { display: flex; flex-direction: column; gap: 20rpx; }
.notice-item {
  display: flex;
  gap: 16rpx;
  background: #fffdf5;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #f0dfa0;
}
.notice-badge {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  height: fit-content;
  flex-shrink: 0;
}
.notice-badge.water { background: #d0eaff; color: #0066cc; }
.notice-badge.electric { background: #fff0d0; color: #cc6600; }
.notice-info { display: flex; flex-direction: column; gap: 8rpx; }
.notice-title { font-size: 28rpx; color: #333; font-weight: bold; }
.notice-time, .notice-area { font-size: 24rpx; color: #666; }

/* 医院 */
.hospital-list { display: flex; flex-direction: column; gap: 20rpx; }
.hospital-item {
  background: #fffdf5;
  border: 1rpx solid #f0dfa0;
  border-radius: 16rpx;
  padding: 20rpx;
}
.hospital-name { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-bottom: 10rpx; }
.hospital-address { font-size: 26rpx; color: #666; display: block; margin-bottom: 16rpx; }

/* 办事 */
.gov-list { display: flex; flex-direction: column; gap: 20rpx; }
.gov-item {
  background: #fffdf5;
  border: 1rpx solid #f0dfa0;
  border-radius: 16rpx;
  padding: 20rpx;
}
.gov-name { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-bottom: 8rpx; }
.gov-desc { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.gov-addr { font-size: 24rpx; color: #999; }

/* 家政维修 */
.repair-list { display: flex; flex-direction: column; gap: 20rpx; }
.repair-item {
  background: #fffdf5;
  border: 1rpx solid #f0dfa0;
  border-radius: 16rpx;
  padding: 20rpx;
}
.repair-top { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.repair-name { font-size: 30rpx; font-weight: bold; color: #333; }
.repair-score { font-size: 26rpx; color: #e07000; }
.repair-skill { font-size: 26rpx; color: #666; display: block; margin-bottom: 16rpx; }

/* 拨号按钮 */
.btn-call {
  background: linear-gradient(135deg, #8B6914, #c8a951);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 50rpx;
  text-align: center;
  margin-top: 10rpx;
}

/* 即将上线 */
.coming-soon {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.coming-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.coming-text { font-size: 32rpx; color: #5a3e10; font-weight: bold; }
.coming-sub { font-size: 26rpx; color: #999; margin-top: 10rpx; }
