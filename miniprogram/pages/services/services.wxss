/* pages/services/convenience/services.wxss */

.page-container {
  min-height: 100vh;
  background-color: #F5F0E8;
  padding-bottom: 120rpx;
}

/* ★ 顶部标题：去掉大黄色，改为暖棕渐变卡片样式 ★ */
.page-header {
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #5C3D1E 0%, #8B5E3C 100%);
}

.header-inner {
  padding: 40rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.80);
  margin-top: 10rpx;
}

/* 功能宫格 - 每行2个（原样保留） */
.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  padding: 24rpx 24rpx;
}

/* 每个入口（原样保留） */
.service-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  min-height: 260rpx;
}

/* 图标圆圈（原样保留） */
.service-icon-wrap {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.service-icon { font-size: 68rpx; }

/* 各颜色背景（原样保留） */
.blue         { background-color: #e6f0ff; }
.orange       { background-color: #fff3e6; }
.yellow       { background-color: #fffbe6; }
.red          { background-color: #ffe6e6; }
.green        { background-color: #e6f7ee; }
.gray         { background-color: #f0f0f0; }
.gold         { background-color: #fff8e1; }

/* 入口名称（原样保留） */
.service-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

/* 入口描述（原样保留） */
.service-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
}

/* 即将上线标签（原样保留） */
.coming-soon-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #ff4d4f;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.coming-soon-tag text {
  font-size: 20rpx;
  color: #ffffff;
}

/* 底部说明（原样保留） */
.page-footer {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.footer-text { font-size: 28rpx; color: #bbbbbb; }
/* ========== 家庭心树入口卡片 ========== */
.service-family-tree-card {
  margin: 20rpx 24rpx;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #388E3C 100%);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(46,125,50,0.30);
  position: relative;
  overflow: hidden;
}

.service-family-tree-card:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* 背景装饰圆 */
.ftree-card-deco1 {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
  top: -60rpx;
  right: 80rpx;
}

.ftree-card-deco2 {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
  bottom: -30rpx;
  left: 20rpx;
}

/* 左侧内容 */
.ftree-card-left {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.ftree-card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ftree-card-emoji {
  font-size: 36rpx;
}

.ftree-card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.ftree-card-new-tag {
  background: #FF9800;
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
}

.ftree-card-new-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: bold;
}

.ftree-card-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

/* 功能标签 */
.ftree-card-features {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.ftree-card-feature {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 14rpx;
  padding: 6rpx 14rpx;
}

.ftree-card-feature-icon {
  font-size: 20rpx;
}

.ftree-card-feature-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
}

/* 右侧 */
.ftree-card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.ftree-card-main-emoji {
  font-size: 72rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.ftree-card-arrow {
  font-size: 40rpx;
  color: rgba(255,255,255,0.5);
}
