/* pages/services/services.wxss */
.page-container {
  min-height: 100vh;
  background-color: #fdf6ec;
  padding-bottom: 120rpx;
}

/* 顶部标题 */
.page-header {
  background: linear-gradient(135deg, #e8a020, #f5c842);
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.page-subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

/* 功能宫格 - 每行2个 */
.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  padding: 40rpx 30rpx;
}

/* 每个入口 */
.service-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  min-height: 260rpx;
}

/* 图标圆圈 - 更大 */
.service-icon-wrap {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 图标更大 */
.service-icon { font-size: 68rpx; }

/* 各颜色背景 */
.blue         { background-color: #e6f0ff; }
.orange       { background-color: #fff3e6; }
.yellow       { background-color: #fffbe6; }
.red          { background-color: #ffe6e6; }
.green        { background-color: #e6f7ee; }
.gray         { background-color: #f0f0f0; }
.gold   { background-color: #fff8e1; }

/* 入口名称 - 更大 */
.service-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

/* 入口描述 - 更大 */
.service-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
}

/* 即将上线标签 */
.coming-soon-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #ff4d4f;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.coming-soon-tag text {
  font-size: 20rpx;
  color: #ffffff;
}

/* 底部说明 */
.page-footer {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.footer-text { font-size: 28rpx; color: #bbbbbb; }