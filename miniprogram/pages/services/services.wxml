<!-- pages/services/convenience/services.wxml -->
<view class="page-container">

<!-- 顶部标题栏：去掉大黄色，改为暖棕卡片 -->
<view class="page-header">
  <view class="header-inner">
    <text class="page-title">便民服务</text>
    <text class="page-subtitle">平江本地生活服务平台</text>
  </view>
</view>

<!-- 6个功能入口（原有全部保留） -->
<view class="service-grid">

  <!-- 入口1：找工作 -->
  <view class="service-item" bindtap="goToJobs">
    <view class="service-icon-wrap blue">
      <text class="service-icon">💼</text>
    </view>
    <text class="service-name">找工作</text>
    <text class="service-desc">本地招聘信息</text>
  </view>

  <!-- 入口2：房屋租赁 -->
  <view class="service-item" bindtap="goToRent">
    <view class="service-icon-wrap orange">
      <text class="service-icon">🏠</text>
    </view>
    <text class="service-name">房屋租赁</text>
    <text class="service-desc">周边房源查询</text>
  </view>

  <!-- 入口3：家政维修 -->
  <view class="service-item" bindtap="goToHomeService">
    <view class="service-icon-wrap yellow">
      <text class="service-icon">🔧</text>
    </view>
    <text class="service-name">家政维修</text>
    <text class="service-desc">专业上门服务</text>
  </view>

  <!-- 入口4：停水停电 -->
  <view class="service-item" bindtap="goToNotice">
    <view class="service-icon-wrap red">
      <text class="service-icon">🚨</text>
    </view>
    <text class="service-name">停水停电</text>
    <text class="service-desc">官方通知查询</text>
  </view>

  <!-- 入口5：办事指南 -->
  <view class="service-item" bindtap="goToGuide">
    <view class="service-icon-wrap green">
      <text class="service-icon">📋</text>
    </view>
    <text class="service-name">办事指南</text>
    <text class="service-desc">政务服务入口</text>
  </view>

</view>

<!-- ====================================================
  家庭心树 · 入口卡片（替换原 elder 孝亲守护入口）
==================================================== -->
<view
  class="service-family-tree-card"
  bindtap="onGoFamilyTree"
>
  <!-- 背景装饰 -->
  <view class="ftree-card-deco1"></view>
  <view class="ftree-card-deco2"></view>

  <!-- 左侧内容 -->
  <view class="ftree-card-left">
    <view class="ftree-card-title-row">
      <text class="ftree-card-emoji">🌳</text>
      <text class="ftree-card-title">家庭心树</text>
      <view class="ftree-card-new-tag">
        <text class="ftree-card-new-text">NEW</text>
      </view>
    </view>
    <text class="ftree-card-desc">家庭关怀 · 心理健康 · 社区课堂</text>
    <view class="ftree-card-features">
      <view class="ftree-card-feature">
        <text class="ftree-card-feature-icon">❤️</text>
        <text class="ftree-card-feature-text">心情打卡</text>
      </view>
      <view class="ftree-card-feature">
        <text class="ftree-card-feature-icon">🧠</text>
        <text class="ftree-card-feature-text">心理测试</text>
      </view>
      <view class="ftree-card-feature">
        <text class="ftree-card-feature-icon">📚</text>
        <text class="ftree-card-feature-text">社区课堂</text>
      </view>
      <view class="ftree-card-feature">
        <text class="ftree-card-feature-icon">🔴</text>
        <text class="ftree-card-feature-text">直播课</text>
      </view>
    </view>
  </view>

  <!-- 右侧图标 -->
  <view class="ftree-card-right">
    <text class="ftree-card-main-emoji">🌳</text>
    <text class="ftree-card-arrow">›</text>
  </view>
</view>

<!-- 底部说明 -->
<view class="page-footer">
  <text class="footer-text">更多服务陆续上线 · 欢迎反馈建议</text>
</view>

</view>