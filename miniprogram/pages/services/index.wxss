/* pages/services/index.wxss */

.page-container {
  background-color: #fdf6e3;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.page-header {
  background: linear-gradient(135deg, #8B6914, #c8a951);
  padding: 40rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 搜索栏 */
.search-bar {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(139,105,20,0.1);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

/* 分区 */
.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(139,105,20,0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5a3e10;
  margin-bottom: 24rpx;
}

/* 九宫格 */
.grid-container {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.grid-icon {
  font-size: 52rpx;
  margin-bottom: 10rpx;
}

.grid-text {
  font-size: 24rpx;
  color: #5a3e10;
  text-align: center;
}

/* 公告 */
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.notice-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #c8a951;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.notice-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.notice-date {
  font-size: 22rpx;
  color: #999;
}
