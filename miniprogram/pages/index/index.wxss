/* pages/home/index.wxss */

/* 搜索栏 */
.search-bar {
  background: #E85D26;
  padding: 20rpx 30rpx;
}
.search-inner {
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-text { font-size: 28rpx; color: #999; }

/* 横幅公告 */
.banner-wrap {
  background: #FFF3EE;
  padding: 20rpx 30rpx;
  border-bottom: 2rpx solid #FFD4BC;
}
.banner-text { font-size: 26rpx; color: #E85D26; }

/* 快捷入口 */
.quick-section {
  display: flex;
  background: #fff;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 88rpx;
}
.quick-icon { font-size: 48rpx; margin-bottom: 10rpx; }
.quick-name { font-size: 24rpx; color: #333; font-weight: bold; }

/* 通用区块 */
.section-wrap {
  background: #fff;
  margin: 0 0 20rpx 0;
  padding: 30rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.section-title-wrap {
  display: flex;
  align-items: center;
}
.section-line {
  width: 8rpx;
  height: 36rpx;
  background: #E85D26;
  border-radius: 4rpx;
  margin-right: 16rpx;
}
.section-title { font-size: 36rpx; font-weight: bold; color: #333; }
.view-all { font-size: 26rpx; color: #E85D26; }

/* 便民服务宫格 */
.service-grid {
  display: flex;
  flex-wrap: wrap;
}
.service-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  min-height: 88rpx;
}
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: #FFF3EE;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.service-icon { font-size: 44rpx; }
.service-name { font-size: 28rpx; color: #333; }

/* 文章列表 */
.article-list { }
.article-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
  min-height: 88rpx;
}
.article-content { flex: 1; }
.article-title { font-size: 30rpx; color: #333; display: block; margin-bottom: 8rpx; }
.article-desc { font-size: 24rpx; color: #999; }
.article-time { font-size: 24rpx; color: #999; margin-left: 20rpx; }
