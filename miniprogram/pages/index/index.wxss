/* index.wxss 平江汇生活首页样式 */

page {
  background-color: #f5f5f5;
  font-size: 32rpx;
}

.container {
  padding-bottom: 120rpx;
}

/* 顶部问候栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  background-color: #1677ff;
}

.greeting {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
}

.date {
  font-size: 26rpx;
  color: #cce0ff;
  display: block;
  margin-top: 6rpx;
}

.weather {
  font-size: 30rpx;
  color: #ffffff;
}

/* 轮播图 */
.banner {
  width: 100%;
  height: 280rpx;
}

.banner-item {
  width: 100%;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-1 { background: linear-gradient(135deg, #1677ff, #0099cc); }
.banner-2 { background: linear-gradient(135deg, #07c160, #0aab4a); }
.banner-3 { background: linear-gradient(135deg, #ff9900, #ff7700); }

.banner-text {
  font-size: 38rpx;
  color: #ffffff;
  font-weight: bold;
  text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
}

/* 分区标题 */
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  padding: 30rpx 30rpx 16rpx;
  border-left: 8rpx solid #1677ff;
  margin-left: 20rpx;
}

/* 功能九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  background: #ffffff;
  margin: 0 20rpx;
  border-radius: 16rpx;
}

.grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.grid-item:nth-child(n+4) {
  border-bottom: none;
}

.grid-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.grid-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

/* 公告列表 */
.notice-list {
  background: #ffffff;
  margin: 0 20rpx;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-dot {
  color: #1677ff;
  font-size: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
}

.notice-date {
  font-size: 24rpx;
  color: #999999;
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* 底部导航 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  border-top: 1rpx solid #e8e8e8;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 48rpx;
}

.tab-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tab-item.active .tab-label {
  color: #1677ff;
}
