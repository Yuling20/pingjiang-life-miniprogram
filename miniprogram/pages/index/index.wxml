<!-- pages/home/index.wxml -->
<scroll-view scroll-y style="height:100vh;background:#F5F5F5;">

<!-- 顶部搜索栏 -->
<view class="search-bar">
  <view class="search-inner">
    <text class="search-icon">🔍</text>
    <text class="search-text">搜索服务/商品/信息</text>
  </view>
</view>

<!-- 横幅公告 -->
<view class="banner-wrap">
  <view class="banner-item" wx:for="{{bannerList}}" wx:key="id">
    <text class="banner-text">📢 {{item.text}}</text>
  </view>
</view>

<!-- 快捷入口（4个） -->
<view class="quick-section">
  <view 
    class="quick-item" 
    wx:for="{{quickLinks}}" 
    wx:key="id"
    data-path="{{item.path}}"
    bindtap="onQuickTap"
  >
    <text class="quick-icon">{{item.icon}}</text>
    <text class="quick-name">{{item.name}}</text>
  </view>
</view>

<!-- 便民服务模块 -->
<view class="section-wrap">
  <view class="section-header">
    <view class="section-title-wrap">
      <view class="section-line"></view>
      <text class="section-title">便民服务</text>
    </view>
    <text class="view-all" bindtap="onViewAll">查看全部 ›</text>
  </view>

  <!-- ✅ 关键：bindtap绑定onServiceTap，data-path传路径 -->
  <view class="service-grid">
    <view 
      class="service-item"
      wx:for="{{serviceList}}"
      wx:key="id"
      data-path="{{item.path}}"
      bindtap="onServiceTap"
    >
      <view class="service-icon-wrap">
        <text class="service-icon">{{item.icon}}</text>
      </view>
      <text class="service-name">{{item.name}}</text>
    </view>
  </view>
</view>

<!-- 平江贴吧模块 -->
<view class="section-wrap">
  <view class="section-header">
    <view class="section-title-wrap">
      <view class="section-line"></view>
      <text class="section-title">平江贴吧</text>
    </view>
  </view>
  <view class="article-list">
    <view 
      class="article-item"
      wx:for="{{articleList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onArticleTap"
    >
      <view class="article-content">
        <text class="article-title">{{item.title}}</text>
        <text class="article-desc">{{item.desc}}</text>
      </view>
      <text class="article-time">{{item.time}}</text>
    </view>
  </view>
</view>

<view style="height:80rpx;"></view>
</scroll-view>
