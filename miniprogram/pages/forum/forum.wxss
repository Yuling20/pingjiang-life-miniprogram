/* pages/forum/forum.wxss */

.forum-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f7f7;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left .logo-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FF6B35;
}

.tab-bar {
  display: flex;
  flex: 1;
  justify-content: center;
  gap: 50rpx;
}

.tab-item {
  font-size: 30rpx;
  color: #666;
  font-weight: 400;
  padding-bottom: 10rpx;
  position: relative;
}

.tab-active {
  color: #1a1a1a;
  font-weight: 700;
  font-size: 32rpx;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
}

.header-right .search-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  font-size: 36rpx;
}

/* 帖子列表 */
.post-list {
  flex: 1;
  overflow-y: auto;
}

/* 帖子卡片 */
.post-card {
  display: flex;
  padding: 24rpx 24rpx 0;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 左侧头像列 */
.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 80rpx;
}

.avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.avatar-line {
  width: 2rpx;
  flex: 1;
  background: #e8e8e8;
  margin-top: 10rpx;
  min-height: 30rpx;
}

/* 右侧内容列 */
.post-content-col {
  flex: 1;
  min-width: 0;
  padding-bottom: 20rpx;
}

.user-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.user-names {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.handle {
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.post-time-tag {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.tag-badge {
  font-size: 20rpx;
  color: #FF6B35;
  background: #FFF0EA;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}

/* 图片网格 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 16rpx;
}

.img-single {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.img-grid {
  width: calc(50% - 3rpx);
  height: 200rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx 10rpx 0;
}

.action-icon {
  font-size: 32rpx;
}

.action-count {
  font-size: 24rpx;
  color: #999;
}

.liked-text {
  color: #e0245e;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #aaa;
}

/* 底部提示 */
.list-bottom {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 发帖按钮 FAB */
.publish-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FF6B35;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.4);
  z-index: 999;
}

.fab-icon {
  font-size: 40rpx;
}
