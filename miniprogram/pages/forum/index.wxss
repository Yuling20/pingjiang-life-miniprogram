/* pages/forum/publish/index.wxss */
page {
  background: #ffffff;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #ffffff;
}

/* ========== 顶部导航 ========== */
.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #1a1a1a;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.publish-btn {
  padding: 14rpx 32rpx;
  background: #e8e8e8;
  border-radius: 40rpx;
}

.publish-btn-active {
  background: #ff6b35;
}

.publish-btn-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

/* ========== 用户行 ========== */
.user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 30rpx 0 30rpx;
  gap: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.visibility-selector {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  width: fit-content;
}

.visibility-text {
  font-size: 24rpx;
  color: #555555;
}

.visibility-arrow {
  font-size: 20rpx;
  color: #888888;
}

/* ========== 内容输入区 ========== */
.content-area {
  padding: 20rpx 30rpx 20rpx 130rpx;
  flex: 1;
}

.content-input {
  width: 100%;
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 1.7;
  min-height: 200rpx;
}

.content-placeholder {
  color: #cccccc;
  font-size: 32rpx;
}

/* 图片预览 */
.image-preview {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.img-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-delete-icon {
  font-size: 24rpx;
  color: #ffffff;
}

.img-add-more {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-add-icon {
  font-size: 60rpx;
  color: #cccccc;
}

/* 字数统计 */
.char-count-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 30rpx;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.char-bar {
  flex: 1;
  height: 4rpx;
  background: #f0f0f0;
  border-radius: 2rpx;
  overflow: hidden;
}

.char-progress {
  height: 100%;
  background: #ff6b35;
  border-radius: 2rpx;
}

.char-count {
  font-size: 24rpx;
  color: #aaaaaa;
  min-width: 60rpx;
  text-align: right;
}

.char-warn {
  color: #e53935;
}

/* ========== 工具栏 ========== */
.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  gap: 32rpx;
}

.tool-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.tool-icon {
  font-size: 36rpx;
}

.tool-text {
  font-size: 26rpx;
  color: #666666;
}

/* ========== 标签选择器 ========== */
.tag-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 200;
}

.tag-picker-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.tag-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
}

.tag-chip-selected {
  background: #fff3ee;
  border-color: #ff6b35;
}

.tag-chip text {
  font-size: 28rpx;
  color: #555555;
}

.tag-chip-selected text {
  color: #ff6b35;
  font-weight: bold;
}
