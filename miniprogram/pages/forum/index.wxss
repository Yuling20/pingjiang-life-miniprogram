/* pages/forum/index.wxss */
page { background: #f5f5f5; }

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs {
  display: flex;
  gap: 60rpx;
}

.tab {
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
}

.tab-active {
  color: #333;
  font-weight: bold;
  font-size: 32rpx;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #1890ff;
  border-radius: 3rpx;
}

.icon-btn {
  width: 44rpx;
  height: 44rpx;
}

/* 帖子列表 */
.feed-list { flex: 1; }

.post-card {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 30rpx;
}

/* 帖子头部 */
.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.post-author-info { flex: 1; }

.post-nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.post-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.post-location, .post-time {
  font-size: 22rpx;
  color: #999;
}

.follow-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid #1890ff;
  border-radius: 30rpx;
  color: #1890ff;
  font-size: 24rpx;
}

/* 帖子内容 */
.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  display: block;
  margin-bottom: 16rpx;
}

/* 标签 */
.post-tags { margin-bottom: 16rpx; }

.post-tag {
  color: #1890ff;
  font-size: 24rpx;
  margin-right: 16rpx;
}

/* 图片 */
.post-images {
  margin-bottom: 20rpx;
  display: grid;
  gap: 6rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.single-img { grid-template-columns: 1fr; }
.double-img { grid-template-columns: 1fr 1fr; }
.grid-img { grid-template-columns: 1fr 1fr 1fr; }

.post-image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8rpx;
}

.single-img .post-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

/* 操作栏 */
.post-actions {
  display: flex;
  justify-content: flex-end;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon { font-size: 32rpx; }
.action-count, .action-text { font-size: 26rpx; color: #999; }
.liked-count { color: #ff4d4f; }

/* 发布悬浮按钮 */
.publish-fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24,144,255,0.4);
  z-index: 100;
}

.publish-fab-icon { font-size: 36rpx; }
.publish-fab-text { font-size: 20rpx; color: #fff; margin-top: 4rpx; }

/* 发布蒙层 */
.publish-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}

/* 发布面板 */
.publish-panel {
  position: fixed;
  bottom: 0; left: 0;
  width: 100%;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.publish-panel-show { transform: translateY(0); }

.publish-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.publish-cancel { color: #999; font-size: 28rpx; }
.publish-title { font-size: 30rpx; font-weight: bold; color: #333; }

.publish-btn {
  padding: 12rpx 30rpx;
  background: #f0f0f0;
  border-radius: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.publish-btn-active {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #fff;
}

.publish-textarea {
  padding: 30rpx;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
}

/* 发布图片预览 */
.publish-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 30rpx;
}

.publish-img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.publish-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.remove-img {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: #333;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

/* 发布工具栏 */
.publish-toolbar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  gap: 40rpx;
}

.toolbar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #666;
}

.toolbar-icon { font-size: 40rpx; }
.word-count { margin-left: auto; font-size: 22rpx; color: #999; }

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
