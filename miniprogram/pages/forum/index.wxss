/* pages/forum/index.wxss */
page {
  background-color: #ffffff;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
}

/* ========== 顶部搜索栏 ========== */
.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.header-left {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #aaaaaa;
}

.header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.notify-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notify-icon {
  font-size: 40rpx;
}

/* ========== Tab 栏 ========== */
.tab-bar {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid #f0f0f0;
  background: #ffffff;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 0 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #888888;
  padding-bottom: 16rpx;
}

.tab-active .tab-text {
  color: #1a1a1a;
  font-weight: bold;
  font-size: 32rpx;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #1d9bf0;
  border-radius: 3rpx;
}

/* ========== 帖子列表 ========== */
.post-list {
  flex: 1;
  overflow: hidden;
}

.post-card {
  display: flex;
  flex-direction: row;
  padding: 24rpx 24rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 左侧头像列 */
.post-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.avatar-line {
  width: 2rpx;
  flex: 1;
  background: #e8e8e8;
  margin-top: 12rpx;
  margin-bottom: 0;
  min-height: 40rpx;
}

/* 右侧内容 */
.post-right {
  flex: 1;
  padding-bottom: 24rpx;
}

.post-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.handle {
  font-size: 24rpx;
  color: #888888;
  margin-top: 2rpx;
}

.post-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.post-time {
  font-size: 24rpx;
  color: #aaaaaa;
}

.post-tag {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 帖子正文 */
.post-content {
  margin-bottom: 16rpx;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #333333;
  white-space: pre-wrap;
}

/* 图片区 */
.post-images {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.post-img-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.post-img-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

/* 操作栏 */
.post-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding-right: 40rpx;
  margin-top: 8rpx;
}

.action-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.action-icon {
  font-size: 34rpx;
}

.action-count {
  font-size: 26rpx;
  color: #888888;
}

.action-active-red .action-count {
  color: #e0245e;
}

.action-active-green .action-count {
  color: #17bf63;
}

/* 底部提示 */
.list-bottom {
  padding: 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-bottom-text {
  font-size: 26rpx;
  color: #cccccc;
}

/* 发帖悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 44rpx;
}
