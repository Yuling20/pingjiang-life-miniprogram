<!-- pages/forum/publish/index.wxml -->
<view class="container">

<!-- 顶部导航 -->
<view class="header">
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">✕</text>
  </view>
  <text class="header-title">发帖</text>
  <view
    class="publish-btn {{content.length >= 5 && !isPublishing ? 'publish-btn-active' : ''}}"
    bindtap="publish"
  >
    <text class="publish-btn-text">{{isPublishing ? '发布中...' : '发布'}}</text>
  </view>
</view>

<!-- 用户信息 -->
<view class="user-row">
  <view class="user-avatar">
    <text class="user-avatar-text">我</text>
  </view>
  <view class="user-info">
    <text class="user-name">平江市民</text>
    <view class="visibility-selector">
      <text class="visibility-text">🌍 所有人可见</text>
      <text class="visibility-arrow">▼</text>
    </view>
  </view>
</view>

<!-- 内容输入区 -->
<view class="content-area">
  <textarea
    class="content-input"
    value="{{content}}"
    placeholder="分享你在平江的生活、求职信息、房源..."
    placeholder-class="content-placeholder"
    maxlength="500"
    auto-height="true"
    bindinput="onContentInput"
  />

  <!-- 图片预览 -->
  <view wx:if="{{images.length > 0}}" class="image-preview">
    <view wx:for="{{images}}" wx:key="*this" class="img-item">
      <image class="preview-img" src="{{item}}" mode="aspectFill"/>
      <view class="img-delete" data-index="{{index}}" bindtap="deleteImage">
        <text class="img-delete-icon">✕</text>
      </view>
    </view>
    <!-- 继续添加图片 -->
    <view wx:if="{{images.length < 9}}" class="img-add-more" bindtap="chooseImage">
      <text class="img-add-icon">+</text>
    </view>
  </view>
</view>

<!-- 字数统计 -->
<view class="char-count-row">
  <view class="char-bar">
    <view class="char-progress" style="width:{{contentLength/500*100}}%"></view>
  </view>
  <text class="char-count {{contentLength > 450 ? 'char-warn' : ''}}">{{500 - contentLength}}</text>
</view>

<!-- 底部工具栏 -->
<view class="toolbar">
  <!-- 添加图片 -->
  <view class="tool-item" bindtap="chooseImage">
    <text class="tool-icon">🖼️</text>
    <text class="tool-text">图片({{images.length}}/9)</text>
  </view>

  <!-- 话题标签 -->
  <view class="tool-item" bindtap="toggleTagPicker">
    <text class="tool-icon">🏷️</text>
    <text class="tool-text">{{selectedTag ? '#' + selectedTag : '话题'}}</text>
  </view>

  <!-- 位置 -->
  <view class="tool-item">
    <text class="tool-icon">📍</text>
    <text class="tool-text">平江县</text>
  </view>
</view>

<!-- 标签选择浮层 -->
<view wx:if="{{showTagPicker}}" class="tag-picker">
  <view class="tag-picker-title">选择话题</view>
  <view class="tag-grid">
    <view
      wx:for="{{tags}}"
      wx:key="*this"
      class="tag-chip {{selectedTag === item ? 'tag-chip-selected' : ''}}"
      data-tag="{{item}}"
      bindtap="selectTag"
    >
      <text>#{{item}}</text>
    </view>
  </view>
</view>

</view>
