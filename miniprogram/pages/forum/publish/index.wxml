<!-- pages/forum/publish/index.wxml -->
<view class="container">

<view class="top-tip">
  <text class="tip-icon">✏️</text>
  <text class="tip-text">分享你的平江生活，让邻居看到</text>
</view>

<!-- 分类选择 -->
<view class="form-card">
  <view class="card-title">帖子信息</view>

  <view class="form-item" bindtap="showCategoryPicker">
    <text class="form-label required">帖子分类</text>
    <view class="form-select">
      <text class="{{category ? 'select-value' : 'select-placeholder'}}">
        {{category || '请选择分类'}}
      </text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="form-item">
    <text class="form-label required">帖子标题</text>
    <input
      class="form-input"
      placeholder="一句话描述你的帖子"
      value="{{title}}"
      data-field="title"
      bindinput="onInput"
      maxlength="30"
    />
  </view>
</view>

<!-- 内容 -->
<view class="form-card">
  <view class="card-title">帖子内容</view>
  <view class="form-item column">
    <textarea
      class="form-textarea"
      placeholder="分享你的所见所闻，说说你的想法..."
      value="{{content}}"
      data-field="content"
      bindinput="onInput"
      maxlength="1000"
      auto-height
    />
    <text class="word-count">{{content.length || 0}}/1000</text>
  </view>
</view>

<!-- 图片 -->
<view class="form-card">
  <view class="card-title">添加图片 <text class="card-sub">（可选，最多9张）</text></view>
  <view class="image-grid">
    <block wx:for="{{images}}" wx:key="index">
      <view class="image-item">
        <image src="{{item}}" class="preview-image" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
        <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
      </view>
    </block>
    <view class="add-image-btn" bindtap="chooseImage" wx:if="{{images.length < 9}}">
      <text class="add-icon">+</text>
      <text class="add-text">添加图片</text>
    </view>
  </view>
</view>

<!-- 匿名开关 -->
<view class="form-card">
  <view class="form-item">
    <text class="form-label">匿名发布</text>
    <view class="switch-wrap">
      <text class="switch-tip">{{anonymous ? '匿名' : '实名'}}</text>
      <switch checked="{{anonymous}}" bindchange="toggleAnonymous" color="#FF6B35" />
    </view>
  </view>
</view>

<!-- 发布按钮 -->
<view class="bottom-btns">
  <button class="btn-submit" bindtap="submitPost" loading="{{submitting}}">发布帖子</button>
</view>

<!-- 分类选择器 -->
<view class="picker-mask" wx:if="{{showCategoryPicker}}" bindtap="hideCategoryPicker">
  <view class="picker-panel" catchtap="">
    <view class="picker-header">
      <text class="picker-cancel" bindtap="hideCategoryPicker">取消</text>
      <text class="picker-title">选择分类</text>
      <text class="picker-confirm" bindtap="hideCategoryPicker">确定</text>
    </view>
    <picker-view class="picker-view" value="{{[categoryIndex]}}" bindchange="onCategoryChange">
      <picker-view-column>
        <view class="picker-item" wx:for="{{categoryList}}" wx:key="index">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>

</view>
