<!-- pages/recruit/publish/index.wxml -->
<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <view class="back-btn" bindtap="prevStep" wx:if="{{step === 2}}">
      <text>‹</text>
    </view>
    <text class="header-title">发布职位</text>
    <view style="width:60rpx;"></view>
  </view>

  <!-- 步骤条 -->
  <view class="steps">
    <view class="step {{step >= 1 ? 'step-active' : ''}}">
      <view class="step-circle">1</view>
      <text class="step-label">基本信息</text>
    </view>
    <view class="step-line {{step >= 2 ? 'step-line-active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'step-active' : ''}}">
      <view class="step-circle">2</view>
      <text class="step-label">职位要求</text>
    </view>
  </view>

  <!-- 步骤1：基本信息 -->
  <view wx:if="{{step === 1}}">
    
    <!-- 招聘类型 -->
    <view class="section">
      <view class="section-title">招聘类型</view>
      <view class="type-grid">
        <view 
          wx:for="{{jobTypes}}" 
          wx:key="key"
          class="type-item {{jobType === item.key ? 'type-active' : ''}}"
          bindtap="selectJobType"
          data-key="{{item.key}}">
          <text>{{item.label}}</text>
          <view class="type-check" wx:if="{{jobType === item.key}}">✓</view>
        </view>
      </view>
      <view class="tips-text">注：招聘类型、职位名称发布后不可修改</view>
    </view>

    <!-- 职位名称 -->
    <view class="section">
      <view class="section-title required">职位名称</view>
      <view class="input-wrap">
        <input 
          class="form-input"
          value="{{jobName}}"
          bindinput="onJobNameInput"
          placeholder='请填写职位名称，如"销售专员"'
          maxlength="30"/>
        <text class="input-count">{{jobName.length}}/30</text>
      </view>
    </view>

    <!-- 工作城市 -->
    <view class="section">
      <view class="section-title required">工作城市</view>
      <view class="select-row">
        <text class="select-value">{{cityName}}</text>
        <text class="select-arrow">›</text>
      </view>
    </view>

    <!-- 职位描述 -->
    <view class="section">
      <view class="section-title-row">
        <text class="section-title required">职位描述</text>
        <view class="ai-btn" bindtap="aiHelper">
          <text class="ai-icon">✨</text>
          <text>AI帮写</text>
        </view>
      </view>
      <textarea 
        class="form-textarea"
        value="{{jobDesc}}"
        bindinput="onJobDescInput"
        placeholder="介绍工作内容、职位要求（建议填写100字以上，获得更多曝光）"
        maxlength="2000"/>
      <text class="input-count">{{jobDesc.length}}/2000</text>
    </view>

    <!-- 下一步 -->
    <view class="bottom-btn-wrap">
      <view class="next-btn" bindtap="nextStep">
        <text>下一步：选择职位要求</text>
      </view>
    </view>
  </view>

  <!-- 步骤2：职位要求 -->
  <view wx:if="{{step === 2}}">

    <!-- 薪资 -->
    <view class="section">
      <view class="section-title required">薪资范围</view>
      <view class="salary-row">
        <input class="salary-input" value="{{salary.min}}" bindinput="onSalaryMinInput" placeholder="最低" type="number"/>
        <text class="salary-sep">—</text>
        <input class="salary-input" value="{{salary.max}}" bindinput="onSalaryMaxInput" placeholder="最高" type="number"/>
        <view class="salary-units">
          <view 
            wx:for="{{salaryUnits}}" 
            wx:key="index"
            class="unit-item {{salary.unit === item ? 'unit-active' : ''}}"
            bindtap="selectSalaryUnit"
            data-unit="{{item}}">
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 工作经验 -->
    <view class="section">
      <view class="section-title">工作经验</view>
      <view class="tag-group">
        <view 
          wx:for="{{experienceOptions}}" 
          wx:key="index"
          class="tag-item {{experience === item ? 'tag-active' : ''}}"
          bindtap="selectExperience"
          data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 学历要求 -->
    <view class="section">
      <view class="section-title">学历要求</view>
      <view class="tag-group">
        <view 
          wx:for="{{educationOptions}}" 
          wx:key="index"
          class="tag-item {{education === item ? 'tag-active' : ''}}"
          bindtap="selectEducation"
          data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 招聘人数 -->
    <view class="section">
      <view class="section-title">招聘人数</view>
      <view class="input-wrap">
        <input 
          class="form-input"
          value="{{headcount}}"
          bindinput="onHeadcountInput"
          placeholder="请输入招聘人数"
          type="number"/>
        <text class="input-unit">人</text>
      </view>
    </view>

    <!-- 福利待遇 -->
    <view class="section">
      <view class="section-title">福利待遇</view>
      <view class="tag-group">
        <view 
          wx:for="{{commonWelfare}}" 
          wx:key="index"
          class="tag-item {{welfare.indexOf(item) > -1 ? 'tag-active' : ''}}"
          bindtap="toggleWelfare"
          data-item="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="section">
      <view class="section-title required">联系人</view>
      <input 
        class="form-input"
        value="{{contactName}}"
        bindinput="onContactNameInput"
        placeholder="请输入联系人姓名"/>
    </view>

    <view class="section">
      <view class="section-title required">联系电话</view>
      <input 
        class="form-input"
        value="{{contactPhone}}"
        bindinput="onContactPhoneInput"
        placeholder="请输入联系电话"
        type="number"/>
    </view>

    <!-- 发布按钮 -->
    <view class="bottom-btn-wrap">
      <view class="submit-btn" bindtap="submitPublish">
        <text>立即发布职位</text>
      </view>
    </view>
  </view>

  <view style="height:40rpx;"></view>
</view>
