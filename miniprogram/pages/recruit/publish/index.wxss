/* pages/recruit/publish/index.wxss */
page { background: #f5f5f5; }

.container { padding-bottom: 40rpx; }

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  width: 60rpx;
  font-size: 48rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 步骤条 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 16rpx;
  gap: 0;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
}

.step-active .step-circle {
  background: linear-gradient(135deg, #00b4db, #0083b0);
  color: #fff;
}

.step-label { font-size: 22rpx; color: #999; }
.step-active .step-label { color: #0083b0; font-weight: bold; }

.step-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 20rpx;
  margin-bottom: 30rpx;
}

.step-line-active { background: linear-gradient(90deg, #00b4db, #0083b0); }

/* 卡片区块 */
.section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-title.required::before {
  content: '* ';
  color: #ff4d4f;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 招聘类型 */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.type-item {
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.type-active {
  border-color: #0083b0;
  background: #e8f4f8;
  color: #0083b0;
  font-weight: bold;
}

.type-check {
  width: 36rpx;
  height: 36rpx;
  background: #0083b0;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tips-text {
  font-size: 22rpx;
  color: #ff9800;
  background: #fff8e1;
  padding: 16rpx;
  border-radius: 8rpx;
}

/* 输入框 */
.input-wrap {
  display: flex;
  align-items: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  background: #fafafa;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}

.input-count { font-size: 22rpx; color: #ccc; }
.input-unit { font-size: 26rpx; color: #666; }

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* AI帮写按钮 */
.ai-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 30rpx;
  color: #fff;
  font-size: 24rpx;
}

.ai-icon { font-size: 26rpx; }

/* 选择行 */
.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  background: #fafafa;
}

.select-value { font-size: 28rpx; color: #333; }
.select-arrow { font-size: 36rpx; color: #ccc; }

/* 薪资 */
.salary-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.salary-input {
  flex: 1;
  height: 88rpx;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.salary-sep { font-size: 28rpx; color: #999; flex-shrink: 0; }

.salary-units {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.unit-item {
  padding: 12rpx 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.unit-active {
  border-color: #0083b0;
  background: #e8f4f8;
  color: #0083b0;
}

/* 标签组 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 14rpx 28rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.tag-active {
  border-color: #0083b0;
  background: #e8f4f8;
  color: #0083b0;
  font-weight: bold;
}

/* 底部按钮 */
.bottom-btn-wrap {
  padding: 30rpx;
}

.next-btn, .submit-btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #00b4db, #0083b0);
  box-shadow: 0 8rpx 24rpx rgba(0,131,176,0.35);
}
