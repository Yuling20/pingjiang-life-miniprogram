/* pages/recruit/publish/index.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.top-tip {
  background: linear-gradient(135deg, #FF6B35, #ff8c5a);
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-icon { font-size: 32rpx; }
.tip-text { color: #fff; font-size: 26rpx; }

.form-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-sub { font-size: 24rpx; color: #999; font-weight: normal; }

.form-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 16rpx 0;
}

.form-item.column {
  flex-direction: column;
  align-items: flex-start;
}

.form-item:last-child { border-bottom: none; }

.form-label {
  font-size: 28rpx;
  color: #333;
  min-width: 160rpx;
  flex-shrink: 0;
}

.form-label.required::before {
  content: '*';
  color: #ff4444;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-select {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
}

.select-value { font-size: 28rpx; color: #333; }
.select-placeholder { font-size: 28rpx; color: #bbb; }
.arrow { color: #bbb; font-size: 36rpx; }

.salary-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.flex1 { flex: 1; }
.unit { font-size: 26rpx; color: #999; flex-shrink: 0; }

/* 福利标签 */
.welfare-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.welfare-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fafafa;
}

.welfare-tag.active {
  border-color: #FF6B35;
  color: #FF6B35;
  background: #fff5f0;
}

.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  min-height: 200rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.word-count {
  font-size: 24rpx;
  color: #bbb;
  text-align: right;
  width: 100%;
  margin-top: 8rpx;
}

.bottom-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B35, #ff8c5a);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  line-height: 88rpx;
}

.picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel { font-size: 28rpx; color: #999; }
.picker-title { font-size: 30rpx; font-weight: bold; color: #333; }
.picker-confirm { font-size: 28rpx; color: #FF6B35; }
.picker-view { height: 400rpx; }
.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
}
