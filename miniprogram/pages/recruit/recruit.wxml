<!-- pages/recruit/recruit.wxml -->
<view class="recruit-container">

<!-- 搜索栏 -->
<view class="search-bar">
  <view class="search-input-wrap">
    <text class="search-icon-txt">🔍</text>
    <input 
      class="search-input"
      placeholder="搜索职位/公司"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      bindconfirm="doSearch"
      confirm-type="search"
    />
  </view>
  <view class="publish-job-btn" bindtap="goPublish">
    <text>我要招人</text>
  </view>
</view>

<!-- Tab切换 -->
<view class="tab-row">
  <view 
    wx:for="{{tabs}}" 
    wx:key="*this"
    class="tab-item {{activeTab === item ? 'tab-active' : ''}}"
    bindtap="switchTab"
    data-tab="{{item}}"
  >{{item}}</view>
</view>

<!-- 筛选条 -->
<scroll-view scroll-x class="filter-bar">
  <view 
    wx:for="{{filterItems}}" 
    wx:key="*this"
    class="filter-tag {{activeFilter === item ? 'filter-active' : ''}}"
    bindtap="setFilter"
    data-filter="{{item}}"
  >{{item}}</view>
</scroll-view>

<!-- 职位列表 -->
<scroll-view scroll-y class="job-list">
  <view 
    class="job-card" 
    wx:for="{{jobs}}" 
    wx:key="id"
    bindtap="goJobDetail"
    data-id="{{item.id}}"
  >
    <!-- 职位基本信息 -->
    <view class="job-header">
      <view class="job-left">
        <text class="job-title">{{item.title}}</text>
        <text class="job-salary">{{item.salary}}元/月</text>
      </view>
      <view class="company-logo">
        <text class="logo-char">{{item.company[0]}}</text>
      </view>
    </view>

    <!-- 标签 -->
    <view class="job-tags">
      <text class="job-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
    </view>

    <!-- 福利 -->
    <view class="welfare-row">
      <text class="welfare-item" wx:for="{{item.welfare}}" wx:key="*this" wx:for-item="w">{{w}}</text>
    </view>

    <!-- 底部 - 招聘者 + 沟通按钮 -->
    <view class="job-footer">
      <view class="recruiter-info">
        <view class="recruiter-avatar">
          <text class="recruiter-char">{{item.recruiter[0]}}</text>
          <view class="online-dot {{item.online ? 'dot-online' : 'dot-offline'}}"></view>
        </view>
        <view class="recruiter-meta">
          <text class="recruiter-name">{{item.recruiter}}</text>
          <text class="recruiter-title">{{item.recruiterTitle}}</text>
        </view>
        <text class="active-time">{{item.activeTime}}</text>
      </view>
      <view class="chat-btn" catchtap="chatRecruiter" data-id="{{item.id}}">
        立即沟通
      </view>
    </view>
  </view>

  <view class="list-end"><text>— 已加载全部职位 —</text></view>
</scroll-view>

</view>
