/* pages/recruit/recruit.wxss */

.recruit-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #00B4D8;
  gap: 20rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  gap: 10rpx;
}

.search-icon-txt { font-size: 28rpx; }

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 44rpx;
}

.publish-job-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 24rpx;
  border-radius: 40rpx;
  white-space: nowrap;
  font-weight: bold;
}

/* Tab */
.tab-row {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab-active {
  color: #00B4D8;
  font-weight: bold;
  border-bottom: 4rpx solid #00B4D8;
}

/* 筛选条 */
.filter-bar {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.filter-active {
  color: #00B4D8;
  background: #E0F7FA;
  font-weight: bold;
}

/* 职位列表 */
.job-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

.job-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.job-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.job-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.job-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.job-salary {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF6B35;
}

.company-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #00B4D8, #0077B6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-char {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.job-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.job-tag {
  font-size: 22rpx;
  color: #00B4D8;
  background: #E0F7FA;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.welfare-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.welfare-item {
  font-size: 22rpx;
  color: #888;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 底部 */
.job-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.recruiter-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.recruiter-avatar {
  position: relative;
  width: 60rpx;
  height: 60rpx;
}

.recruiter-char {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #ddd;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 60rpx;
  text-align: center;
}

.online-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.dot-online { background: #52c41a; }
.dot-offline { background: #ccc; }

.recruiter-meta {
  display: flex;
  flex-direction: column;
}

.recruiter-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.recruiter-title {
  font-size: 22rpx;
  color: #999;
}

.active-time {
  font-size: 22rpx;
  color: #999;
}

.chat-btn {
  background: #00B4D8;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
}

.list-end {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #ccc;
}
