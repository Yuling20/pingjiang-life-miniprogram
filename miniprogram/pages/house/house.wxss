/* pages/house/house.wxss */

.house-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 搜索区 */
.search-area {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FF6B35;
  gap: 20rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  gap: 10rpx;
}

.search-icon { font-size: 28rpx; }

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 44rpx;
}

.publish-btn {
  background: #fff;
  color: #FF6B35;
  font-size: 26rpx;
  font-weight: bold;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  white-space: nowrap;
}

/* Tab */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab-active {
  color: #FF6B35;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B35;
}

/* 筛选 */
.filter-section {
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-group {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  margin-right: 10rpx;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-chip {
  display: inline-block;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 12rpx;
}

.chip-active {
  color: #FF6B35;
  background: #FFF0EA;
  font-weight: bold;
}

/* 房源列表 */
.house-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

/* 房源卡片 */
.house-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

/* 图片区 */
.house-img-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: #f0f0f0;
}

.house-img-placeholder {
  width: 100%;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF0EA, #FFE4D6);
}

.placeholder-icon { font-size: 60rpx; }
.placeholder-txt { font-size: 24rpx; color: #bbb; margin-top: 10rpx; }

.vip-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.time-badge {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0,0,0,0.4);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 房源信息 */
.house-info {
  padding: 24rpx;
}

.house-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.5;
}

.house-meta {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.meta-sep {
  color: #ddd;
  margin: 0 10rpx;
  font-size: 24rpx;
}

.house-location {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.location-icon { font-size: 24rpx; margin-right: 6rpx; }
.location-text { font-size: 24rpx; color: #999; }

.house-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.h-tag {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF0EA;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.house-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rent-info {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.rent-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B35;
}

.rent-unit {
  font-size: 24rpx;
  color: #999;
}

.contact-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 16rpx 30rpx;
  border-radius: 40rpx;
}

.list-end {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #ccc;
}
