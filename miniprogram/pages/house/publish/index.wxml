<!-- pages/house/publish/index.wxml -->
<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-title">发布房源</view>
    <view class="header-service">客服</view>
  </view>

  <!-- 出租方式 -->
  <view class="rent-type-bar">
    <view 
      class="rent-type-item {{rentType === 'whole' ? 'rent-active' : ''}}"
      bindtap="selectRentType" data-type="whole">整套出租</view>
    <view 
      class="rent-type-item {{rentType === 'shared' ? 'rent-active' : ''}}"
      bindtap="selectRentType" data-type="shared">合租出租</view>
  </view>

  <!-- 基础信息 -->
  <view class="card">
    <view class="card-title">基础信息</view>
    
    <!-- 所在城市 -->
    <view class="form-row">
      <view class="form-label-wrap">
        <text class="required-star">*</text>
        <text class="form-label">所在城市</text>
      </view>
      <view class="form-value-row">
        <text class="form-value">{{cityName}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="divider"></view>

    <!-- 所在小区 -->
    <view class="form-row">
      <view class="form-label-wrap">
        <text class="required-star">*</text>
        <text class="form-label">所在小区</text>
      </view>
      <input class="form-input-right" value="{{communityName}}" bindinput="onCommunityInput" placeholder="请输入小区名称"/>
    </view>
    <view class="divider"></view>

    <!-- 房屋面积 -->
    <view class="form-row">
      <view class="form-label-wrap">
        <text class="required-star">*</text>
        <text class="form-label">房屋面积</text>
      </view>
      <view class="input-with-unit">
        <input class="form-input-right" value="{{area}}" bindinput="onAreaInput" placeholder="请输入面积" type="number"/>
        <text class="unit-text">m²</text>
      </view>
    </view>
    <view class="divider"></view>

    <!-- 房屋户型 -->
    <view class="form-col">
      <view class="form-label-wrap" style="margin-bottom:20rpx;">
        <text class="required-star">*</text>
        <text class="form-label">房屋户型</text>
      </view>
      <view class="option-group">
        <view 
          wx:for="{{layoutOptions}}" 
          wx:key="index"
          class="option-item {{layout === item ? 'option-active' : ''}}"
          bindtap="selectLayout" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
    <view class="divider"></view>

    <!-- 房屋朝向 -->
    <view class="form-col">
      <view class="form-label-wrap" style="margin-bottom:20rpx;">
        <text class="required-star">*</text>
        <text class="form-label">房屋朝向</text>
      </view>
      <view class="option-group">
        <view 
          wx:for="{{directionOptions}}" 
          wx:key="index"
          class="option-item {{direction === item ? 'option-active' : ''}}"
          bindtap="selectDirection" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
    <view class="divider"></view>

    <!-- 入住时间 -->
    <view class="form-col">
      <view class="form-label-wrap" style="margin-bottom:20rpx;">
        <text class="required-star">*</text>
        <text class="form-label">入住时间</text>
      </view>
      <view class="option-group">
        <view 
          wx:for="{{moveInOptions}}" 
          wx:key="index"
          class="option-item {{moveInTime === item ? 'option-active' : ''}}"
          bindtap="selectMoveIn" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
    <view class="divider"></view>

    <!-- 期望租金 -->
    <view class="form-row">
      <view class="form-label-wrap">
        <text class="required-star">*</text>
        <text class="form-label">期望租金</text>
      </view>
      <view class="input-with-unit">
        <input class="form-input-right" value="{{rentPrice}}" bindinput="onRentPriceInput" placeholder="请输入" type="number"/>
        <text class="unit-text">元/月</text>
      </view>
    </view>
    <view class="divider"></view>

    <!-- 付款方式 -->
    <view class="form-col">
      <view class="form-label-wrap" style="margin-bottom:20rpx;">
        <text class="required-star">*</text>
        <text class="form-label">付款方式</text>
      </view>
      <view class="option-group">
        <view 
          wx:for="{{payTypeOptions}}" 
          wx:key="index"
          class="option-item {{payType === item ? 'option-active' : ''}}"
          bindtap="selectPayType" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 展示信息 -->
  <view class="card">
    <view class="card-title">展示信息</view>
    <view class="exposure-tip">📈 补充以下信息，房源曝光提升30%</view>

    <!-- 房源图片 -->
    <view class="form-label-wrap" style="margin-bottom:20rpx;">
      <text class="form-label">房源图片</text>
    </view>
    <view class="images-grid">
      <view wx:for="{{images}}" wx:key="index" class="img-item">
        <image src="{{item.url}}" class="house-img" mode="aspectFill"/>
        <view class="img-remove" catchtap="removeImage" data-index="{{index}}">✕</view>
      </view>
      <view class="img-add" bindtap="addImage" wx:if="{{images.length < 10}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
        <text class="add-tip">{{images.length}}/10</text>
      </view>
    </view>
    <text class="img-tips">添加室内图，出租更快~</text>
    <view class="divider"></view>

    <!-- 房源标签 -->
    <view class="form-label-wrap" style="margin-bottom:20rpx;margin-top:20rpx;">
      <text class="form-label">房源标签</text>
      <text class="tag-count">{{selectedTags.length}}/5</text>
    </view>
    <view class="option-group">
      <view 
        wx:for="{{commonTags}}" 
        wx:key="index"
        class="option-item {{selectedTags.indexOf(item) > -1 ? 'option-active' : ''}}"
        bindtap="toggleTag" data-tag="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
    <view class="divider" style="margin-top:20rpx;"></view>

    <!-- 房源描述 -->
    <view class="form-label-wrap" style="margin: 20rpx 0;">
      <text class="form-label">房源描述</text>
    </view>
    <textarea 
      class="desc-textarea"
      value="{{description}}"
      bindinput="onDescInput"
      placeholder="描述房屋情况，如装修风格、周边配套等，吸引更多租客关注..."
      maxlength="300"/>
    <text class="word-count">{{description.length}}/300</text>
  </view>

  <!-- 平台验真 -->
  <view class="card">
    <view class="card-title">平台验真 <text class="verify-tip">🔒 通过验真提升房源可信度</text></view>
    
    <view class="form-row">
      <text class="form-label">楼栋号</text>
      <input class="form-input-right" value="{{buildingNo}}" bindinput="onBuildingInput" placeholder="如：3栋"/>
    </view>
    <view class="divider"></view>
    <view class="form-row">
      <text class="form-label">楼层</text>
      <input class="form-input-right" value="{{floor}}" bindinput="onFloorInput" placeholder="如：5层"/>
    </view>
  </view>

  <!-- 其他信息 -->
  <view class="card">
    <view class="card-title">其他信息</view>
    
    <!-- 看房时间 -->
    <view class="form-col">
      <text class="form-label" style="margin-bottom:16rpx;display:block;">看房时间</text>
      <view class="option-group">
        <view 
          wx:for="{{showTimeOptions}}" 
          wx:key="index"
          class="option-item {{showTime === item ? 'option-active' : ''}}"
          bindtap="selectShowTime" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
    <view class="divider" style="margin-top:20rpx;"></view>

    <!-- 费用包含 -->
    <view class="form-col" style="margin-top:20rpx;">
      <text class="form-label" style="margin-bottom:16rpx;display:block;">费用包含</text>
      <view class="option-group">
        <view 
          wx:for="{{feeOptions}}" 
          wx:key="index"
          class="option-item {{includedFees.indexOf(item) > -1 ? 'option-active' : ''}}"
          bindtap="toggleFee" data-fee="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
    <view class="divider" style="margin-top:20rpx;"></view>

    <!-- 房东身份 -->
    <view class="form-col" style="margin-top:20rpx;">
      <text class="form-label" style="margin-bottom:16rpx;display:block;">房东身份</text>
      <view class="option-group">
        <view 
          wx:for="{{landlordOptions}}" 
          wx:key="index"
          class="option-item {{landlordType === item ? 'option-active' : ''}}"
          bindtap="selectLandlordType" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 协议 + 发布按钮 -->
  <view class="bottom-area">
    <view class="agree-row" bindtap="toggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agree-text">我承诺房源真实并同意</text>
      <text class="agree-link">《个人用户租房房源展示服务协议》</text>
    </view>
    <view class="submit-btn {{agreed ? 'submit-active' : 'submit-disabled'}}" bindtap="submitPublish">
      <text>立即免费发布</text>
    </view>
  </view>

  <view style="height:40rpx;"></view>
</view>
