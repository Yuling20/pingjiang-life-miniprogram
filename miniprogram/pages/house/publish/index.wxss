/* pages/house/publish/index.wxss */
page { background: #f5f5f5; }

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-title { font-size: 34rpx; font-weight: bold; color: #333; }
.header-service {
  font-size: 26rpx;
  color: #ff5722;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ff5722;
  border-radius: 20rpx;
}

/* 出租方式 */
.rent-type-bar {
  display: flex;
  background: #fff;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.rent-type-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.rent-active {
  color: #ff5722;
  font-weight: bold;
}

.rent-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #ff5722;
  border-radius: 3rpx;
}

/* 卡片 */
.card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.verify-tip {
  font-size: 22rpx;
  color: #52c41a;
  font-weight: normal;
}

.exposure-tip {
  background: #fff7e6;
  color: #fa8c16;
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.form-col { padding: 16rpx 0; }

.form-label-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.required-star { color: #ff4d4f; font-size: 28rpx; }
.form-label { font-size: 28rpx; color: #333; }

.form-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-value { font-size: 28rpx; color: #333; }
.arrow { font-size: 36rpx; color: #ccc; }

.form-input-right {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  height: 60rpx;
}

.input-with-unit {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.unit-text { font-size: 26rpx; color: #666; flex-shrink: 0; }

.divider { height: 1rpx; background: #f5f5f5; margin: 0 -30rpx; }

/* 选项组 */
.option-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  padding: 14rpx 28rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.option-active {
  border-color: #ff5722;
  background: #fff2ed;
  color: #ff5722;
  font-weight: bold;
}

/* 图片 */
.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.house-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.img-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.img-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.add-icon { font-size: 50rpx; color: #ccc; }
.add-text { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.add-tip { font-size: 20rpx; color: #ccc; }
.img-tips { font-size: 22rpx; color: #999; }

.tag-count { font-size: 22rpx; color: #999; margin-left: auto; }

/* 描述框 */
.desc-textarea {
  width: 100%;
  height: 180rpx;
  font-size: 26rpx;
  color: #333;
  background: #fafafa;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 底部 */
.bottom-area {
  background: #fff;
  padding: 30rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checked {
  background: #ff5722;
  border-color: #ff5722;
  color: #fff;
  font-size: 24rpx;
}

.agree-text { font-size: 24rpx; color: #666; }
.agree-link { font-size: 24rpx; color: #ff5722; }

.submit-btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.submit-active {
  background: linear-gradient(135deg, #ff5722, #ff8c00);
  box-shadow: 0 8rpx 24rpx rgba(255,87,34,0.35);
}

.submit-disabled {
  background: #ccc;
}
