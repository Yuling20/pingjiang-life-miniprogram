<!-- pages/house/house.wxml -->
<view class="house-container">

<!-- 搜索栏 -->
<view class="search-area">
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索小区/地址/关键词"/>
  </view>
  <view class="publish-btn" bindtap="goPublish">发房</view>
</view>

<!-- Tab切换 -->
<view class="tab-bar">
  <view 
    wx:for="{{tabs}}" 
    wx:key="*this"
    class="tab-item {{activeTab === item ? 'tab-active' : ''}}"
    bindtap="switchTab"
    data-tab="{{item}}"
  >{{item}}</view>
</view>

<!-- 筛选条 -->
<view class="filter-section">
  <view class="filter-group">
    <text class="filter-label">价格：</text>
    <scroll-view scroll-x class="filter-scroll">
      <view 
        wx:for="{{priceRanges}}" 
        wx:key="*this"
        class="filter-chip {{priceRange === item ? 'chip-active' : ''}}"
        bindtap="setPriceRange"
        data-val="{{item}}"
      >{{item}}</view>
    </scroll-view>
  </view>
  <view class="filter-group">
    <text class="filter-label">户型：</text>
    <scroll-view scroll-x class="filter-scroll">
      <view 
        wx:for="{{roomTypes}}" 
        wx:key="*this"
        class="filter-chip {{roomType === item ? 'chip-active' : ''}}"
        bindtap="setRoomType"
        data-val="{{item}}"
      >{{item}}</view>
    </scroll-view>
  </view>
</view>

<!-- 房源列表 -->
<scroll-view scroll-y class="house-list">
  <view 
    class="house-card" 
    wx:for="{{houses}}" 
    wx:key="id"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <!-- 图片区 -->
    <view class="house-img-wrap">
      <view class="house-img-placeholder">
        <text class="placeholder-icon">🏠</text>
        <text class="placeholder-txt">暂无图片</text>
      </view>
      <view class="vip-badge" wx:if="{{item.isVip}}">VIP</view>
      <view class="time-badge">{{item.publishTime}}</view>
    </view>

    <!-- 信息区 -->
    <view class="house-info">
      <view class="house-title-row">
        <text class="house-title">{{item.title}}</text>
      </view>

      <view class="house-meta">
        <text class="meta-item">{{item.room}}</text>
        <text class="meta-sep">|</text>
        <text class="meta-item">{{item.area}}㎡</text>
        <text class="meta-sep">|</text>
        <text class="meta-item">{{item.floor}}</text>
      </view>

      <view class="house-location">
        <text class="location-icon">📍</text>
        <text class="location-text">{{item.community}} · {{item.address}}</text>
      </view>

      <view class="house-tags">
        <text class="h-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
      </view>

      <view class="house-footer">
        <view class="rent-info">
          <text class="rent-price">{{item.rent}}</text>
          <text class="rent-unit">{{item.unit}}</text>
        </view>
        <view class="contact-btn" catchtap="goPhone" data-id="{{item.id}}">
          📞 联系房东
        </view>
      </view>
    </view>
  </view>

  <view class="list-end"><text>— 更多房源持续更新中 —</text></view>
</scroll-view>

</view>
