/* pages/mine/mine.wxss */
.page-wrap {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

/* 用户头部 */
.user-header {
  background: linear-gradient(135deg, #D4820A, #E8A838);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 52rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.login-btn {
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  display: inline-block;
}

.login-text {
  font-size: 26rpx;
  color: #fff;
}

/* 统计卡片 */
.stats-card {
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #D4820A;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

/* 菜单卡片 */
.menu-card {
  background: #fff;
  margin: 0 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 20rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: #FFF8EE;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-info {
  flex: 1;
}

.menu-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.menu-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 40rpx;
  color: #CCC;
  font-weight: bold;
}

/* 底部版权 */
.footer-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
  gap: 8rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #CCC;
}

.footer-version {
  font-size: 22rpx;
  color: #DDD;
}
