/* miniprogram/pages/mine/mine.wxss */

/* ─── 页面容器 ───────────────────────────────────────── */
.page-wrap {
  min-height: 100vh;
  background-color: #fdf6ec;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ─── 顶部头像昵称区 ─────────────────────────────────── */
.profile-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(135deg, #ff8c00, #ffb347);
  padding: 60rpx 40rpx 48rpx;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  border: 4rpx solid #fff;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.18);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.user-info {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 4rpx 18rpx;
  border-radius: 30rpx;
  width: fit-content;
}

.auth-badge.authed {
  background-color: rgba(255,255,255,0.30);
}

.auth-badge.unauthed {
  background-color: rgba(255,255,255,0.18);
}

.auth-badge-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* ─── 功能模块卡片 ──────────────────────────────────── */
.section-block {
  margin: 24rpx 28rpx 0;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(255,140,0,0.08);
}

.section-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #faecd8;
}

.section-title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #b36200;
  letter-spacing: 1rpx;
}

/* ─── 菜单列表项 ─────────────────────────────────────── */
.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx;
  background-color: #fff;
  transition: background-color 0.15s;
}

.menu-item:active {
  background-color: #fff8ee;
}

.menu-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.menu-icon {
  font-size: 38rpx;
  margin-right: 20rpx;
  width: 46rpx;
  text-align: center;
}

.menu-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.menu-sub {
  font-size: 22rpx;
  color: #aaa;
  margin-left: 14rpx;
  margin-top: 2rpx;
}

.menu-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.menu-count {
  font-size: 24rpx;
  color: #ff8c00;
  background-color: #fff3e0;
  border-radius: 24rpx;
  padding: 4rpx 16rpx;
  margin-right: 10rpx;
  font-weight: 600;
}

.points-value {
  font-size: 26rpx;
  color: #ff8c00;
  font-weight: bold;
  margin-right: 10rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
  margin-left: 4rpx;
}

.auth-status-tag {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  margin-right: 10rpx;
  font-weight: 500;
}

.tag-authed {
  background-color: #e8f5e9;
  color: #388e3c;
}

.tag-unauthed {
  background-color: #fff3e0;
  color: #ff8c00;
}

/* ✅ 新增：签到状态标签 */
.sign-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  margin-right: 10rpx;
  font-weight: 500;
}

.sign-tag-done {
  background-color: #e8f5e9;
  color: #388e3c;
}

.sign-tag-todo {
  background-color: #fff3e0;
  color: #ff8c00;
}

.red-dot {
  background-color: #f44336;
  border-radius: 24rpx;
  min-width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 10rpx;
}

.red-dot-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

/* ─── 分割线 ─────────────────────────────────────────── */
.divider {
  height: 1rpx;
  background-color: #f5ead8;
  margin-left: 90rpx;
}

/* ─── 退出登录按钮 ────────────────────────────────────── */
.logout-wrap {
  margin: 48rpx 28rpx 0;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #fff;
  color: #e53935;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 20rpx;
  border: none;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(229,57,53,0.08);
  letter-spacing: 2rpx;
}

.logout-btn::after { border: none; }
.logout-btn:active { background-color: #fff5f5; }

/* ─── 联系我们弹窗 ───────────────────────────────────── */
.modal-mask {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-color: rgba(0,0,0,0.50);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 0 0 40rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.18);
}

.modal-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 24rpx;
  border-bottom: 1rpx solid #f5ead8;
  background-color: #fff8ee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #b36200;
}

.modal-close {
  font-size: 34rpx;
  color: #aaa;
  padding: 0 8rpx;
  line-height: 1;
}

.qrcode-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 40rpx 20rpx;
}

.qrcode-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  border: 2rpx solid #faecd8;
  background-color: #fafafa;
}

.qrcode-tip {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 16rpx;
  text-align: center;
}

.wechat-id-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 8rpx 40rpx 28rpx;
  padding: 20rpx 28rpx;
  background-color: #fdf6ec;
  border-radius: 12rpx;
}

.wechat-id-label {
  font-size: 28rpx;
  color: #888;
}

.wechat-id-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 1rpx;
}

.copy-btn {
  margin: 0 40rpx;
  width: calc(100% - 80rpx);
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ff8c00;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
  text-align: center;
  letter-spacing: 2rpx;
}

.copy-btn::after { border: none; }
.copy-btn:active { background-color: #e07b00; }

.modal-notice {
  display: block;
  font-size: 20rpx;
  color: #bbb;
  text-align: center;
  margin-top: 20rpx;
  padding: 0 40rpx;
  line-height: 1.6;
}
