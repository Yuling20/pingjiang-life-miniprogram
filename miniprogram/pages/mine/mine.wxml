<!--pages/mine/mine.wxml-->
<view class="page-wrap">

<!-- 顶部用户信息 -->
<view class="user-header">
  <view class="avatar-wrap">
    <text class="avatar-icon">{{userInfo.avatarIcon}}</text>
  </view>
  <view class="user-info">
    <text class="user-name">{{userInfo.nickName}}</text>
    <view class="login-btn" bindtap="onLogin">
      <text class="login-text">点击登录 / 注册</text>
    </view>
  </view>
</view>

<!-- 统计数据 -->
<view class="stats-card">
  <view
    wx:for="{{stats}}"
    wx:key="label"
    class="stat-item"
  >
    <text class="stat-value">{{item.value}}</text>
    <text class="stat-label">{{item.label}}</text>
  </view>
</view>

<!-- 功能菜单 -->
<view class="menu-card">
  <view
    wx:for="{{menuList}}"
    wx:key="id"
    class="menu-item"
    bindtap="onMenuTap"
    data-type="{{item.type}}"
    hover-class="menu-item-hover"
  >
    <text class="menu-icon">{{item.icon}}</text>
    <view class="menu-info">
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-desc">{{item.desc}}</text>
    </view>
    <text class="menu-arrow">›</text>
  </view>
</view>

<!-- 底部版权 -->
<view class="footer-tip">
  <text class="footer-text">平江汇生活 · 平江人自己的平台</text>
  <text class="footer-version">Version 1.0.0</text>
</view>

</view>
