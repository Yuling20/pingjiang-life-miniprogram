page { background: #f5f5f5; }
.container { padding: 24rpx 24rpx 60rpx; }

/* ─── 颜色工具 ─── */
.text-success { color: #52c41a; }
.text-warning  { color: #f90; }
.highlight     { color: #f90; font-weight: 700; }

/* ─── 顶部积分概览卡 ─── */
.total-card {
  background: linear-gradient(135deg, #ff8c00, #ffc107);
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 24rpx;
}
.total-card__label   { font-size: 26rpx; opacity: .85; }
.total-card__amount  { font-size: 80rpx; font-weight: 700; line-height: 1.2; }
.total-card__sub     { font-size: 24rpx; opacity: .8; margin-top: 8rpx; }
.total-card__link    {
  display: inline-block; margin-top: 20rpx; font-size: 24rpx;
  background: rgba(255,255,255,.25); border-radius: 30rpx; padding: 6rpx 24rpx;
}

/* ─── 签到状态卡 ─── */
.sign-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}

.sign-card__status-row {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx;
}
.sign-card__status-icon { font-size: 40rpx; }
.sign-card__status-text { font-size: 30rpx; font-weight: 600; }

.sign-card__consecutive {
  font-size: 26rpx; color: #666; margin-bottom: 28rpx;
}
.sign-card__days-num {
  font-size: 48rpx; font-weight: 700; color: #f90; margin: 0 4rpx;
}

/* ─── 进度条 ─── */
.progress-section { margin-bottom: 24rpx; }
.progress-label {
  font-size: 22rpx; color: #999; margin-bottom: 16rpx;
}
.progress-bar-wrap {
  height: 8rpx; background: #f0f0f0; border-radius: 8rpx; margin-bottom: 16rpx; overflow: hidden;
}
.progress-bar-fill {
  height: 100%; background: linear-gradient(90deg, #ff8c00, #ffc107);
  border-radius: 8rpx; transition: width .4s ease;
  min-width: 0%;
}
.progress-dots {
  display: flex; justify-content: space-between;
}
.progress-dot {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 2rpx solid #e0e0e0;
  justify-content: center; background: #fafafa;
  position: relative;
}
.progress-dot--done {
  background: linear-gradient(135deg, #ff8c00, #ffc107);
  border-color: #ff8c00;
}
.progress-dot--done .progress-dot__num { color: #fff; }
.progress-dot--bonus {
  border-color: #ff4d4f;
}
.progress-dot__num  { font-size: 20rpx; color: #999; font-weight: 600; }
.progress-dot__bonus {
  font-size: 16rpx; color: #ff4d4f; font-weight: 700;
  position: absolute; bottom: -22rpx;
}

/* ─── 连续7天奖励提示 ─── */
.bonus-tip {
  background: #fff8f0; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 24rpx; color: #e67e22;
  margin-bottom: 28rpx; margin-top: 12rpx;
}

/* ─── 签到按钮 ─── */
.sign-btn {
  width: 100%; text-align: center;
  border-radius: 50rpx; font-size: 32rpx; font-weight: 700;
  padding: 28rpx 0; box-sizing: border-box;
  transition: opacity .2s;
}
.sign-btn--active {
  background: linear-gradient(90deg, #ff8c00, #ffc107);
  color: #fff;
}
.sign-btn--disabled {
  background: #f0f0f0; color: #bbb;
}

/* ─── 每日可得简要说明 ─── */
.earn-tips {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
}
.earn-tips__title {
  font-size: 28rpx; font-weight: 600; color: #222; margin-bottom: 20rpx;
}
.earn-tips__item {
  display: flex; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5;
  font-size: 24rpx;
}
.earn-tips__scene  { color: #555; }
.earn-tips__reward { color: #f90; font-weight: 600; }
.earn-tips__link {
  font-size: 24rpx; color: #f90; text-align: center;
  padding-top: 20rpx;
}

/* ─── 签到成功弹窗 ─── */
.success-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.55); z-index: 9999;
  display: flex; align-items: center; justify-content: center;
}
.success-modal {
  width: 560rpx; background: #fff;
  border-radius: 28rpx; padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.success-modal__icon  { font-size: 80rpx; margin-bottom: 16rpx; }
.success-modal__title { font-size: 32rpx; font-weight: 700; color: #222; }
.success-modal__points {
  font-size: 64rpx; font-weight: 800;
  color: #f90; margin: 20rpx 0;
}
.success-modal__consecutive {
  font-size: 26rpx; color: #555; margin-bottom: 16rpx;
}
.success-modal__bonus {
  background: #fff8f0; border-radius: 12rpx;
  padding: 16rpx; font-size: 24rpx; color: #e67e22;
  margin-bottom: 16rpx;
}
.success-modal__next-tip {
  font-size: 22rpx; color: #bbb; margin-bottom: 16rpx;
}
.success-modal__btn {
  background: linear-gradient(90deg, #ff8c00, #ffc107);
  color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 50rpx; padding: 22rpx 0; margin-top: 8rpx;
}
