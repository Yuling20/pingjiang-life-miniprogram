<view class="container">

<!-- 签到卡 -->
<view class="sign-card">
  <view class="sign-card__title">每日签到</view>
  <view class="sign-card__days">连续签到 <text class="highlight">{{consecutiveDays}}</text> 天</view>
  <view class="sign-card__rule">
    连续签到满{{signRule.bonusRule.consecutiveDays}}天，当日额外+{{signRule.bonusRule.bonusPoints}}积分
  </view>

  <view class="sign-card__btn {{signed ? 'signed' : ''}}" bindtap="onSign">
    <text wx:if="{{!signed}}">立即签到 +{{signRule.points}}积分</text>
    <text wx:else>今日已签到 ✓</text>
  </view>
</view>

<!-- 积分总览 -->
<view class="points-overview">
  <view class="points-overview__item">
    <view class="points-overview__val">{{totalPoints}}</view>
    <view class="points-overview__label">总积分</view>
  </view>
  <view class="points-overview__divider"></view>
  <view class="points-overview__item">
    <view class="points-overview__val">{{todayEarned}}/{{dailyLimit}}</view>
    <view class="points-overview__label">今日已获/上限</view>
  </view>
</view>

<!-- Toast -->
<view class="toast {{toast.show ? 'toast--show' : ''}}">{{toast.msg}}</view>

</view>
