<!-- miniprogram/pages/mine/points/index.wxml -->
<view class="container">

<!-- ① 积分总览卡片 -->
<view class="points-card">
  <view class="points-card__title">我的积分</view>
  <view class="points-card__amount">{{totalPoints}}</view>
  <view class="points-card__sub">
    今日已获 {{todayEarned}} / 上限 {{dailyLimit}} 积分
  </view>
  <view class="points-card__tips">
    积分不可提现·不可转让·有效期12个月
  </view>
  <view class="points-card__rule-btn" bindtap="onShowRule">积分规则说明 ›</view>
</view>

<!-- ② 快捷入口 -->
<view class="quick-actions">
  <view class="quick-actions__item" bindtap="onGoSign">
    <text class="quick-actions__icon">📅</text>
    <text class="quick-actions__label">每日签到</text>
    <text class="quick-actions__reward">+5积分</text>
  </view>
</view>

<!-- ③ 获取积分方式 -->
<view class="section">
  <view class="section__title">获取积分方式</view>
  <view class="earn-list">
    <block wx:for="{{ruleDesc.earnList}}" wx:key="scene">
      <view class="earn-item {{item.isConsume ? 'earn-item--consume' : ''}}">
        <view class="earn-item__left">
          <view class="earn-item__scene">{{item.scene}}</view>
          <view class="earn-item__remark" wx:if="{{item.remark}}">{{item.remark}}</view>
        </view>
        <view class="earn-item__right">
          <view class="earn-item__reward {{item.isConsume ? 'text-gray' : 'text-orange'}}">
            {{item.reward}}
          </view>
          <view class="earn-item__limit">{{item.limit}}</view>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- ④ 积分明细记录（✅ 修复：真实显示获得+消耗双轨记录） -->
<view class="section">
  <view class="section__title">积分明细</view>

  <view wx:if="{{recordList.length === 0}}" class="record-empty">
    <text>暂无积分记录，快去签到赚积分吧～</text>
  </view>

  <view class="record-list" wx:else>
    <view class="record-item" wx:for="{{recordList}}" wx:key="id">
      <view class="record-item__left">
        <view class="record-item__label">{{item.label}}</view>
        <view class="record-item__time">{{item.time}}</view>
      </view>
      <view class="record-item__points {{item.points > 0 ? 'text-orange' : 'text-gray'}}">
        {{item.points > 0 ? '+' : ''}}{{item.points}}
      </view>
    </view>
  </view>
</view>

<!-- ⑤ 积分规则弹窗 -->
<view class="modal-mask" wx:if="{{showRuleModal}}" bindtap="onCloseRule">
  <view class="modal-box" catchtap="stopProp">
    <view class="modal-box__title">积分规则说明</view>

    <scroll-view scroll-y class="modal-box__scroll">
      <!-- 基础规则 -->
      <view class="rule-section">
        <view class="rule-section__title">基础规则</view>
        <view wx:for="{{ruleDesc.baseRules}}" wx:key="index" class="rule-section__item">
          · {{item}}
        </view>
      </view>

      <!-- 获取明细 -->
      <view class="rule-section">
        <view class="rule-section__title">积分获取明细</view>
        <view class="rule-table">
          <view class="rule-table__head">
            <text class="col-scene">场景</text>
            <text class="col-reward">奖励</text>
            <text class="col-limit">限制</text>
          </view>
          <view
            class="rule-table__row"
            wx:for="{{ruleDesc.earnList}}"
            wx:key="scene"
            wx:for-item="row">
            <text class="col-scene">{{row.scene}}</text>
            <text class="col-reward {{row.isConsume ? 'text-gray' : 'text-orange'}}">
              {{row.reward}}
            </text>
            <text class="col-limit">{{row.limit}}</text>
          </view>
        </view>
      </view>

      <!-- 套餐消耗 -->
      <view class="rule-section">
        <view class="rule-section__title">招聘/租房发布套餐</view>
        <view class="pkg-list">
          <view class="pkg-item" wx:for="{{publishPackages}}" wx:key="id">
            <text class="pkg-item__name">{{item.name}}</text>
            <text class="pkg-item__price">{{item.cashPriceStr}} / {{item.pointsPriceStr}}</text>
          </view>
        </view>
        <view class="rule-section__title" style="margin-top:16rpx;">置顶套餐</view>
        <view class="pkg-list">
          <view class="pkg-item" wx:for="{{topPackages}}" wx:key="id">
            <text class="pkg-item__name">{{item.name}}</text>
            <text class="pkg-item__price">{{item.cashPriceStr}} / {{item.pointsPriceStr}}</text>
          </view>
        </view>
        <view class="coupon-tip">🎫 {{ruleDesc.consumeList.couponTip}}</view>
      </view>
    </scroll-view>

    <view class="modal-box__close" bindtap="onCloseRule">我知道了</view>
  </view>
</view>

</view>
