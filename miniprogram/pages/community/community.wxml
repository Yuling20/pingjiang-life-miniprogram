<!--pages/community/community.wxml-->
<view class="page-wrap">

<!-- 顶部搜索栏 -->
<view class="top-bar">
  <view class="search-box" bindtap="goSearch">
    <text class="search-icon">🔍</text>
    <text class="search-ph">搜索平江话题、帖子...</text>
  </view>
  <view class="post-btn" bindtap="goPublish">
    <text class="post-btn-text">+ 发帖</text>
  </view>
</view>

<!-- 话题分类 Tab -->
<scroll-view class="tab-scroll" scroll-x enable-flex>
  <view class="tab-list">
    <view
      class="tab-item {{activeTab === index ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      bindtap="switchTab"
      data-index="{{index}}"
    >
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>
</scroll-view>

<!-- 帖子列表 -->
<view class="post-list">
  <view
    class="post-card"
    wx:for="{{posts}}"
    wx:key="id"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <!-- 帖子头部：头像 + 昵称 + 时间 -->
    <view class="card-header">
      <view
        class="author-info"
        catchtap="goUser"
        data-id="{{item.userId}}"
      >
        <image class="author-avatar" src="{{item.avatar}}" mode="aspectFill"/>
        <view class="author-meta">
          <text class="author-name">{{item.nickname}}</text>
          <text class="post-time">{{item.time}}</text>
        </view>
      </view>
      <!-- 置顶标签 -->
      <view class="top-tag" wx:if="{{item.isTop}}">
        <text class="top-tag-text">置顶</text>
      </view>
      <!-- 话题标签 -->
      <view class="topic-tag" wx:if="{{item.topic}}">
        <text class="topic-tag-text"># {{item.topic}}</text>
      </view>
    </view>

    <!-- 帖子正文 -->
    <text class="post-content">{{item.content}}</text>

    <!-- 图片缩略（最多展示3张） -->
    <view class="img-grid" wx:if="{{item.images.length > 0}}">
      <image
        class="grid-img grid-img-{{item.images.length > 3 ? 3 : item.images.length}}"
        wx:for="{{item.images}}"
        wx:for-item="img"
        wx:key="index"
        wx:if="{{index < 3}}"
        src="{{img}}"
        mode="aspectFill"
        catchtap="previewImg"
        data-src="{{img}}"
        data-list="{{item.images}}"
      />
      <!-- 超过3张显示数量角标 -->
      <view class="img-more" wx:if="{{item.images.length > 3}}">
        <text class="img-more-text">+{{item.images.length - 3}}</text>
      </view>
    </view>

    <!-- 互动数据栏 -->
    <view class="card-footer">
      <view class="footer-item">
        <text class="footer-icon">🗨️</text>
        <text class="footer-num">{{item.comments}} 评论</text>
      </view>
      <view
        class="footer-item"
        catchtap="toggleLike"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <text class="footer-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
        <text class="footer-num {{item.isLiked ? 'liked' : ''}}">{{item.likes}}</text>
      </view>
      <view class="footer-item" catchtap="sharePost" data-item="{{item}}">
        <text class="footer-icon">↗️</text>
        <text class="footer-num">转发</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{posts.length === 0 && !isLoading}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无帖子，来发第一帖吧！</text>
    <view class="empty-post-btn" bindtap="goPublish">
      <text class="empty-post-text">+ 立即发帖</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="load-tip" wx:if="{{isLoading}}">
    <text class="load-text">加载中...</text>
  </view>
  <view class="load-tip" wx:if="{{!hasMore && posts.length > 0 && !isLoading}}">
    <text class="load-text">— 已经到底了 —</text>
  </view>

  <!-- 底部安全距离 -->
  <view style="height: 120rpx;"/>
</view>

<!-- 悬浮发帖按钮 -->
<view class="fab" bindtap="goPublish">
  <text class="fab-icon">✏️</text>
</view>

</view>
