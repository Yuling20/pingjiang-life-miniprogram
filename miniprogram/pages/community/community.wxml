<!-- pages/community/community.wxml -->
<view class="container">

<!-- 顶部搜索栏 -->
<view class="search-bar">
  <view class="search-input-wrap">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索帖子内容..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="onSearchConfirm"
    />
    <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</text>
  </view>
</view>

<!-- 分类标签栏：全部/公告/美食/活动/生活/求助 -->
<scroll-view class="tab-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
  <view class="tab-list">
    <view
      wx:for="{{tabs}}"
      wx:key="index"
      class="tab-item {{currentTab === index ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      {{item}}
      <view class="tab-underline" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>
</scroll-view>

<!-- 帖子列表 -->
<scroll-view
  class="post-list"
  scroll-y="true"
  bindscrolltolower="onScrollToLower"
  refresher-enabled="true"
  refresher-triggered="{{isRefreshing}}"
  bindrefresherrefresh="onRefresh"
>
  <!-- 无结果提示 -->
  <view class="empty-tip" wx:if="{{filteredPosts.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无相关帖子</text>
  </view>

  <!-- 帖子卡片 -->
  <view
    class="post-card"
    wx:for="{{filteredPosts}}"
    wx:key="id"
    bindtap="onPostTap"
    data-id="{{item.id}}"
  >
    <!-- 卡片头部 -->
    <view class="card-header">
      <view class="avatar-wrap">
        <text class="avatar-emoji">{{item.avatarEmoji}}</text>
      </view>
      <view class="user-info">
        <text class="username">{{item.userName}}</text>
        <text class="post-time">{{item.time}}</text>
      </view>
      <view class="category-tag cat-{{item.category}}">{{item.categoryName}}</view>
    </view>

    <!-- 卡片内容 -->
    <view class="card-body">
      <text class="post-title">{{item.title}}</text>
      <text class="post-content">{{item.content}}</text>

      <!-- 图片占位（有图片时显示彩色色块） -->
      <view class="img-grid" wx:if="{{item.images && item.images.length > 0}}">
        <view
          class="img-placeholder"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="index"
          style="background:{{img.color}}"
        >
          <text class="img-label">{{img.label}}</text>
        </view>
      </view>
    </view>

    <!-- 卡片底部操作栏 -->
    <view class="card-footer" catchtap="onFooterTap">
      <!-- 点赞 -->
      <view
        class="action-btn {{item.isLiked ? 'liked' : ''}}"
        catchtap="onLikeTap"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
        <text class="action-count">{{item.likeCount}}</text>
      </view>

      <!-- 评论 -->
      <view
        class="action-btn"
        catchtap="onCommentTap"
        data-id="{{item.id}}"
      >
        <text class="action-icon">💬</text>
        <text class="action-count">{{item.commentCount}}</text>
      </view>

      <!-- 分享 -->
      <view
        class="action-btn"
        catchtap="onShareBtnTap"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <text class="action-icon">↗️</text>
        <text class="action-count">分享</text>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{filteredPosts.length > 0}}">
    <text>{{hasMore ? '加载中...' : '— 已经到底啦 —'}}</text>
  </view>
</scroll-view>

<!-- 发帖按钮 -->
<view class="fab-btn" bindtap="onPublish">
  <text class="fab-icon">✏️</text>
</view>

<!-- 分享弹窗遮罩 -->
<view class="share-mask" wx:if="{{showShareMenu}}" bindtap="onCloseShare"></view>

<!-- 分享菜单 -->
<view class="share-menu {{showShareMenu ? 'share-menu-show' : ''}}">
  <view class="share-menu-title">分享到</view>
  <view class="share-options">
    <!-- 发给好友/群聊 -->
    <view class="share-option" bindtap="onShareToFriend">
      <view class="share-opt-icon friend-icon">
        <text>👥</text>
      </view>
      <text class="share-opt-label">发给好友/群聊</text>
    </view>

    <!-- 生成分享海报 -->
    <view class="share-option" bindtap="onSharePoster">
      <view class="share-opt-icon poster-icon">
        <text>🖼️</text>
      </view>
      <text class="share-opt-label">生成分享海报</text>
    </view>

    <!-- 分享到朋友圈 -->
    <view class="share-option" bindtap="onShareMoments">
      <view class="share-opt-icon moments-icon">
        <text>🌐</text>
      </view>
      <text class="share-opt-label">分享到朋友圈</text>
    </view>
  </view>
  <view class="share-cancel" bindtap="onCloseShare">取消</view>
</view>

<!-- 实名授权弹窗 -->
<view class="auth-mask" wx:if="{{showAuthModal}}"></view>
<view class="auth-modal" wx:if="{{showAuthModal}}">
  <view class="auth-icon">🔐</view>
  <view class="auth-title">实名授权</view>
  <view class="auth-desc">分享前需要完成实名认证，保障社区安全</view>
  <view class="auth-btns">
    <view class="auth-btn-cancel" bindtap="onAuthCancel">取消</view>
    <view class="auth-btn-confirm" bindtap="onAuthConfirm">去认证</view>
  </view>
</view>

</view>
