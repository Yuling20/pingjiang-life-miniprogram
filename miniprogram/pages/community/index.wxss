/* pages/community/index.wxss */

.page-container {
  min-height: 100vh;
  background-color: #FFF8F0;
  padding-bottom: 120rpx;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0E6D8;
  padding: 0 10rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #999999;
}

.tab-active .tab-text {
  color: #8B5E3C;
  font-weight: bold;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #8B5E3C;
  border-radius: 3rpx;
}

/* 帖子列表 */
.post-list {
  padding: 16rpx 20rpx;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #CCBBAA;
}

/* 帖子卡片 */
.post-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(139,94,60,0.08);
}

/* 帖子头部 */
.post-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  background-color: #FFF3E8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.avatar {
  font-size: 40rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 24rpx;
  color: #AAAAAA;
}

.post-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 帖子内容 */
.post-body {
  margin-bottom: 20rpx;
}

.post-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.post-content {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  /* 最多显示2行 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 底部互动 */
.post-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EDE0;
}

.footer-left {
  display: flex;
  flex-direction: row;
}

.action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 36rpx;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-count {
  font-size: 28rpx;
  color: #999999;
}

.share-btn {
  font-size: 28rpx;
  color: #8B5E3C;
}

/* 发帖悬浮按钮 */
.publish-btn {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  background: linear-gradient(135deg, #8B5E3C, #C4956A);
  border-radius: 60rpx;
  padding: 20rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(139,94,60,0.4);
  z-index: 100;
}

.publish-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.publish-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
}
