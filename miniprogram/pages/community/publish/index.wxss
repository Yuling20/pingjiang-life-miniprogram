/* pages/community/publish/index.wxss */
page { background: #F5F0E8; }

.page-wrap { min-height: 100vh; padding-bottom: 60rpx; }

/* 顶部操作栏 */
.top-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #FFF8EE; padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #F0E5D8;
  position: sticky; top: 0; z-index: 10;
}
.cancel-btn { font-size: 30rpx; color: #999; padding: 8rpx 0; }
.page-title { font-size: 34rpx; color: #333; font-weight: bold; }
.submit-btn {
  font-size: 30rpx; color: #FFFFFF;
  background: #D4820A; padding: 12rpx 36rpx;
  border-radius: 40rpx; font-weight: bold;
}
.submit-disabled { background: #CCCCCC; }

/* 授权提示条 */
.auth-bar {
  display: flex; align-items: center;
  background: #FFF3CD; padding: 18rpx 28rpx;
  border-bottom: 2rpx solid #F0E5D8;
}
.auth-icon { font-size: 28rpx; margin-right: 10rpx; }
.auth-text { font-size: 26rpx; color: #8B7355; }

/* 正文输入区 */
.content-section {
  background: #FFFFFF; margin: 20rpx; border-radius: 16rpx;
  padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(139,115,85,0.08);
  min-height: 300rpx;
}
.content-input {
  width: 100%; min-height: 240rpx;
  font-size: 32rpx; color: #333; line-height: 1.7;
}
.input-placeholder { color: #BBBBBB; font-size: 32rpx; }
.word-count { text-align: right; margin-top: 16rpx; }
.word-num { font-size: 26rpx; color: #999; }
.word-num.warn { color: #E53935; font-weight: bold; }
.word-total { font-size: 26rpx; color: #BBB; }

/* 通用 Section */
.section {
  background: #FFFFFF; margin: 0 20rpx 20rpx;
  border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(139,115,85,0.08);
}
.section-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.section-label { font-size: 30rpx; color: #333; font-weight: bold; }
.section-hint { font-size: 24rpx; color: #BBBBBB; }

/* 话题标签 */
.tag-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.tag-chip {
  display: flex; align-items: center;
  background: #FFF3E0; border: 2rpx solid #D4820A;
  border-radius: 30rpx; padding: 8rpx 18rpx; gap: 8rpx;
}
.tag-chip-text { font-size: 26rpx; color: #D4820A; }
.tag-del { font-size: 30rpx; color: #D4820A; font-weight: bold; }
.tag-input-wrap { display: flex; align-items: center; gap: 8rpx; }
.tag-input {
  font-size: 26rpx; color: #333;
  background: #F5F0E8; border-radius: 20rpx;
  padding: 8rpx 16rpx; width: 160rpx;
}
.tag-add-btn {
  font-size: 26rpx; color: #D4820A;
  padding: 8rpx 16rpx; background: #FFF3E0;
  border-radius: 20rpx;
}
.hot-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.hot-label { font-size: 26rpx; color: #999; }
.hot-tag {
  font-size: 26rpx; color: #D4820A;
  background: #FFF3E0; padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 图片九宫格 */
.media-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.media-item { position: relative; width: 196rpx; height: 196rpx; }
.media-img { width: 196rpx; height: 196rpx; border-radius: 12rpx; }
.media-del {
  position: absolute; top: -8rpx; right: -8rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #FFF; font-size: 28rpx;
  border-radius: 50%;
}
.media-add {
  width: 196rpx; height: 196rpx; border-radius: 12rpx;
  border: 3rpx dashed #D4820A; background: #FFF8EE;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.media-add-icon { font-size: 60rpx; color: #D4820A; line-height: 1; }
.media-add-text { font-size: 24rpx; color: #D4820A; margin-top: 8rpx; }

/* 视频上传 */
.video-upload-wrap {
  height: 240rpx; border: 3rpx dashed #D4820A;
  border-radius: 16rpx; background: #FFF8EE;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx;
}
.video-add-icon { font-size: 64rpx; color: #D4820A; }
.video-add-text { font-size: 28rpx; color: #D4820A; }
.video-preview-wrap { position: relative; }
.preview-video { width: 100%; height: 360rpx; border-radius: 12rpx; }
.video-del-btn {
  margin-top: 16rpx; text-align: center;
  font-size: 28rpx; color: #E53935;
  padding: 12rpx; background: #FFF0F0; border-radius: 12rpx;
}

/* 发布规范提示 */
.rule-tip {
  display: flex; align-items: flex-start;
  margin: 0 20rpx 20rpx; padding: 20rpx 24rpx;
  background: #FFF8EE; border-radius: 12rpx;
  border: 1rpx solid #F0E5D8;
}
.rule-icon { font-size: 28rpx; margin-right: 10rpx; flex-shrink: 0; }
.rule-text { font-size: 24rpx; color: #8B7355; line-height: 1.6; }
