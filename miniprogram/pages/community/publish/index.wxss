/* pages/community/publish/index.wxss */

/* ══════════════════════════════════════════
   基础容器
   ══════════════════════════════════════════ */
   .page-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #f5f5f5;
    position: relative;
    box-sizing: border-box;
  }
  
  /* ══════════════════════════════════════════
     导航栏
     ══════════════════════════════════════════ */
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 96rpx;
    padding: 0 24rpx;
    background: #ffffff;
    border-bottom: 1rpx solid #f0f0f0;
    position: sticky;
    top: 0;
    z-index: 100;
    flex-shrink: 0;
  }
  
  .nav-back {
    display: flex;
    align-items: center;
    gap: 4rpx;
    padding: 12rpx 16rpx 12rpx 0;
    min-width: 80rpx;
  }
  
  .nav-back-icon {
    font-size: 48rpx;
    color: #333333;
    line-height: 1;
    font-weight: 300;
  }
  
  .nav-back-text {
    font-size: 28rpx;
    color: #333333;
  }
  
  .nav-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    flex: 1;
    text-align: center;
  }
  
  .nav-publish-btn {
    background: #07c160;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 600;
    padding: 14rpx 28rpx;
    border-radius: 32rpx;
    min-width: 100rpx;
    text-align: center;
    transition: opacity 0.2s;
  }
  
  .nav-publish-btn--disabled {
    background: #b2b2b2;
    opacity: 0.8;
  }
  
  .nav-publish-btn--loading {
    background: #07c160;
    opacity: 0.6;
  }
  
  /* ══════════════════════════════════════════
     未实名提示条
     ══════════════════════════════════════════ */
  .verify-tip-bar {
    display: flex;
    align-items: center;
    padding: 18rpx 24rpx;
    background: #fff7e6;
    border-bottom: 1rpx solid #ffd666;
    flex-shrink: 0;
  }
  
  .verify-tip-icon {
    font-size: 28rpx;
    margin-right: 10rpx;
  }
  
  .verify-tip-text {
    flex: 1;
    font-size: 24rpx;
    color: #d46b08;
    line-height: 1.5;
  }
  
  .verify-tip-arrow {
    font-size: 32rpx;
    color: #d46b08;
    margin-left: 8rpx;
  }
  
  /* ══════════════════════════════════════════
     滚动区域
     ══════════════════════════════════════════ */
  .content-scroll {
    flex: 1;
    overflow: hidden;
  }
  
  /* ══════════════════════════════════════════
     通用卡片
     ══════════════════════════════════════════ */
  .section-card {
    background: #ffffff;
    margin: 16rpx 24rpx;
    border-radius: 16rpx;
    padding: 28rpx 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  }
  
  .section-label {
    font-size: 26rpx;
    color: #666666;
    margin-bottom: 18rpx;
    font-weight: 500;
  }
  
  /* ══════════════════════════════════════════
     正文输入
     ══════════════════════════════════════════ */
  .content-textarea {
    width: 100%;
    min-height: 200rpx;
    font-size: 30rpx;
    color: #1a1a1a;
    line-height: 1.7;
    box-sizing: border-box;
  }
  
  .content-placeholder {
    color: #bbbbbb;
    font-size: 30rpx;
  }
  
  .content-count {
    display: flex;
    justify-content: flex-end;
    margin-top: 12rpx;
  }
  
  .count-normal {
    font-size: 22rpx;
    color: #bbbbbb;
  }
  
  .count-warn {
    font-size: 22rpx;
    color: #ff4d4f;
  }
  
  /* ══════════════════════════════════════════
     分类标签
     ══════════════════════════════════════════ */
  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
  }
  
  .category-tag {
    padding: 10rpx 28rpx;
    border-radius: 32rpx;
    font-size: 26rpx;
    color: #555555;
    background: #f5f5f5;
    border: 1rpx solid #e8e8e8;
    transition: all 0.2s;
  }
  
  .category-tag--active {
    background: #e6f7ed;
    color: #07c160;
    border-color: #07c160;
    font-weight: 600;
  }
  
  /* ══════════════════════════════════════════
     话题标签
     ══════════════════════════════════════════ */
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 16rpx;
  }
  
  .topic-item {
    display: flex;
    align-items: center;
    background: #e6f7ed;
    border: 1rpx solid #b7eb8f;
    border-radius: 24rpx;
    padding: 8rpx 18rpx 8rpx 20rpx;
    gap: 8rpx;
  }
  
  .topic-text {
    font-size: 26rpx;
    color: #389e0d;
  }
  
  .topic-remove {
    font-size: 28rpx;
    color: #389e0d;
    line-height: 1;
    padding: 0 2rpx;
  }
  
  .topic-input-row {
    display: flex;
    align-items: center;
    background: #f8f8f8;
    border-radius: 12rpx;
    padding: 14rpx 16rpx;
    gap: 8rpx;
  }
  
  .topic-hash {
    font-size: 28rpx;
    color: #07c160;
    font-weight: 600;
  }
  
  .topic-input {
    flex: 1;
    font-size: 28rpx;
    color: #1a1a1a;
    height: 44rpx;
  }
  
  .topic-add-btn {
    font-size: 24rpx;
    color: #07c160;
    font-weight: 600;
    padding: 6rpx 16rpx;
    border: 1rpx solid #07c160;
    border-radius: 20rpx;
  }
  
  /* ══════════════════════════════════════════
     媒体网格
     ══════════════════════════════════════════ */
  .media-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
  }
  
  .media-item {
    width: 196rpx;
    height: 196rpx;
    border-radius: 12rpx;
    overflow: hidden;
    position: relative;
    background: #f0f0f0;
  }
  
  .media-thumb {
    width: 100%;
    height: 100%;
  }
  
  .media-video-badge {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52rpx;
  }
  
  .media-video-icon {
    font-size: 32rpx;
    color: #ffffff;
  }
  
  .media-remove {
    position: absolute;
    top: 6rpx;
    right: 6rpx;
    width: 44rpx;
    height: 44rpx;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28rpx;
    color: #ffffff;
    line-height: 44rpx;
    text-align: center;
  }
  
  .media-add-group {
    display: flex;
    gap: 16rpx;
  }
  
  .media-add-btn {
    width: 196rpx;
    height: 196rpx;
    border-radius: 12rpx;
    border: 2rpx dashed #d9d9d9;
    background: #fafafa;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10rpx;
  }
  
  .media-add-icon {
    font-size: 52rpx;
    line-height: 1;
  }
  
  .media-add-label {
    font-size: 24rpx;
    color: #999999;
  }
  
  /* ══════════════════════════════════════════
     安全底部
     ══════════════════════════════════════════ */
  .safe-bottom {
    height: 48rpx;
  }
  
  /* ══════════════════════════════════════════
     违规提示弹窗
     ══════════════════════════════════════════ */
  .modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
  }
  
  .modal-box {
    width: 600rpx;
    background: #ffffff;
    border-radius: 24rpx;
    padding: 48rpx 40rpx 36rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16rpx;
  }
  
  .modal-icon {
    font-size: 80rpx;
    line-height: 1;
  }
  
  .modal-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #1a1a1a;
  }
  
  .modal-desc {
    font-size: 26rpx;
    color: #555555;
    text-align: center;
    line-height: 1.7;
  }
  
  .modal-hits {
    width: 100%;
    background: #fff2f0;
    border: 1rpx solid #ffccc7;
    border-radius: 12rpx;
    padding: 16rpx 20rpx;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8rpx;
  }
  
  .modal-hits-label {
    font-size: 24rpx;
    color: #cf1322;
    font-weight: 600;
  }
  
  .modal-hits-words {
    font-size: 24rpx;
    color: #cf1322;
    flex: 1;
    word-break: break-all;
  }
  
  .modal-rule {
    font-size: 22rpx;
    color: #999999;
    text-align: center;
    line-height: 1.6;
    padding: 0 8rpx;
  }
  
  .modal-btn {
    margin-top: 8rpx;
    width: 100%;
    height: 80rpx;
    background: #07c160;
    border-radius: 40rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
  }
  