<!-- pages/community/publish/index.wxml -->
<view class="page-container">

<!-- ══════════════ 导航栏 ══════════════ -->
<view class="nav-bar">
  <view class="nav-back" bindtap="onBack">
    <text class="nav-back-icon">‹</text>
    <text class="nav-back-text">返回</text>
  </view>
  <text class="nav-title">发布帖子</text>
  <!-- 发布按钮：未实名时显示锁定态 -->
  <view
    class="nav-publish-btn {{!isVerified ? 'nav-publish-btn--disabled' : ''}} {{publishing ? 'nav-publish-btn--loading' : ''}}"
    bindtap="onPublish"
  >
    <text wx:if="{{publishing}}">发布中…</text>
    <text wx:elif="{{!isVerified}}">🔒 发布</text>
    <text wx:else>发布</text>
  </view>
</view>

<!-- ══════════════ 未实名提示条 ══════════════ -->
<view class="verify-tip-bar" wx:if="{{verifyChecked && !isVerified}}" bindtap="goVerify">
  <text class="verify-tip-icon">⚠️</text>
  <text class="verify-tip-text">您尚未完成实名认证，点击前往认证后方可发布</text>
  <text class="verify-tip-arrow">›</text>
</view>

<!-- ══════════════ 内容区（可滚动） ══════════════ -->
<scroll-view class="content-scroll" scroll-y>

  <!-- 正文输入 -->
  <view class="section-card">
    <textarea
      class="content-textarea"
      placeholder="分享你的生活、求助邻里、发布二手…"
      placeholder-class="content-placeholder"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="{{maxContentLen}}"
      auto-height
      show-confirm-bar="{{false}}"
    />
    <view class="content-count">
      <text class="{{content.length > maxContentLen * 0.9 ? 'count-warn' : 'count-normal'}}">
        {{content.length}}/{{maxContentLen}}
      </text>
    </view>
  </view>

  <!-- 分类选择 -->
  <view class="section-card">
    <view class="section-label">📂 选择分类（可选）</view>
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="index"
        class="category-tag {{selectedCategory === item ? 'category-tag--active' : ''}}"
        data-cat="{{item}}"
        bindtap="selectCategory"
      >{{item}}</view>
    </view>
  </view>

  <!-- 话题标签 -->
  <view class="section-card">
    <view class="section-label">🏷️ 添加话题（最多5个）</view>
    <view class="topic-list">
      <view
        wx:for="{{topics}}"
        wx:key="index"
        class="topic-item"
      >
        <text class="topic-text">{{item}}</text>
        <text class="topic-remove" data-index="{{index}}" bindtap="removeTopic">×</text>
      </view>
    </view>
    <view class="topic-input-row" wx:if="{{topics.length < 5}}">
      <text class="topic-hash">#</text>
      <input
        class="topic-input"
        placeholder="输入话题，回车添加"
        value="{{topicInput}}"
        bindinput="onTopicInput"
        bindconfirm="addTopic"
        maxlength="20"
      />
      <view class="topic-add-btn" bindtap="addTopic">添加</view>
    </view>
  </view>

  <!-- 媒体上传 -->
  <view class="section-card">
    <view class="section-label">🖼️ 图片 / 视频（最多{{maxMedia}}个）</view>
    <view class="media-grid">

      <!-- 已选媒体预览 -->
      <view
        wx:for="{{mediaList}}"
        wx:key="index"
        class="media-item"
        data-index="{{index}}"
        bindtap="previewMedia"
      >
        <image
          class="media-thumb"
          src="{{item.thumbPath}}"
          mode="aspectFill"
        />
        <!-- 视频标识 -->
        <view class="media-video-badge" wx:if="{{item.type === 'video'}}">
          <text class="media-video-icon">▶</text>
        </view>
        <!-- 删除按钮 -->
        <view
          class="media-remove"
          data-index="{{index}}"
          catchtap="removeMedia"
        >×</view>
      </view>

      <!-- 添加按钮组 -->
      <view class="media-add-group" wx:if="{{mediaList.length < maxMedia}}">
        <!-- 添加图片 -->
        <view class="media-add-btn" bindtap="chooseImage">
          <text class="media-add-icon">📷</text>
          <text class="media-add-label">图片</text>
        </view>
        <!-- 添加视频 -->
        <view class="media-add-btn" bindtap="chooseVideo">
          <text class="media-add-icon">🎬</text>
          <text class="media-add-label">视频</text>
        </view>
      </view>

    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom" />

</scroll-view>

<!-- ══════════════ 违规内容提示弹窗 ══════════════ -->
<view class="modal-mask" wx:if="{{showSensitiveTip}}" bindtap="closeSensitiveTip">
  <view class="modal-box" catchtap="">
    <view class="modal-icon">🚫</view>
    <view class="modal-title">内容含违规信息</view>
    <view class="modal-desc">
      <text>在「{{sensitiveSource}}」中检测到违规内容，已自动清除。\n请勿发布联系方式、导流词或违规内容。</text>
    </view>
    <view class="modal-hits" wx:if="{{sensitiveHitWords.length > 0}}">
      <text class="modal-hits-label">涉及词汇：</text>
      <text class="modal-hits-words">{{sensitiveHitWords.join('、')}}</text>
    </view>
    <view class="modal-rule">违规内容包括：手机号、微信号、QQ号、「加微」「私聊」「扫我」等导流词</view>
    <view class="modal-btn" bindtap="closeSensitiveTip">我知道了</view>
  </view>
</view>

</view>
