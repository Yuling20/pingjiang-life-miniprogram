<!--pages/community/user/index.wxml-->
<view class="page-wrap">

<!-- 顶部用户信息卡片 -->
<view class="profile-card">

  <!-- 背景装饰条 -->
  <view class="profile-bg"/>

  <!-- 头像区域 -->
  <view class="avatar-section">
    <view class="avatar-wrap">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill"/>
      <!-- VIP角标占位 -->
      <view class="vip-badge" wx:if="{{user.isVip}}">
        <text class="vip-text">V</text>
      </view>
    </view>
    <!-- 认证标签 -->
    <view class="user-tag-row">
      <text class="user-tag" wx:if="{{user.badge}}">{{user.badge}}</text>
      <text class="user-tag vip-tag" wx:if="{{user.isVip}}">VIP会员</text>
    </view>
  </view>

  <!-- 用户基础信息 -->
  <view class="user-info-section">
    <text class="user-nickname">{{user.nickname}}</text>
    <text class="user-id">平江号：{{user.uid}}</text>
    <text class="user-bio" wx:if="{{user.bio}}">{{user.bio}}</text>
    <text class="user-bio no-bio" wx:else>这个人很懒，什么都没写~</text>
  </view>

  <!-- 数据统计栏 -->
  <view class="stats-row">
    <view class="stat-item" bindtap="goFollow" data-tab="0" data-id="{{user.userId}}">
      <text class="stat-num">{{user.followCount}}</text>
      <text class="stat-label">关注</text>
    </view>
    <view class="stat-divider"/>
    <view class="stat-item" bindtap="goFollow" data-tab="1" data-id="{{user.userId}}">
      <text class="stat-num">{{user.fansCount}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-divider"/>
    <view class="stat-item">
      <text class="stat-num">{{user.postCount}}</text>
      <text class="stat-label">帖子</text>
    </view>
    <view class="stat-divider"/>
    <view class="stat-item">
      <text class="stat-num">{{user.likedCount}}</text>
      <text class="stat-label">获赞</text>
    </view>
  </view>

  <!-- 操作按钮区 -->
  <view class="action-row" wx:if="{{!isSelf}}">
    <!-- 关注/取关按钮 -->
    <view
      class="action-btn-main {{user.isFollowed ? 'btn-followed' : 'btn-follow'}}"
      bindtap="toggleFollow"
    >
      <text class="action-btn-text">
        {{user.isFollowed ? '✓ 已关注' : '+ 关注'}}
      </text>
    </view>
    <!-- 私信按钮 -->
    <view class="action-btn-sub" bindtap="goMessage">
      <text class="action-btn-sub-icon">💬</text>
      <text class="action-btn-sub-text">私信</text>
    </view>
  </view>

  <!-- 自己的主页显示编辑按钮（预留） -->
  <view class="action-row" wx:else>
    <view class="action-btn-edit" bindtap="editProfile">
      <text class="action-btn-text">编辑资料（预留）</text>
    </view>
  </view>

</view>

<!-- 动态列表标题 -->
<view class="posts-bar">
  <text class="posts-bar-title">TA 的动态</text>
  <text class="posts-bar-count">共 {{posts.length}} 条</text>
</view>

<!-- 动态列表 -->
<view class="posts-list">
  <view class="post-card" wx:for="{{posts}}" wx:key="id">

    <!-- 帖子头部 -->
    <view class="post-header">
      <text class="post-time">{{item.time}}</text>
      <!-- 举报入口 -->
      <view class="post-report" bindtap="reportPost" data-id="{{item.id}}">
        <text class="post-report-text">🚩</text>
      </view>
    </view>

    <!-- 帖子正文 -->
    <text class="post-content">{{item.content}}</text>

    <!-- 话题标签 -->
    <view class="tag-row" wx:if="{{item.tags.length > 0}}">
      <text
        class="tag-chip"
        wx:for="{{item.tags}}"
        wx:for-item="tag"
        wx:key="index"
      >#{{tag}}</text>
    </view>

    <!-- 图片缩略 -->
    <view class="img-row" wx:if="{{item.images.length > 0}}">
      <image
        class="thumb-img thumb-img-{{item.images.length}}"
        wx:for="{{item.images}}"
        wx:for-item="img"
        wx:key="index"
        src="{{img}}"
        mode="aspectFill"
        bindtap="previewImg"
        data-src="{{img}}"
        data-list="{{item.images}}"
      />
    </view>

    <!-- 帖子互动数据 -->
    <view class="post-footer">
      <view class="footer-item" bindtap="goComment" data-id="{{item.id}}">
        <text class="footer-icon">🗨️</text>
        <text class="footer-num">{{item.comments}}</text>
      </view>
      <view class="footer-item" bindtap="toggleLike" data-id="{{item.id}}" data-index="{{index}}">
        <text class="footer-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
        <text class="footer-num {{item.isLiked ? 'liked' : ''}}">{{item.likes}}</text>
      </view>
      <view class="footer-item" bindtap="sharePost" data-item="{{item}}">
        <text class="footer-icon">↗️</text>
        <text class="footer-num">转发</text>
      </view>
    </view>

  </view>

  <!-- 空动态提示 -->
  <view class="empty-tip" wx:if="{{posts.length === 0 && !isLoading}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">TA 还没有发布任何动态</text>
  </view>

  <!-- 加载状态 -->
  <view class="load-tip" wx:if="{{isLoading}}">
    <text class="load-text">加载中...</text>
  </view>
  <view class="load-tip" wx:if="{{!hasMore && posts.length > 0}}">
    <text class="load-text">— 已经到底了 —</text>
  </view>

  <!-- 底部安全距离 -->
  <view style="height: 60rpx;"/>
</view>

</view>
