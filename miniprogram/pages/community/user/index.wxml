<!-- pages/community/user/index.wxml -->
<!-- 修复Bug1(shturl.) Bug2/3(绑定) + 关注/粉丝弹窗 + 浅色背景 + 实名分享 -->
<view class="profile-page">

<!-- ══ 顶部背景区 ═══════════════════════════════════════════ -->
<view class="profile-top">

  <!-- VIP视频背景 -->
  <video
    wx:if="{{profileBg && bgIsVideo}}"
    class="profile-bg-media"
    src="{{profileBg}}"
    autoplay loop muted
    show-play-btn="{{false}}"
    controls="{{false}}"
    objectFit="cover"
  />
  <!-- VIP图片背景 -->
  <image
    wx:elif="{{profileBg && !bgIsVideo}}"
    class="profile-bg-media"
    src="{{profileBg}}"
    mode="aspectFill"
  />
  <!-- 默认浅色渐变（问题2修复） -->
  <view class="profile-bg-gradient" wx:else></view>

  <!-- 遮罩过渡层 -->
  <view class="profile-top-mask"></view>

  <!-- 状态栏占位 -->
  <view class="status-bar-holder"></view>

  <!-- 顶部操作栏：返回 + 换背景 -->
  <view class="top-nav-bar">
    <view class="nav-back-btn" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="change-bg-btn" wx:if="{{isSelf}}" bindtap="onChangeBg">
      <text class="change-bg-icon">🖼</text>
      <text class="change-bg-text">{{isVip ? '换背景' : '背景(VIP)'}}</text>
    </view>
  </view>

  <!-- 头像悬浮右下角（朋友圈风格） -->
  <view class="avatar-float">
    <image class="avatar-float-img" src="{{avatarUrl}}" mode="aspectFill"/>
    <view class="vip-crown-tag" wx:if="{{isVip}}">
      <text class="vip-crown-text">👑VIP</text>
    </view>
  </view>

</view>

<!-- ══ 用户信息区 ════════════════════════════════════════════ -->
<view class="info-block">

  <view class="info-nick-row">
    <text class="info-nick">{{nickName || '平江用户'}}</text>
  </view>
  <view class="info-id-row">
    <text class="info-id">平江号：{{userId || '未设置'}}</text>
  </view>
  <text class="info-bio">{{bio || '这个人很懒，还没有填写简介～'}}</text>

  <!-- 统计行（问题3：关注/粉丝可点击） -->
  <view class="stats-row">
    <view class="stat-item" bindtap="onShowFollow">
      <text class="stat-num">{{followCount}}</text>
      <text class="stat-label">关注</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat-item" bindtap="onShowFans">
      <text class="stat-num">{{fansCount}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat-item">
      <text class="stat-num">{{postCount}}</text>
      <text class="stat-label">帖子</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat-item">
      <text class="stat-num">{{likeCount}}</text>
      <text class="stat-label">获赞</text>
    </view>
  </view>

  <!-- 访客按钮（仅自己主页） -->
  <view class="func-btn-row" wx:if="{{isSelf}}">
    <view class="func-btn" bindtap="onShowVisitors">
      <text class="func-btn-icon">👁</text>
      <text class="func-btn-label">谁看过我</text>
      <view class="vip-lock-badge" wx:if="{{!isVip}}">
        <text class="vip-lock-text">VIP</text>
      </view>
    </view>
  </view>

</view>

<!-- ══ 动态列表 ═════════════════════════════════════════════ -->
<view class="posts-section">

  <view class="posts-title-bar">
    <view class="posts-title-left">
      <view class="posts-dot"></view>
      <text class="posts-title-text">TA的动态</text>
    </view>
    <text class="posts-count-text" wx:if="{{postList.length > 0}}">共{{postList.length}}条</text>
  </view>

  <!-- 空状态 -->
  <view class="posts-empty" wx:if="{{!isLoading && postList.length === 0}}">
    <text class="posts-empty-icon">📭</text>
    <text class="posts-empty-text">还没有发布过帖子</text>
  </view>

  <!-- 加载中 -->
  <view class="posts-empty" wx:if="{{isLoading}}">
    <text class="posts-empty-text">加载中...</text>
  </view>

  <!-- 帖子列表 -->
  <view class="post-card" wx:for="{{postList}}" wx:key="id">

    <!-- 头部：头像 + 昵称 + 时间 -->
    <view class="post-card-head" bindtap="goPostDetail" data-id="{{item.id}}">
      <image class="post-card-avatar" src="{{avatarUrl}}" mode="aspectFill"/>
      <view class="post-card-meta">
        <text class="post-card-nick">{{nickName}}</text>
        <text class="post-card-time">{{item.timeLabel}}</text>
      </view>
    </view>

    <!-- 正文 -->
    <view bindtap="goPostDetail" data-id="{{item.id}}">
      <text class="post-body-text">{{item.content || item.title}}</text>

      <!-- 图片 -->
      <view class="post-imgs-wrap" wx:if="{{item.images && item.images.length > 0}}">
        <image
          wx:for="{{item.images}}"
          wx:key="*this"
          wx:for-item="img"
          class="post-img post-img--{{item.images.length === 1 ? 'single' : 'multi'}}"
          src="{{img}}"
          mode="aspectFill"
        />
      </view>

      <!-- 标签 -->
      <view class="post-tags-wrap" wx:if="{{item.tags && item.tags.length > 0}}">
        <text
          class="post-tag"
          wx:for="{{item.tags}}"
          wx:key="*this"
          wx:for-item="tag"
        >#{{tag}}</text>
      </view>
    </view>

    <!-- 互动栏 -->
    <view class="post-action-bar">

      <!-- 点赞（需实名；问题6：自己的帖子不加积分） -->
      <view class="action-btn" catchtap="onLikePost" data-idx="{{index}}">
        <text class="action-icon">{{item.liked ? '❤️' : '🤍'}}</text>
        <text class="action-count">{{item.likeCount || 0}}</text>
      </view>

      <!-- 评论（跳详情，详情页控制实名） -->
      <view class="action-btn" catchtap="goPostDetail" data-id="{{item.id}}">
        <text class="action-icon">💬</text>
        <text class="action-count">{{item.commentCount || 0}}</text>
      </view>

      <!-- 分享朋友圈（需实名，+10积分，每日3次） -->
      <view class="action-btn" catchtap="onShareToMoments" data-idx="{{index}}">
        <text class="action-icon">🔄</text>
        <text class="action-count">朋友圈</text>
      </view>

      <!-- 好友分享：已实名用 open-type，未实名拦截（问题5） -->
      <button
        wx:if="{{isAuthed}}"
        class="action-btn action-share-btn"
        open-type="share"
        data-idx="{{index}}"
      >
        <text class="action-icon">↗</text>
        <text class="action-count">好友</text>
      </button>
      <view wx:else class="action-btn" catchtap="onNeedAuthShare">
        <text class="action-icon">↗</text>
        <text class="action-count">好友</text>
      </view>

    </view>
  </view>

</view>

<!-- ══ 关注列表弹窗（问题3） ══════════════════════════════════ -->
<view class="modal-mask" wx:if="{{showFollowModal}}"
  bindtap="onCloseFollow" catchtouchmove="stopProp">
  <view class="list-modal" catchtap="stopProp">
    <view class="list-modal-header">
      <text class="list-modal-title">我的关注</text>
      <text class="list-modal-close" bindtap="onCloseFollow">✕</text>
    </view>
    <!-- 空状态 -->
    <view class="list-modal-empty" wx:if="{{followList.length === 0}}">
      <text class="list-empty-icon">🔍</text>
      <text class="list-empty-text">还没有关注任何人</text>
      <text class="list-empty-sub">去贴吧逛逛，关注感兴趣的人</text>
    </view>
    <!-- 列表 -->
    <scroll-view scroll-y class="list-modal-scroll" wx:else>
      <view class="user-row" wx:for="{{followList}}" wx:key="id">
        <image class="user-row-avatar"
          src="{{item.avatarUrl || '/images/avatars男/avatar01.png'}}"
          mode="aspectFill"/>
        <view class="user-row-info">
          <text class="user-row-nick">{{item.nickName || '平江用户'}}</text>
          <text class="user-row-bio">{{item.bio || '暂无简介'}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="list-modal-footer" bindtap="onCloseFollow">关闭</view>
  </view>
</view>

<!-- ══ 粉丝列表弹窗（问题3） ══════════════════════════════════ -->
<view class="modal-mask" wx:if="{{showFansModal}}"
  bindtap="onCloseFans" catchtouchmove="stopProp">
  <view class="list-modal" catchtap="stopProp">
    <view class="list-modal-header">
      <text class="list-modal-title">我的粉丝</text>
      <text class="list-modal-close" bindtap="onCloseFans">✕</text>
    </view>
    <!-- 空状态 -->
    <view class="list-modal-empty" wx:if="{{fansList.length === 0}}">
      <text class="list-empty-icon">💫</text>
      <text class="list-empty-text">还没有粉丝</text>
      <text class="list-empty-sub">多发优质帖子，粉丝自然来</text>
    </view>
    <!-- 列表 -->
    <scroll-view scroll-y class="list-modal-scroll" wx:else>
      <view class="user-row" wx:for="{{fansList}}" wx:key="id">
        <image class="user-row-avatar"
          src="{{item.avatarUrl || '/images/avatars男/avatar01.png'}}"
          mode="aspectFill"/>
        <view class="user-row-info">
          <text class="user-row-nick">{{item.nickName || '平江用户'}}</text>
          <text class="user-row-bio">{{item.bio || '暂无简介'}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="list-modal-footer" bindtap="onCloseFans">关闭</view>
  </view>
</view>

<!-- ══ 访客弹窗（VIP专属） ═══════════════════════════════════ -->
<view class="modal-mask" wx:if="{{showVisitorPanel}}"
  bindtap="onCloseVisitors" catchtouchmove="stopProp">
  <view class="list-modal" catchtap="stopProp">
    <view class="list-modal-header">
      <text class="list-modal-title">👁 访客记录</text>
      <text class="list-modal-close" bindtap="onCloseVisitors">✕</text>
    </view>

    <text class="visitor-section-label">谁看过我</text>
    <view class="list-modal-empty" wx:if="{{visitorList.length === 0}}">
      <text class="list-empty-text">暂无访客记录</text>
    </view>
    <scroll-view scroll-y style="max-height:220rpx;" wx:else>
      <view class="user-row" wx:for="{{visitorList}}" wx:key="userId">
        <image class="user-row-avatar"
          src="{{item.avatarUrl || '/images/avatars男/avatar01.png'}}"
          mode="aspectFill"/>
        <view class="user-row-info">
          <text class="user-row-nick">{{item.nickName || '平江用户'}}</text>
          <text class="user-row-bio">{{item.time || ''}}</text>
        </view>
      </view>
    </scroll-view>

    <text class="visitor-section-label" style="margin-top:20rpx;">我看过谁</text>
    <view class="list-modal-empty" wx:if="{{myViewedList.length === 0}}">
      <text class="list-empty-text">暂无浏览记录</text>
    </view>
    <scroll-view scroll-y style="max-height:220rpx;" wx:else>
      <view class="user-row" wx:for="{{myViewedList}}" wx:key="userId">
        <image class="user-row-avatar"
          src="{{item.avatarUrl || '/images/avatars男/avatar01.png'}}"
          mode="aspectFill"/>
        <view class="user-row-info">
          <text class="user-row-nick">{{item.nickName || '平江用户'}}</text>
          <text class="user-row-bio">{{item.time || ''}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="list-modal-footer" bindtap="onCloseVisitors">关闭</view>
  </view>
</view>

</view>
