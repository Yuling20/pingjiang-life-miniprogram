<view class="page-container">
  <view class="tab-bar">
    <view class="tab-item {{activeTab === index ? 'tab-active' : ''}}" wx:for="{{tabList}}" wx:key="*this" bindtap="onTabTap" data-index="{{index}}">
      <text class="tab-text">{{item}}</text>
    </view>
  </view>
  <view class="post-list">
    <view class="empty-tip" wx:if="{{filteredList.length === 0}}">
      <text class="empty-icon">📭</text><text class="empty-text">暂无相关帖子</text>
    </view>
    <view class="post-card" wx:for="{{filteredList}}" wx:key="id" bindtap="onPostTap" data-id="{{item.id}}">
      <view class="post-header">
        <view class="avatar-wrap"><text class="avatar">{{item.avatar}}</text></view>
        <view class="user-info">
          <text class="nickname">{{item.nickname}}</text>
          <text class="post-time">{{item.time}}</text>
        </view>
        <view class="post-tag" style="background-color:{{item.tagColor}}">
          <text class="tag-text">{{item.tag}}</text>
        </view>
      </view>
      <view class="post-body">
        <text class="post-title">{{item.title}}</text>
        <text class="post-content">{{item.content}}</text>
      </view>
      <view class="post-footer">
        <view class="footer-left">
          <view class="action-btn" catchtap="onLikeTap" data-id="{{item.id}}">
            <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="action-count">{{item.likes}}</text>
          </view>
          <view class="action-btn">
            <text class="action-icon">💬</text>
            <text class="action-count">{{item.comments}}</text>
          </view>
        </view>
        <text class="share-btn">分享</text>
      </view>
    </view>
  </view>
  <view class="publish-btn" bindtap="onPublishTap">
    <text class="publish-icon">✏️</text><text class="publish-text">发帖</text>
  </view>
</view>