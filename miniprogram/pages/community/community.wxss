page{background:#f5f5f5}
.container{padding:0 0 120rpx 0}
.banner{background:linear-gradient(135deg,#e6820e,#f5a623);padding:40rpx 30rpx;display:flex;flex-direction:row;align-items:center}
.banner-icon{font-size:64rpx;margin-right:20rpx}
.banner-text{display:flex;flex-direction:column}
.banner-title{color:#fff;font-size:40rpx;font-weight:bold}
.banner-sub{color:rgba(255,255,255,0.85);font-size:26rpx;margin-top:6rpx}
.post-list{padding:20rpx}
.post-card{background:#fff;border-radius:20rpx;padding:30rpx;margin-bottom:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.06)}
.post-header{display:flex;flex-direction:row;align-items:center;margin-bottom:18rpx}
.avatar{font-size:52rpx;margin-right:16rpx}
.post-meta{display:flex;flex-direction:column}
.nickname{font-size:30rpx;font-weight:bold;color:#333}
.post-time{font-size:24rpx;color:#999;margin-top:4rpx}
.post-content{font-size:32rpx;color:#444;line-height:1.7;display:block;margin-bottom:24rpx}
.post-actions{display:flex;flex-direction:row;gap:30rpx}
.action-btn{display:flex;align-items:center;padding:10rpx 24rpx;background:#f8f8f8;border-radius:30rpx;font-size:28rpx;color:#666}
.action-btn.liked{background:#fff0e0}
.fab{position:fixed;right:36rpx;bottom:160rpx;background:#e6820e;border-radius:60rpx;padding:20rpx 36rpx;display:flex;flex-direction:row;align-items:center;box-shadow:0 6rpx 20rpx rgba(230,130,14,0.4)}
.fab-icon{font-size:36rpx;margin-right:10rpx}
.fab-text{color:#fff;font-size:30rpx;font-weight:bold}
.footer-tip{text-align:center;padding:30rpx;font-size:26rpx;color:#aaa}