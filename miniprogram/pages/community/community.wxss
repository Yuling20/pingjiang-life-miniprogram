/* pages/community/community.wxss */

/* ==================== 基础容器 ==================== */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F0E8;
  position: relative;
  overflow: hidden;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.back-icon {
  font-size: 36rpx;
  color: #D4820A;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 10rpx 20rpx;
  gap: 10rpx;
}

.search-icon-text {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  height: 48rpx;
  line-height: 48rpx;
}

.search-placeholder {
  color: #bbbbbb;
  font-size: 28rpx;
}

.search-clear {
  font-size: 36rpx;
  color: #bbb;
  padding: 0 4rpx;
  line-height: 1;
}

.follow-btn {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
  white-space: nowrap;
  padding: 8rpx 0;
}

/* ==================== 分类标签 ==================== */
.category-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  background: #ffffff;
  padding: 12rpx 16rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.category-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  flex-shrink: 0;
  white-space: nowrap;
}

.category-item.active {
  background: #07c160;
  color: #ffffff;
  font-weight: 600;
}

/* ==================== 帖子列表 ==================== */
.post-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
  box-sizing: border-box;
}

.list-bottom-placeholder {
  height: 160rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* ==================== 帖子卡片 ==================== */
.post-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.post-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #f0f0f0;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: block;
}

.post-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.post-nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-category-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f7ef;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.75;
  margin-bottom: 16rpx;
  display: block;
  word-break: break-all;
}

/* 图片网格 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.post-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.post-img.single {
  width: 320rpx;
  height: 240rpx;
}

/* 话题标签 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag-item {
  font-size: 24rpx;
  color: #07c160;
}

/* 操作栏 */
.post-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 48rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.action-btn.liked {
  color: #07c160;
}

.action-icon-text {
  font-size: 30rpx;
  line-height: 1;
}

.liked-icon {
  color: #07c160;
}

/* ==================== 发帖悬浮按钮 ==================== */
.publish-btn {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  background: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.45);
  z-index: 50;
}

.publish-icon-text {
  font-size: 52rpx;
  color: #ffffff;
  line-height: 1;
  margin-top: -4rpx;
}

/* ==================== 分享菜单 ==================== */
.share-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.share-sheet {
  position: fixed;
  bottom: -400rpx;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 0 60rpx;
  z-index: 101;
  transition: bottom 0.3s ease;
}

.share-sheet.show {
  bottom: 0;
}

.share-sheet-title {
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 36rpx;
}

.share-options {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 56rpx;
  padding: 0 32rpx 32rpx;
}

.share-option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

/* 重置 button 默认样式 */
.share-btn-reset {
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal !important;
  font-size: inherit !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.share-btn-reset::after {
  display: none !important;
  border: none !important;
}

.share-option-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.friend-bg   { background: #e8f4ff; }
.poster-bg   { background: #fff3e8; }
.moments-bg  { background: #e8f7ef; }

.share-option-icon-text {
  font-size: 44rpx;
  line-height: 1;
}

.share-option-label {
  font-size: 24rpx;
  color: #555;
  white-space: nowrap;
}

.share-cancel {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  padding: 24rpx 0 0;
  border-top: 1rpx solid #f0f0f0;
  margin: 0 32rpx;
}

/* ==================== 海报弹窗 ==================== */
.poster-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 200;
}

.poster-modal {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 201;
  transition: bottom 0.3s ease;
  max-height: 92vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.poster-modal.show {
  bottom: 0;
}

.poster-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.poster-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.poster-close {
  font-size: 52rpx;
  color: #bbb;
  line-height: 1;
  padding: 0 8rpx;
}

.poster-preview {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  max-height: 55vh;
  background: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.poster-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.poster-loading-text {
  font-size: 28rpx;
  color: #999;
}

.poster-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.poster-error {
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-error-text {
  font-size: 26rpx;
  color: #ff4d4f;
}

.poster-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.poster-save-btn {
  flex: 1;
  background: #07c160;
  color: #ffffff;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.poster-save-btn.disabled {
  background: #aaaaaa;
}

.poster-cancel-btn {
  width: 160rpx;
  background: #f5f5f5;
  color: #666;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.poster-tip {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 16rpx;
  flex-shrink: 0;
}
/* ─── 分类标签横向滚动栏 ─────────────────────────────────── */

.category-scroll {
  width: 100%;
  white-space: nowrap;
  background-color: #fff;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5ead8;
}

.category-tab-list {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
  gap: 16rpx;
}

/* 标签基础样式 */
.category-tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid transparent;
  flex-shrink: 0;
  transition: all 0.2s;
  /* background-color / color / border-color 由 style 动态注入 */
}

/* 激活状态由 style 内联控制，此处保留点击态 */
.category-tab-item:active {
  opacity: 0.82;
}

/* ─── 帖子分类标签 ──────────────────────────────────────── */

.post-category-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.post-category-text {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

/* ─── 平江贴吧首页第二行 grid 间距 ─────────────────────── */

.tieba-grid-second {
  margin-top: 16rpx;
}

/* 萌宠图标背景色 */
.tieba-icon-pet {
  background-color: #fce8f5;
}
