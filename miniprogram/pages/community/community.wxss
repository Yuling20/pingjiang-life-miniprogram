/* pages/community/community.wxss */
page { background: #F5F0E8; }

.page-wrap { min-height: 100vh; position: relative; }

/* 顶部搜索栏 */
.top-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; background: #FFF8EE;
  border-bottom: 2rpx solid #F0E5D8;
  position: sticky; top: 0; z-index: 20;
}
.search-box {
  flex: 1; display: flex; align-items: center; gap: 12rpx;
  background: #F5F0E8; border-radius: 40rpx;
  padding: 16rpx 24rpx;
}
.search-icon { font-size: 28rpx; }
.search-ph { font-size: 26rpx; color: #BBB; }
.post-btn {
  background: linear-gradient(90deg, #D4820A, #E8A040);
  padding: 16rpx 28rpx; border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(212,130,10,0.25);
  flex-shrink: 0;
}
.post-btn-text { font-size: 26rpx; color: #FFFFFF; font-weight: bold; }

/* 话题 Tab 横向滚动 */
.tab-scroll {
  background: #FFF8EE;
  border-bottom: 2rpx solid #F0E5D8;
  white-space: nowrap;
}
.tab-list {
  display: flex; padding: 0 12rpx;
}
.tab-item {
  display: inline-flex; align-items: center;
  padding: 18rpx 24rpx; flex-shrink: 0;
  position: relative;
}
.tab-text { font-size: 28rpx; color: #999; }
.tab-active .tab-text { color: #D4820A; font-weight: bold; }
.tab-active::after {
  content: ''; position: absolute;
  bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40rpx; height: 6rpx;
  background: #D4820A; border-radius: 4rpx;
}

/* 帖子列表 */
.post-list { padding: 16rpx; }

/* 帖子卡片 */
.post-card {
  background: #FFFFFF; border-radius: 16rpx;
  padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(139,115,85,0.08);
}

/* 卡片头部 */
.card-header {
  display: flex; align-items: center;
  gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap;
}
.author-info { display: flex; align-items: center; gap: 14rpx; flex: 1; }
.author-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 2rpx solid #F0E5D8; flex-shrink: 0;
}
.author-meta { display: flex; flex-direction: column; gap: 4rpx; }
.author-name { font-size: 28rpx; color: #333; font-weight: bold; }
.post-time { font-size: 22rpx; color: #BBB; }

/* 置顶标签 */
.top-tag {
  background: #FFF3E0; border: 1rpx solid #D4820A;
  padding: 4rpx 14rpx; border-radius: 10rpx;
}
.top-tag-text { font-size: 22rpx; color: #D4820A; }

/* 话题标签 */
.topic-tag {
  background: #FFF8EE; padding: 4rpx 14rpx; border-radius: 10rpx;
}
.topic-tag-text { font-size: 22rpx; color: #D4820A; }

/* 帖子正文 */
.post-content {
  font-size: 30rpx; color: #333; line-height: 1.7;
  display: block; margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

/* 图片网格 */
.img-grid {
  display: flex; gap: 8rpx; flex-wrap: wrap;
  margin-bottom: 16rpx; position: relative;
}
.grid-img { border-radius: 10rpx; background: #EEE; }
.grid-img-1 { width: 360rpx; height: 240rpx; }
.grid-img-2 { width: 224rpx; height: 224rpx; }
.grid-img-3 { width: 224rpx; height: 224rpx; }
.img-more {
  position: absolute; right: 0; bottom: 0;
  width: 224rpx; height: 224rpx;
  background: rgba(0,0,0,0.45); border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center;
}
.img-more-text { font-size: 40rpx; color: #FFFFFF; font-weight: bold; }

/* 互动栏 */
.card-footer {
  display: flex; align-items: center; gap: 40rpx;
  padding-top: 16rpx; border-top: 1rpx solid #F5F0E8;
}
.footer-item { display: flex; align-items: center; gap: 6rpx; }
.footer-icon { font-size: 28rpx; }
.footer-num { font-size: 26rpx; color: #999; }
.liked { color: #E53935; }

/* 悬浮发帖按钮 */
.fab {
  position: fixed; right: 40rpx; bottom: 180rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: linear-gradient(135deg, #D4820A, #E8A040);
  box-shadow: 0 8rpx 24rpx rgba(212,130,10,0.40);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.fab-icon { font-size: 44rpx; }

/* 空状态 */
.empty-tip {
  display: flex; flex-direction: column;
  align-items: center; padding: 100rpx 0; gap: 20rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #BBB; }
.empty-post-btn {
  background: linear-gradient(90deg, #D4820A, #E8A040);
  padding: 18rpx 60rpx; border-radius: 40rpx; margin-top: 10rpx;
}
.empty-post-text { font-size: 28rpx; color: #FFFFFF; font-weight: bold; }

/* 加载提示 */
.load-tip { text-align: center; padding: 30rpx; }
.load-text { font-size: 26rpx; color: #BBB; }
