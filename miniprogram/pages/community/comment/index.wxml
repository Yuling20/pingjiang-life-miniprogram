<!--pages/community/comment/index.wxml-->
<view class="page-wrap">

<!-- 原帖摘要卡片 -->
<view class="origin-card">
  <view class="origin-header">
    <image class="origin-avatar" src="{{post.avatar}}" mode="aspectFill"/>
    <view class="origin-meta">
      <text class="origin-name">{{post.nickname}}</text>
      <text class="origin-time">{{post.time}}</text>
    </view>
  </view>
  <text class="origin-content">{{post.content}}</text>
  <!-- 原帖点赞数 -->
  <view class="origin-footer">
    <text class="origin-likes">❤️ {{post.likes}} 人觉得有用</text>
  </view>
</view>

<!-- 评论列表标题栏 -->
<view class="comment-bar">
  <text class="comment-count">共 {{comments.length}} 条评论</text>
  <view class="sort-btn" bindtap="toggleSort">
    <text class="sort-text">{{sortByTime ? '最新优先' : '热门优先'}}</text>
    <text class="sort-icon">⇅</text>
  </view>
</view>

<!-- 评论列表 -->
<view class="comment-list">
  <view class="comment-item" wx:for="{{comments}}" wx:key="id">

    <!-- 评论头部 -->
    <view class="comment-header">
      <view class="user-info" bindtap="goUser" data-id="{{item.userId}}">
        <image class="c-avatar" src="{{item.avatar}}" mode="aspectFill"/>
        <view class="c-meta">
          <view class="c-name-row">
            <text class="c-name">{{item.nickname}}</text>
            <text class="c-vip" wx:if="{{item.isVip}}">V</text>
          </view>
          <text class="c-time">{{item.time}}</text>
        </view>
      </view>
      <!-- 点赞 -->
      <view
        class="c-like-btn {{item.isLiked ? 'c-liked' : ''}}"
        bindtap="likeComment"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <text class="c-like-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
        <text class="c-like-num">{{item.likes}}</text>
      </view>
    </view>

    <!-- 评论正文 -->
    <view class="comment-body">
      <text class="c-content">{{item.content}}</text>
    </view>

    <!-- 操作栏：回复 + 举报 + 删除本人评论 -->
    <view class="comment-actions">
      <view class="c-action-btn" bindtap="openReply" data-id="{{item.id}}" data-index="{{index}}" data-name="{{item.nickname}}">
        <text class="c-action-text">💬 回复</text>
      </view>
      <view class="c-action-btn" bindtap="reportComment" data-id="{{item.id}}">
        <text class="c-action-text">🚩 举报</text>
      </view>
      <view
        class="c-action-btn c-delete-btn"
        wx:if="{{item.isMine}}"
        bindtap="deleteComment"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <text class="c-action-text c-delete-text">🗑️ 删除</text>
      </view>
    </view>

    <!-- 二级回复列表 -->
    <view class="reply-list" wx:if="{{item.replies && item.replies.length > 0}}">
      <view class="reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
        <view class="reply-header">
          <text class="reply-name">{{reply.nickname}}</text>
          <text class="reply-to" wx:if="{{reply.replyTo}}"> 回复 <text class="reply-to-name">{{reply.replyTo}}</text></text>
          <text class="reply-time">{{reply.time}}</text>
        </view>
        <text class="reply-content">{{reply.content}}</text>
        <!-- 回复的举报/删除 -->
        <view class="reply-actions">
          <view class="c-action-btn" bindtap="reportComment" data-id="{{reply.id}}">
            <text class="c-action-text">🚩</text>
          </view>
          <view
            class="c-action-btn"
            wx:if="{{reply.isMine}}"
            bindtap="deleteReply"
            data-comment-index="{{index}}"
            data-reply-id="{{reply.id}}"
          >
            <text class="c-action-text c-delete-text">🗑️</text>
          </view>
        </view>
      </view>
      <!-- 展开更多回复 -->
      <view
        class="expand-reply"
        wx:if="{{item.totalReplies > item.replies.length}}"
        bindtap="loadMoreReplies"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <text class="expand-text">展开剩余 {{item.totalReplies - item.replies.length}} 条回复 ▼</text>
      </view>
    </view>

  </view>

  <!-- 空评论提示 -->
  <view class="empty-tip" wx:if="{{comments.length === 0}}">
    <text class="empty-icon">🗨️</text>
    <text class="empty-text">还没有评论，快来抢沙发！</text>
  </view>

  <!-- 底部占位（防止被输入框遮挡） -->
  <view style="height: 160rpx;"/>
</view>

<!-- 底部评论输入框 -->
<view class="input-bar">
  <view class="input-wrap">
    <input
      class="comment-input"
      placeholder="{{replyTarget ? '回复 ' + replyTarget + '...' : '说两句吧...'}}"
      placeholder-class="input-ph"
      value="{{inputVal}}"
      bindinput="onInputChange"
      confirm-type="send"
      bindconfirm="submitComment"
      maxlength="200"
      focus="{{inputFocus}}"
    />
  </view>
  <view
    class="send-btn {{inputVal.trim().length > 0 ? 'send-active' : 'send-inactive'}}"
    bindtap="submitComment"
  >发送</view>
</view>

</view>
