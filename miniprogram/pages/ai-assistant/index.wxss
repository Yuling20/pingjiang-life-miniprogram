/* pages/ai-assistant/index.wxss */
page {
  background: #f0f2f5;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.header-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5);
}

.header-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: block;
}

.header-subtitle {
  color: rgba(255,255,255,0.8);
  font-size: 22rpx;
  display: block;
}

.clear-btn {
  color: rgba(255,255,255,0.8);
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 20rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow: hidden;
}

.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
  gap: 16rpx;
}

.user-row {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.bubble-wrap {
  max-width: 70%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-bubble-wrap {
  align-items: flex-end;
}

.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  word-break: break-all;
}

.assistant-bubble {
  background: #fff;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.user-bubble {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  border-top-right-radius: 4rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
}

.user-bubble .message-text {
  color: #fff;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  padding-left: 10rpx;
}

.user-time {
  padding-right: 10rpx;
  padding-left: 0;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 18rpx;
  width: fit-content;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1890ff;
  animation: bounce 1.2s infinite;
}

.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* 快捷问题 */
.quick-questions {
  background: #fff;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  white-space: nowrap;
}

.quick-list {
  display: flex;
  padding: 0 20rpx;
  gap: 16rpx;
}

.quick-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f0f8ff;
  border: 1rpx solid #91d5ff;
  border-radius: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.quick-icon { font-size: 28rpx; }
.quick-text { font-size: 24rpx; color: #1890ff; }

/* 输入栏 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}

.input-box {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
}

.send-disabled {
  opacity: 0.5;
}
