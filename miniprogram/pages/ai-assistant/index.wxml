<!-- pages/ai-assistant/index.wxml -->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-info">
      <image class="header-avatar" src="/images/ai-avatar.png" mode="aspectFill"/>
      <view class="header-text">
        <text class="header-title">平江汇AI小助手</text>
        <text class="header-subtitle">智能客服助理·智慧服务平江</text>
      </view>
    </view>
    <view class="header-actions">
      <text class="clear-btn" bindtap="clearChat">清空</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y 
    scroll-into-view="{{scrollToMessage}}"
    scroll-with-animation>
    
    <block wx:for="{{messages}}" wx:key="id">
      <!-- AI消息 -->
      <view wx:if="{{item.role === 'assistant'}}" class="message-row assistant-row" id="msg-{{item.id}}">
        <image class="avatar ai-avatar" src="/images/ai-avatar.png" mode="aspectFill"/>
        <view class="bubble-wrap">
          <view class="message-bubble assistant-bubble">
            <text class="message-text">{{item.content}}</text>
          </view>
          <text class="message-time">{{item.time}}</text>
        </view>
      </view>

      <!-- 用户消息 -->
      <view wx:if="{{item.role === 'user'}}" class="message-row user-row" id="msg-{{item.id}}">
        <view class="bubble-wrap user-bubble-wrap">
          <view class="message-bubble user-bubble">
            <text class="message-text">{{item.content}}</text>
          </view>
          <text class="message-time user-time">{{item.time}}</text>
        </view>
        <image class="avatar user-avatar" src="/images/default-avatar.png" mode="aspectFill"/>
      </view>
    </block>

    <!-- 加载动画 -->
    <view wx:if="{{isLoading}}" class="loading-row">
      <view class="loading-dots">
        <view class="dot dot1"></view>
        <view class="dot dot2"></view>
        <view class="dot dot3"></view>
      </view>
    </view>
    
    <view style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 快捷问题 -->
  <scroll-view class="quick-questions" scroll-x>
    <view class="quick-list">
      <view 
        wx:for="{{quickQuestions}}" 
        wx:key="id"
        class="quick-item"
        bindtap="onQuickQuestion"
        data-text="{{item.text}}">
        <text class="quick-icon">{{item.icon}}</text>
        <text class="quick-text">{{item.text}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-area">
    <input 
      class="input-box"
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      placeholder="请输入你的问题..."
      confirm-type="send"
      disabled="{{isLoading}}"
      adjust-position/>
    <view 
      class="send-btn {{isLoading ? 'send-disabled' : ''}}"
      bindtap="sendMessage">
      <text>发送</text>
    </view>
  </view>
</view>
