page {
  background-color: #F5F6FA;
  font-size: 30rpx;
}
.home-container {
  min-height: 100vh;
  background-color: #F5F6FA;
}

/* 一体化顶部通栏 总高330rpx，对应图片750×330px */
.top-hero {
  width: 100%;
  height: 330rpx;
  position: relative;
  overflow: hidden;
}
.top-hero__bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
/* 渐变遮罩：适配黑色文字，调整为浅白色遮罩 */
.top-hero__mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.1) 0%,
    rgba(255, 255, 255, 0.1) 40%,
    rgba(255, 255, 255, 0.3) 100%
  );
  z-index: 1;
}

/* 顶部天气+搜索区域 */
.top-hero__header {
  position: relative;
  z-index: 2;
  padding: 20rpx 30rpx 0;
}
.weather-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.weather-text {
  color: #000000; /* 天气文字也改成黑色 */
  font-size: 30rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 3rpx rgba(255,255,255,0.8); /* 白色阴影，确保在浅色背景上清晰 */
}
.weather-air {
  color: #000000;
  font-size: 26rpx;
  background: rgba(255,255,255,0.7);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-box {
  flex: 1;
  background: rgba(255,255,255,0.95);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-icon { font-size: 28rpx; color: #333; }
.search-placeholder { color: #333; font-size: 28rpx; }
.top-icons { display: flex; gap: 16rpx; }

/* 轮播区域：去掉图标样式，文字改为黑色 */
.banner-swiper {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 200rpx;
  width: 100%;
  z-index: 2;
}
.banner-card {
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  /* 去掉了图标，所以这里的 gap 也不需要了 */
}
/* 完全去掉了 .banner-icon 相关的所有样式 */
.banner-content { 
  position: relative;
  z-index: 2;
}
.banner-title {
  display: block;
  color: #000000; /* 轮播标题改为黑色 */
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 3rpx rgba(255,255,255,0.8);
}
.banner-desc {
  display: block;
  color: #333333; /* 轮播描述改为深灰色 */
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  text-shadow: 0 1rpx 2rpx rgba(255,255,255,0.8);
}
.banner-btn {
  display: inline-block;
  background: rgba(0,0,0,0.1);
  color: #000000; /* 按钮文字也改为黑色 */
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0,0,0,0.3);
  text-shadow: 0 1rpx 2rpx rgba(255,255,255,0.6);
}

/* 下方通用板块样式（无修改） */
.section-card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
}
.section-more {
  display: flex;
  align-items: center;
  color: #999;
  font-size: 26rpx;
}
.arrow { margin-left: 4rpx; font-size: 28rpx; }
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
}
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.service-icon { font-size: 44rpx; }
.service-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
}
.service-item-hover { opacity: 0.7; transform: scale(0.97); }
.section-locked { opacity: 0.65; }
.locked-badge {
  background: #F0F0F0;
  color: #999;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.locked-tip {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
}
.article-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 16rpx;
}
.article-item:last-child { border-bottom: none; }
.article-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
  white-space: nowrap;
}
.tag-hot { background: #FEE8E8; color: #E74C3C; }
.tag-help { background: #E8F4FE; color: #2980B9; }
.article-title {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  line-height: 1.5;
}
.article-count { font-size: 24rpx; color: #999; white-space: nowrap; }
.article-item-hover { background: #F8F8F8; }
.content-section { margin: 16rpx 24rpx; }
.content-section-header { margin-bottom: 16rpx; }
.content-flow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.content-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.content-img-placeholder {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.content-placeholder-icon { font-size: 52rpx; }
.content-info { padding: 14rpx 16rpx; }
.content-title {
  display: block;
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
  margin-bottom: 6rpx;
  line-height: 1.4;
}
.content-desc { display: block; font-size: 24rpx; color: #999; }
.content-card-hover { opacity: 0.8; }
.load-more {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}
.float-ai {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #6C63FF, #3ECFCF);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(108,99,255,0.45);
  z-index: 999;
}
.float-ai-icon { font-size: 38rpx; line-height: 1; }
.float-ai-text {
  font-size: 18rpx;
  color: #fff;
  margin-top: 4rpx;
  font-weight: bold;
}
/* 签到标签 */
.search-sign-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #ff8c00, #ffc107);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}
.search-sign-tag__icon {
  font-size: 24rpx;
}
.search-sign-tag__text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
/* 签到弹窗 */
.sign-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sign-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  padding-bottom: 40rpx;
}
.sign-modal__header {
  background: linear-gradient(135deg, #ff8c00, #ffc107);
  padding: 48rpx 0 36rpx;
  text-align: center;
}
.sign-modal__coin {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}
.sign-modal__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.sign-modal__subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
}
.sign-modal__desc {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  padding: 28rpx 40rpx 0;
  line-height: 1.8;
}
.sign-modal__rule-link {
  font-size: 22rpx;
  color: #f90;
  text-align: center;
  margin-top: 10rpx;
}
.sign-modal__reward-tip {
  text-align: center;
  font-size: 26rpx;
  color: #333;
  margin: 20rpx 0 28rpx;
  padding: 16rpx 0;
  background: #fff8f0;
  margin: 20rpx 40rpx;
  border-radius: 12rpx;
}
.sign-modal__reward-tip .highlight {
  color: #f90;
  font-weight: 700;
  font-size: 30rpx;
}
.sign-modal__btns {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sign-modal__btn {
  width: 100%;
  text-align: center;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 26rpx 0;
  box-sizing: border-box;
}
.sign-modal__btn--primary {
  background: linear-gradient(90deg, #ff8c00, #ffc107);
  color: #fff;
  font-weight: 700;
}
.sign-modal__btn--ghost {
  border: 1rpx solid #ddd;
  color: #999;
  font-size: 26rpx;
}