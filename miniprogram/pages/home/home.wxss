page {
  background-color: #F5F6FA;
  font-size: 30rpx;
}
.home-container {
  min-height: 100vh;
  background-color: #F5F6FA;
}
.top-bar {
  background: linear-gradient(135deg, #1A6FB8 0%, #2980B9 100%);
  padding: 20rpx 30rpx 24rpx;
}
.weather-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.weather-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}
.weather-air {
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-box {
  flex: 1;
  background: rgba(255,255,255,0.95);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-icon { font-size: 28rpx; }
.search-placeholder { color: #999; font-size: 28rpx; }
.top-icons { display: flex; gap: 16rpx; }
.top-icon { font-size: 44rpx; color: #fff; }
.banner-swiper { height: 180rpx; width: 100%; }
.banner-card {
  height: 180rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  gap: 24rpx;
}
.banner-icon { font-size: 72rpx; }
.banner-content { flex: 1; }
.banner-title {
  display: block;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.banner-desc {
  display: block;
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.banner-btn {
  display: inline-block;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
}
.quick-menu {
  background: #fff;
  padding: 20rpx 16rpx;
  display: flex;
  white-space: nowrap;
}
.quick-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 110rpx;
  padding: 0 10rpx;
}
.quick-icon-wrap { font-size: 44rpx; margin-bottom: 8rpx; }
.quick-name { font-size: 24rpx; color: #333; }
.quick-item-hover { opacity: 0.7; }
.section-card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
}
.section-more {
  display: flex;
  align-items: center;
  color: #999;
  font-size: 26rpx;
}
.arrow { margin-left: 4rpx; font-size: 28rpx; }
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
}
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.service-icon { font-size: 44rpx; }
.service-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
}
.service-item-hover { opacity: 0.7; transform: scale(0.97); }
.section-locked { opacity: 0.65; }
.locked-badge {
  background: #F0F0F0;
  color: #999;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.locked-tip {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
}
.article-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 16rpx;
}
.article-item:last-child { border-bottom: none; }
.article-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
  white-space: nowrap;
}
.tag-hot { background: #FEE8E8; color: #E74C3C; }
.tag-help { background: #E8F4FE; color: #2980B9; }
.article-title {
  flex: 1;
  font-size: 30rpx;
  color: #222;
  line-height: 1.5;
}
.article-count { font-size: 24rpx; color: #999; white-space: nowrap; }
.article-item-hover { background: #F8F8F8; }
.content-section { margin: 16rpx 24rpx; }
.content-section-header { margin-bottom: 16rpx; }
.content-flow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.content-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.content-img-placeholder {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.content-placeholder-icon { font-size: 52rpx; }
.content-info { padding: 14rpx 16rpx; }
.content-title {
  display: block;
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
  margin-bottom: 6rpx;
  line-height: 1.4;
}
.content-desc { display: block; font-size: 24rpx; color: #999; }
.content-card-hover { opacity: 0.8; }
.load-more {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}
.float-ai {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #6C63FF, #3ECFCF);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(108,99,255,0.45);
  z-index: 999;
}
.float-ai-icon { font-size: 38rpx; line-height: 1; }
.float-ai-text {
  font-size: 18rpx;
  color: #fff;
  margin-top: 4rpx;
  font-weight: bold;
}