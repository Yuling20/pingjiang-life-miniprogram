<view class="home-container">
  <view class="top-bar">
    <view class="weather-row">
      <text class="weather-text">☀️ {{weatherInfo.city}} {{weatherInfo.temp}} {{weatherInfo.weather}} {{weatherInfo.wind}}</text>
      <text class="weather-air">{{weatherInfo.air}}</text>
    </view>
    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索服务/信息/商品</text>
      </view>
      <view class="top-icons">
        <text class="top-icon">🔔</text>
        <text class="top-icon">👤</text>
      </view>
    </view>
  </view>

  <!-- 轮播横幅 -->
  <swiper class="banner-swiper" autoplay="{{true}}" interval="4000" circular="{{true}}" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" bindchange="onBannerChange">
    <swiper-item wx:for="{{bannerList}}" wx:key="id">
      <view class="banner-card" style="background-color: {{item.bgColor}};" bindtap="onBannerTap" data-item="{{item}}">
        <text class="banner-icon">{{item.icon}}</text>
        <view class="banner-content">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-desc">{{item.desc}}</text>
          <view class="banner-btn">查看详情 ›</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 便民服务板块（直接衔接轮播下方） -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">便民服务</text>
      <view class="section-more" bindtap="goToConvenience">
        <text>查看全部</text><text class="arrow">›</text>
      </view>
    </view>
    <view class="service-grid">
      <view wx:for="{{serviceList}}" wx:key="id" class="service-item" bindtap="navigateToService" data-type="{{item.type}}" hover-class="service-item-hover">
        <view class="service-icon-wrap" style="background: {{item.color}}20;">
          <text class="service-icon">{{item.icon}}</text>
        </view>
        <text class="service-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 平江贴吧模块（已按方案替换） ===== -->
  <view class="section-block tieba-section">
    <view class="section-header">
      <text class="section-title">平江贴吧</text>
      <text class="section-more" bindtap="goToCommunity">进入社区 ›</text>
    </view>

    <!-- 第一行：3个入口 -->
    <view class="tieba-grid service-grid">
      <!-- 随手拍 → 游玩 -->
      <view class="tieba-item service-item" bindtap="goToCommunityCategory" data-category="游玩" hover-class="service-item-hover">
        <view class="tieba-icon-wrap service-icon-wrap tieba-icon-snap" style="background: #4A90D920;">
          <text class="tieba-icon service-icon">📷</text>
        </view>
        <text class="tieba-label service-name">随手拍</text>
      </view>

      <!-- 求助互助 → 求助互助 -->
      <view class="tieba-item service-item" bindtap="goToCommunityCategory" data-category="求助互助" hover-class="service-item-hover">
        <view class="tieba-icon-wrap service-icon-wrap tieba-icon-help" style="background: #4A90D920;">
          <text class="tieba-icon service-icon">🤝</text>
        </view>
        <text class="tieba-label service-name">求助互助</text>
      </view>

      <!-- 二手转让 → 二手交易 -->
      <view class="tieba-item service-item" bindtap="goToCommunityCategory" data-category="二手交易" hover-class="service-item-hover">
        <view class="tieba-icon-wrap service-icon-wrap tieba-icon-trade" style="background: #4A90D920;">
          <text class="tieba-icon service-icon">🛍️</text>
        </view>
        <text class="tieba-label service-name">二手转让</text>
      </view>
    </view>

    <!-- 第二行：3个入口 -->
    <view class="tieba-grid tieba-grid-second service-grid">
      <!-- 今日话题 → 扯闲谈 -->
      <view class="tieba-item service-item" bindtap="goToCommunityCategory" data-category="扯闲谈" hover-class="service-item-hover">
        <view class="tieba-icon-wrap service-icon-wrap tieba-icon-topic" style="background: #4A90D920;">
          <text class="tieba-icon service-icon">💬</text>
        </view>
        <text class="tieba-label service-name">今日话题</text>
      </view>

      <!-- 本地活动 → 活动 -->
      <view class="tieba-item service-item" bindtap="goToCommunityCategory" data-category="活动" hover-class="service-item-hover">
        <view class="tieba-icon-wrap service-icon-wrap tieba-icon-notice" style="background: #4A90D920;">
          <text class="tieba-icon service-icon">📢</text>
        </view>
        <text class="tieba-label service-name">本地活动</text>
      </view>

      <!-- 萌宠交流 → 宠物 -->
      <view class="tieba-item service-item" bindtap="goToCommunityCategory" data-category="宠物" hover-class="service-item-hover">
        <view class="tieba-icon-wrap service-icon-wrap tieba-icon-pet" style="background: #4A90D920;">
          <text class="tieba-icon service-icon">🐾</text>
        </view>
        <text class="tieba-label service-name">萌宠交流</text>
      </view>
    </view>
  </view>
  <!-- ===== 平江贴吧模块结束 ===== -->

  <view class="section-card section-locked">
    <view class="section-header">
      <text class="section-title">商城板块</text>
      <view class="locked-badge">🔒 即将上线</view>
    </view>
    <view class="locked-tip">平江本地商城，敬请期待</view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <text class="section-title">平江热帖</text>
      <view class="section-more" bindtap="goToCommunity">
        <text>查看全部</text><text class="arrow">›</text>
      </view>
    </view>
    <view wx:for="{{articleList}}" wx:key="id" class="article-item" bindtap="goToCommunity" hover-class="article-item-hover">
      <view class="article-tag {{item.tag === '热议' ? 'tag-hot' : 'tag-help'}}">{{item.tag}}</view>
      <text class="article-title">{{item.title}}</text>
      <text class="article-count">{{item.count}}人参与</text>
    </view>
  </view>

  <view class="content-section">
    <view class="section-header content-section-header">
      <text class="section-title">══ 精选内容 ══</text>
    </view>
    <view class="content-flow">
      <view wx:for="{{contentFlow}}" wx:key="id" class="content-card" bindtap="goToContentDetail" data-item="{{item}}" hover-class="content-card-hover">
        <view class="content-img-placeholder" style="background: {{item.color}}30;">
          <text class="content-placeholder-icon">{{item.tag}}</text>
        </view>
        <view class="content-info">
          <text class="content-title">{{item.title}}</text>
          <text class="content-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
    <view class="load-more">加载更多...</view>
  </view>

  <view style="height: 120rpx;"></view>
  <view class="float-ai" bindtap="goToAI">
    <text class="float-ai-icon">🤖</text>
    <text class="float-ai-text">AI助手</text>
  </view>
</view>